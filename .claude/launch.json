{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acheaqui-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3400,
      "autoPort": false
    },
    {
      "name": "acheaqui-exemplo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "web",
        "--",
        "astro",
        "dev",
        "--mode",
        "teste",
        "--port",
        "3403"
      ],
      "port": 3403,
      "autoPort": false
    },
    {
      "name": "acheaqui-exemplo-previa",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location apps/web; npx astro build --mode teste; if ($?) { npx wrangler dev --port 3401 --inspector-port 3402 }"
      ],
      "port": 3401,
      "autoPort": false
    }
  ]
}
