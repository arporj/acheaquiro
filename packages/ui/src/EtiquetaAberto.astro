---
interface Props {
  aberto: boolean;
}

const { aberto } = Astro.props;
---

{
  aberto ? (
    <span class="inline-flex items-center gap-1 rounded-full bg-zap-50 px-2 py-0.5 text-xs font-bold text-zap-700">
      <span class="size-2 rounded-full bg-zap-600" /> Aberto agora
    </span>
  ) : (
    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">
      <span class="size-2 rounded-full bg-slate-400" /> Fechado
    </span>
  )
}
