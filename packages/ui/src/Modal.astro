---
// Modal da própria interface (o projeto não usa alert/confirm do navegador).
// Usa <dialog> nativo: prende o foco e fecha com Esc. Quem usa abre com
// dialogo.showModal(), ouve o evento "close" e pode trocar o título pelo
// elemento [data-modal-titulo].
import Icone from "./Icone.astro";

interface Props {
  id: string;
  titulo: string;
}

const { id, titulo } = Astro.props;
---

<dialog
  id={id}
  data-modal
  aria-labelledby={`${id}-titulo`}
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 text-tinta shadow-2xl backdrop:bg-azul-900/60 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between gap-4 border-b border-slate-100 px-6 py-4">
    <h2 id={`${id}-titulo`} data-modal-titulo class="font-display text-xl font-bold text-azul-900">{titulo}</h2>
    <button
      type="button"
      data-modal-fechar
      class="grid size-9 place-items-center rounded-full text-slate-500 hover:bg-slate-100"
      aria-label="Fechar"
    >
      <Icone nome="fechar" class="size-5" />
    </button>
  </div>
  <div class="px-6 py-5">
    <slot />
  </div>
</dialog>

<script>
  for (const dialogo of document.querySelectorAll<HTMLDialogElement>("dialog[data-modal]")) {
    // Clique no fundo escurecido fecha o modal.
    dialogo.addEventListener("click", (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
    for (const botao of dialogo.querySelectorAll("[data-modal-fechar]")) {
      botao.addEventListener("click", () => dialogo.close());
    }
  }
</script>
