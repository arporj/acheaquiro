{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Produção: o site real, com banco e login. Publicar com: npm run deploy:producao -w web
	// Até a abertura fica em prod.acheaquiro.com.br; em 27/11/2026 recebe
	// acheaquiro.com.br e www, e prod. passa a redirecionar para lá.
	"name": "acheaqui",
	// Conta da Cloudflare deste projeto, para nunca publicar em outra por engano.
	"account_id": "cd8e8e7488aedefca9ee0ea9af58e349",
	// Prévia local do Workers (npm run preview -w web), na faixa de portas do projeto.
	"dev": { "port": 3401, "inspector_port": 3402 },
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [{ "pattern": "prod.acheaquiro.com.br", "custom_domain": true }],
	"cache": { "enabled": true },
	// Versão do Worker nas etiquetas do cache (limpeza do cache a cada publicação).
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// Segredos que o Worker usa (wrangler secret put). Declarar a lista impede
	// que o build copie os arquivos locais inteiros para dist/server/.dev.vars: só a
	// produção usa a service_role (limites de acesso e registro de acessos).
	"secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY", "CLOUDFLARE_LIMPEZA_CACHE_TOKEN"] },
	// Arquivos enviados pelos anunciantes (Especificação Técnica, seção 10.4).
	// Só a produção tem: as ligações não passam para os outros ambientes.
	"r2_buckets": [
		// Público, em arquivos.acheaquiro.com.br: fotos e encartes.
		{ "binding": "MIDIA", "bucket_name": "acheaqui-midia" },
		// Privado: comprovantes de Pix.
		{ "binding": "DOCUMENTOS", "bucket_name": "acheaqui-documentos" }
	],
	"env": {
		// Site de apresentação para anunciantes, com dados fictícios e sem login.
		// Publicar com: npm run deploy:teste -w web
		// Em exemplo.acheaquiro.com.br (decisão de 30/10/2026); teste. continua
		// ligado para os links já enviados, que a regra "teste para exemplo" da
		// Cloudflare redireciona antes do cache (ver CLAUDE.md).
		"teste": {
			"name": "acheaqui-teste",
			"routes": [
				{ "pattern": "exemplo.acheaquiro.com.br", "custom_domain": true },
				{ "pattern": "teste.acheaquiro.com.br", "custom_domain": true }
			],
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"secrets": { "required": [] }
		},
		// Aviso "abre em 27/11" no domínio principal, até a abertura. Sem banco.
		// Publicar com: npm run deploy:em-breve -w web. Apagar em 27/11/2026.
		"em-breve": {
			"name": "acheaqui-em-breve",
			"routes": [
				{ "pattern": "acheaquiro.com.br", "custom_domain": true },
				{ "pattern": "www.acheaquiro.com.br", "custom_domain": true }
			],
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"secrets": { "required": [] }
		}
	}
}
