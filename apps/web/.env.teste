# Variáveis do site de apresentação (astro build --mode teste).
# Não coloque segredos aqui: este arquivo vai para o git.

# Escolhe o ambiente "teste" do wrangler.jsonc.
CLOUDFLARE_ENV=teste

# Anunciantes fictícios, faixa de aviso no topo e nenhuma área com login.
PUBLIC_AMBIENTE=apresentacao

# Vazias de propósito: este arquivo vale mais que o .env.local, e o site de
# apresentação não acessa o banco real.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
