# Variáveis da página "em breve" de acheaquiro.com.br até a abertura
# (astro build --mode embreve). Não coloque segredos aqui: vai para o git.

# Escolhe o ambiente "em-breve" do wrangler.jsonc.
CLOUDFLARE_ENV=em-breve

# Todas as páginas levam ao aviso "abre em 27/11".
PUBLIC_AMBIENTE=em-breve

# Vazias de propósito: este arquivo vale mais que o .env.local, e esta página
# não acessa o banco.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
