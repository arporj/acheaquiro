{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "lint": "eslint .",
    "typecheck": "astro check",
    "deploy:teste": "astro build --mode teste && wrangler deploy",
    "deploy:producao": "astro build && wrangler deploy",
    "deploy:em-breve": "astro build --mode embreve && wrangler deploy",
    "deploy:todos": "npm run deploy:producao && npm run deploy:teste && npm run deploy:em-breve"
  },
  "dependencies": {
    "@acheaqui/domain": "*",
    "@acheaqui/types": "*",
    "@acheaqui/ui": "*",
    "@astrojs/cloudflare": "^14.4.1",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  }
}
