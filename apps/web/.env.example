# Modelo dos três arquivos de valores locais, nenhum deles vai para o git.
# Não coloque valores reais neste arquivo: ele vai para o git.

# ---------- apps/web/.env.local: valores públicos do app ----------
PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# ---------- apps/web/.dev.vars: segredos do app, só no servidor ----------
# Na produção, os mesmos nomes ficam nos segredos do Worker (wrangler secret put).
# Nunca prefixar com PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=
# CLOUDFLARE_LIMPEZA_CACHE_TOKEN=
# Token da Cloudflare só para ler as estatísticas (contador de visitas).
# CLOUDFLARE_ANALYTICS_TOKEN=

# ---------- .credenciais.local, na raiz: tokens das ferramentas ----------
# Lidos só por scripts/cli.ps1. O site não usa nenhum.
# Token da conta do Supabase e senha do banco, para a Supabase CLI.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# Usadas pelo supabase config push: Brevo e Turnstile.
# SUPABASE_AUTH_SMTP_PASS=
# SUPABASE_AUTH_CAPTCHA_SECRET=
# Token só para publicar Workers (modelo "Edit Cloudflare Workers"), para o wrangler.
# CLOUDFLARE_API_TOKEN=
# Senha do usuário de backup, guardada também no segredo do GitHub.
# BACKUP_DB_PASSWORD=
