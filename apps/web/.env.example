# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# Não coloque valores reais neste arquivo: ele vai para o git.

PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Secreta, só no servidor. Nunca prefixar com PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secretas, só para a Supabase CLI. O site não usa.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
