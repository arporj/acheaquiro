---
// Moldura das telas de acesso e das áreas logadas: cabeçalho simples, sem a
// busca nem os anúncios, e um cartão central com o conteúdo.
import CabecalhoConta from "./CabecalhoConta.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  titulo: string;
  /** Mostra "Minha conta" e "Sair" no cabeçalho. */
  logado?: boolean;
  /** Cartão estreito (formulários) ou largo (áreas). */
  largura?: "estreita" | "larga";
}

const { titulo, logado = false, largura = "estreita" } = Astro.props;
---

<Layout titulo={titulo}>
  <CabecalhoConta logado={logado} />
  <main class="mx-auto w-full flex-1 px-4 py-10">
    <div class={`mx-auto rounded-3xl bg-white p-6 shadow-sm ring-1 ring-black/5 sm:p-8 ${largura === "estreita" ? "max-w-md" : "max-w-3xl"}`}>
      <h1 class="font-display text-3xl font-extrabold text-azul-900">{titulo}</h1>
      <slot />
    </div>
  </main>
</Layout>
