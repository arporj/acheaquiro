---
// Cabeçalho simples das telas de acesso e das áreas logadas, sem a busca nem
// os anúncios. Com login, mostra "Minha conta" e "Sair".
import Logo from "@/components/Logo.astro";

interface Props {
  logado?: boolean;
}

const { logado = false } = Astro.props;
---

<header class="fundo-raios text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 lg:py-4">
    <Logo />
    {
      logado && (
        <nav class="flex items-center gap-1 sm:gap-2" aria-label="Conta">
          <a href="/conta" class="rounded-full px-4 py-2 text-sm font-bold text-white/90 hover:bg-white/10">
            Minha conta
          </a>
          <form method="post" action="/sair">
            <button type="submit" class="rounded-full px-4 py-2 text-sm font-bold text-white/90 hover:bg-white/10">
              Sair
            </button>
          </form>
        </nav>
      )
    }
  </div>
</header>
