---
// Cartão lateral de contato, no computador. Sem WhatsApp nem telefone
// (comércio importado), a página mostra a seção de contato não informado.
import { Icone, classesBotao } from "@acheaqui/ui";
import type { Anunciante } from "@acheaqui/types";
import { formatarTelefone, linksContato } from "@/lib/contato";

interface Props {
  anunciante: Anunciante;
  comoChegar?: string;
}

const { anunciante, comoChegar } = Astro.props;
const l = linksContato(anunciante, comoChegar);
---

<div class="rounded-3xl bg-white p-5 shadow-md ring-1 ring-black/5">
  <h2 class="font-display text-xl font-bold text-azul-900">Entre em contato</h2>
  <p class="mb-4 text-sm text-slate-500">Direto com o anunciante, sem intermediários.</p>
  <div class="flex flex-col gap-2">
    {
      l.orcamento && (
        <a href={l.orcamento} target="_blank" rel="noopener noreferrer" class={classesBotao("zap", "g")}>
          <Icone nome="mensagem" class="size-5" />
          Pedir orçamento
        </a>
      )
    }
    {
      l.mensagem && (
        <a href={l.mensagem} target="_blank" rel="noopener noreferrer" class={classesBotao("contornoZap", "m")}>
          <Icone nome="mensagem" class="size-4" />
          Enviar mensagem
        </a>
      )
    }
    {
      l.telefone && l.numero && (
        <a href={l.telefone} class={classesBotao("contorno", "m")}>
          <Icone nome="telefone" class="size-4" />
          Ligar · {formatarTelefone(l.numero)}
        </a>
      )
    }
    {
      l.comoChegar && (
        <a href={l.comoChegar} target="_blank" rel="noopener noreferrer" class={classesBotao("contorno", "m")}>
          <Icone nome="rota" class="size-4" />
          Como chegar
        </a>
      )
    }
  </div>
</div>
