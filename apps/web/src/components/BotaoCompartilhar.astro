---
// Usa o compartilhamento nativo do celular; no computador, copia o link e
// avisa com uma mensagem na própria tela.
import { Icone, classesBotao } from "@acheaqui/ui";

interface Props {
  caminho: string;
  titulo: string;
  variante?: "icone" | "botao";
}

const { caminho, titulo, variante = "icone" } = Astro.props;
---

{
  variante === "icone" ? (
    <button
      type="button"
      data-compartilhar={caminho}
      data-titulo={titulo}
      class={classesBotao("contorno", "m", "w-11 shrink-0 px-0!")}
      aria-label={`Compartilhar ${titulo}`}
    >
      <Icone nome="compartilhar" class="size-5" />
    </button>
  ) : (
    <button type="button" data-compartilhar={caminho} data-titulo={titulo} class={classesBotao("contorno", "p")}>
      <Icone nome="compartilhar" class="size-4" />
      Compartilhar
    </button>
  )
}

<script>
  let aviso: HTMLDivElement | undefined;
  let temporizador: ReturnType<typeof setTimeout> | undefined;

  function avisar(texto: string) {
    if (!aviso) {
      aviso = document.createElement("div");
      aviso.setAttribute("role", "status");
      aviso.className =
        "fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-full bg-tinta px-5 py-2.5 text-sm font-bold text-white shadow-xl lg:bottom-8";
      document.body.append(aviso);
    }
    aviso.textContent = texto;
    aviso.hidden = false;
    clearTimeout(temporizador);
    temporizador = setTimeout(() => {
      if (aviso) aviso.hidden = true;
    }, 2500);
  }

  async function compartilhar(caminho: string, titulo: string) {
    const url = new URL(caminho, window.location.origin).toString();
    if (navigator.share) {
      try {
        await navigator.share({ title: titulo, url });
        return;
      } catch (erro) {
        if (erro instanceof DOMException && erro.name === "AbortError") return; // a pessoa cancelou
        console.error("Falha no compartilhamento nativo, copiando o link:", erro);
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      avisar("Link copiado!");
    } catch (erro) {
      console.error("Não foi possível copiar o link:", erro);
      avisar("Não foi possível copiar o link.");
    }
  }

  // Um ouvinte só para todos os botões da página (as listas têm um por cartão).
  document.addEventListener("click", (evento) => {
    const botao = (evento.target as Element).closest<HTMLElement>("[data-compartilhar]");
    if (botao) void compartilhar(botao.dataset.compartilhar ?? "/", botao.dataset.titulo ?? "");
  });
</script>
