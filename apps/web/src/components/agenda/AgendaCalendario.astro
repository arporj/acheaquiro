---
// Agenda em calendário mensal: o visitante navega pelos meses (para frente e
// para trás), escolhe o dia e vê quem se apresenta. A página fica no cache e
// leva prontos só os meses de mesesNaPagina() (1 antes e 3 depois do atual);
// ao navegar para outro mês, o navegador busca só aquele mês em /agenda/mes.
// O calendário, a troca de dia e os filtros (bairro e artista, este pelo
// endereço ?artista=slug) rodam no navegador.
import { Icone } from "@acheaqui/ui";
import ItemAgendaLista from "./ItemAgendaLista.astro";
import type { ItemAgenda } from "@/dados/consultas";

interface Props {
  itens: ItemAgenda[];
  /** Meses (AAAA-MM) já incluídos em itens. */
  meses: string[];
  /** Agenda de um comércio só (seção Agenda do perfil). */
  anuncianteId?: string;
  /** Opções do filtro de bairro. */
  bairros?: { id: string; nome: string }[];
  /** No perfil do comércio o lugar é sempre o mesmo; não precisa repetir. */
  mostrarLugar?: boolean;
  filtroBairro?: boolean;
  /** Lê ?artista=slug e mostra só os shows desse artista, com a opção de tirar o filtro. */
  filtroArtista?: boolean;
  /** "calendario": o mês inteiro. "faixa": 14 dias numa linha, para quando há pouco espaço (perfil do comércio). */
  formato?: "calendario" | "faixa";
}

const { itens, meses, anuncianteId, bairros = [], mostrarLugar = true, filtroBairro = false, filtroArtista = false, formato = "calendario" } =
  Astro.props;
const faixa = formato === "faixa";
---

<div
  data-agenda
  data-formato={formato}
  data-filtro-artista={filtroArtista ? "sim" : undefined}
  data-meses={meses.join(",")}
  data-anunciante={anuncianteId}
  data-sem-lugar={mostrarLugar ? undefined : "sim"}
>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    {
      filtroBairro && bairros.length > 1 && (
        <label class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold shadow-sm ring-1 ring-black/5">
          <Icone nome="pin" class="size-4 text-vermelho-500" />
          <select data-bairro class="bg-transparent font-bold outline-none">
            <option value="">Todos os bairros</option>
            {bairros.map((b) => <option value={b.id}>{b.nome}</option>)}
          </select>
        </label>
      )
    }
    <p data-aviso-artista hidden class="inline-flex items-center gap-2 rounded-full bg-azul-600 py-1.5 pr-1.5 pl-4 text-sm font-bold text-white">
      <span>Só os shows de <span data-nome-artista></span></span>
      <button type="button" data-tirar-artista class="inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 hover:bg-white/30">
        <Icone nome="fechar" class="size-3.5" />
        Ver todos
      </button>
    </p>
  </div>

  <section class={faixa ? "" : "rounded-3xl bg-white p-4 shadow-sm ring-1 ring-black/5 sm:p-5"} aria-label="Calendário">
    <div class="mb-3 flex items-center justify-between gap-2">
      <button type="button" data-mes-anterior class="grid size-10 place-items-center rounded-full ring-1 ring-azul-100 hover:bg-azul-50" aria-label={faixa ? "2 semanas antes" : "Mês anterior"}>
        <Icone nome="esquerda" class="size-5 text-azul-700" />
      </button>
      <div class="text-center">
        <h2 data-titulo-mes class="font-display text-lg font-extrabold text-azul-900 first-letter:uppercase"></h2>
        <button type="button" data-ir-hoje class="text-xs font-bold text-azul-600 hover:underline">Voltar para hoje</button>
      </div>
      <button type="button" data-mes-seguinte class="grid size-10 place-items-center rounded-full ring-1 ring-azul-100 hover:bg-azul-50" aria-label={faixa ? "2 semanas depois" : "Próximo mês"}>
        <Icone nome="direita" class="size-5 text-azul-700" />
      </button>
    </div>
    {
      !faixa && (
        <div class="grid grid-cols-7 gap-1 text-center text-[0.7rem] font-bold text-slate-400 uppercase" aria-hidden="true">
          <span>Dom</span>
          <span>Seg</span>
          <span>Ter</span>
          <span>Qua</span>
          <span>Qui</span>
          <span>Sex</span>
          <span>Sáb</span>
        </div>
      )
    }
    <div data-dias class={faixa ? "-mx-1 flex snap-x gap-1 overflow-x-auto px-1 pb-1" : "mt-1 grid grid-cols-7 gap-1"}></div>
  </section>

  <h3 data-titulo-dia class="mt-5 mb-2 font-display text-lg font-bold text-azul-900 first-letter:uppercase"></h3>
  <ul data-lista class="space-y-2">
    {
      itens.map((it) => (
        <ItemAgendaLista it={it} mostrarLugar={mostrarLugar} />
      ))
    }
  </ul>
  <p data-carregando hidden class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">Carregando a agenda do mês...</p>
  <p data-erro hidden class="rounded-2xl bg-vermelho-50 px-4 py-6 text-center text-sm font-semibold text-vermelho-700">
    Não foi possível carregar este mês. Tente de novo em instantes.
  </p>
  <p data-vazio hidden class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
    Nenhuma apresentação neste dia.
  </p>
</div>

<script>
  import { ligarAgendaCalendario } from "@/lib/agendaCalendario";

  for (const agenda of document.querySelectorAll<HTMLElement>("[data-agenda]")) ligarAgendaCalendario(agenda);
</script>
