---
// Agenda em calendário mensal: o visitante navega pelos meses (para frente e
// para trás), escolhe o dia e vê quem se apresenta. A página fica no cache,
// então o calendário, a troca de dia e os filtros (bairro e artista, este
// pelo endereço ?artista=slug) rodam no navegador, sobre a lista completa.
import { Icone } from "@acheaqui/ui";
import AvatarArtista from "./AvatarArtista.astro";
import type { ItemAgenda } from "@/dados/consultas";

interface Props {
  itens: ItemAgenda[];
  /** No perfil do comércio o lugar é sempre o mesmo; não precisa repetir. */
  mostrarLugar?: boolean;
  filtroBairro?: boolean;
  /** Lê ?artista=slug e mostra só os shows desse artista, com a opção de tirar o filtro. */
  filtroArtista?: boolean;
}

const { itens, mostrarLugar = true, filtroBairro = false, filtroArtista = false } = Astro.props;
const bairros = [...new Map(itens.map((i) => [i.lugar.bairroId, i.lugar.bairro])).entries()].sort((a, b) => a[1].localeCompare(b[1], "pt-BR"));
---

<div data-agenda data-filtro-artista={filtroArtista ? "sim" : undefined}>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    {
      filtroBairro && bairros.length > 1 && (
        <label class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold shadow-sm ring-1 ring-black/5">
          <Icone nome="pin" class="size-4 text-vermelho-500" />
          <select data-bairro class="bg-transparent font-bold outline-none">
            <option value="">Todos os bairros</option>
            {bairros.map(([id, nome]) => <option value={id}>{nome}</option>)}
          </select>
        </label>
      )
    }
    <p data-aviso-artista hidden class="inline-flex items-center gap-2 rounded-full bg-azul-600 py-1.5 pr-1.5 pl-4 text-sm font-bold text-white">
      <span>Só os shows de <span data-nome-artista></span></span>
      <button type="button" data-tirar-artista class="inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1 hover:bg-white/30">
        <Icone nome="fechar" class="size-3.5" />
        Ver todos
      </button>
    </p>
  </div>

  <section class="rounded-3xl bg-white p-4 shadow-sm ring-1 ring-black/5 sm:p-5" aria-label="Calendário">
    <div class="mb-3 flex items-center justify-between gap-2">
      <button type="button" data-mes-anterior class="grid size-10 place-items-center rounded-full ring-1 ring-azul-100 hover:bg-azul-50" aria-label="Mês anterior">
        <Icone nome="esquerda" class="size-5 text-azul-700" />
      </button>
      <div class="text-center">
        <h2 data-titulo-mes class="font-display text-lg font-extrabold text-azul-900 first-letter:uppercase"></h2>
        <button type="button" data-ir-hoje class="text-xs font-bold text-azul-600 hover:underline">Voltar para hoje</button>
      </div>
      <button type="button" data-mes-seguinte class="grid size-10 place-items-center rounded-full ring-1 ring-azul-100 hover:bg-azul-50" aria-label="Próximo mês">
        <Icone nome="direita" class="size-5 text-azul-700" />
      </button>
    </div>
    <div class="grid grid-cols-7 gap-1 text-center text-[0.7rem] font-bold text-slate-400 uppercase" aria-hidden="true">
      <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span>
    </div>
    <div data-dias class="mt-1 grid grid-cols-7 gap-1"></div>
  </section>

  <h3 data-titulo-dia class="mt-5 mb-2 font-display text-lg font-bold text-azul-900 first-letter:uppercase"></h3>
  <ul data-lista class="space-y-2">
    {
      itens.map((it) => (
        <li
          hidden
          data-dia={it.data}
          data-artista={it.artista.slug}
          data-artista-nome={it.artista.nome}
          data-item-bairro={it.lugar.bairroId}
          class="flex items-center gap-3 rounded-2xl bg-white p-3 shadow-sm ring-1 ring-black/5"
        >
          <span class="w-14 shrink-0 text-center">
            <span class="block font-display text-lg leading-tight font-extrabold text-azul-900">{it.inicio}</span>
            {it.fim && <span class="block text-[0.7rem] font-bold text-slate-400">até {it.fim}</span>}
          </span>
          <a href={`/artista/${it.artista.slug}`} aria-hidden="true" tabindex="-1">
            <AvatarArtista artista={it.artista} class="size-11" />
          </a>
          <span class="min-w-0 flex-1">
            <a href={`/artista/${it.artista.slug}`} class="block font-bold text-azul-900 hover:underline">
              {it.artista.nome}
            </a>
            <span class="block text-xs font-semibold text-slate-500">
              {it.artista.estilo} ·{" "}
              <a href={`/artista/${it.artista.slug}`} class="text-azul-600 hover:underline">
                ver artista
              </a>
            </span>
            {mostrarLugar && (
              <a href={it.lugar.href} class="mt-0.5 inline-flex items-center gap-1 text-sm font-bold text-azul-600 hover:underline">
                <Icone nome="pin" class="size-3.5 text-vermelho-500" />
                {it.lugar.nome}
                <span class="font-semibold text-slate-500">· {it.lugar.bairro}</span>
              </a>
            )}
          </span>
        </li>
      ))
    }
  </ul>
  <p data-vazio hidden class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
    Nenhuma apresentação neste dia.
  </p>
</div>

<script>
  import { ligarAgendaCalendario } from "@/lib/agendaCalendario";

  for (const agenda of document.querySelectorAll<HTMLElement>("[data-agenda]")) ligarAgendaCalendario(agenda);
</script>
