---
// Agenda por dia: faixa com os próximos dias e, embaixo, quem se apresenta no
// dia escolhido. A página fica no cache, então a troca de dia (e o filtro de
// bairro) acontece no navegador, sobre a lista completa já enviada.
import { Icone } from "@acheaqui/ui";
import AvatarArtista from "./AvatarArtista.astro";
import { hojeNaCidade, somarDias, type ItemAgenda } from "@/dados/consultas";
import { diaDaSemana } from "@/lib/texto";

interface Props {
  itens: ItemAgenda[];
  /** Quantos dias mostrar, a partir de hoje. */
  dias?: number;
  /** No perfil do comércio o lugar é sempre o mesmo; não precisa repetir. */
  mostrarLugar?: boolean;
  filtroBairro?: boolean;
}

const { itens, dias = 14, mostrarLugar = true, filtroBairro = false } = Astro.props;
const SEMANA = ["dom", "seg", "ter", "qua", "qui", "sex", "sáb"];
const hoje = hojeNaCidade();

const listaDias = Array.from({ length: dias }, (_, i) => {
  const iso = somarDias(hoje, i);
  const [, mes, dia] = iso.split("-");
  const semana = SEMANA[diaDaSemana(iso)];
  const rotulo = i === 0 ? "Hoje" : i === 1 ? "Amanhã" : semana;
  return { iso, rotulo, numero: `${dia}/${mes}`, itens: itens.filter((it) => it.data === iso) };
});
const primeiroComShow = listaDias.find((d) => d.itens.length > 0)?.iso ?? hoje;
const bairros = [...new Map(itens.map((i) => [i.lugar.bairroId, i.lugar.bairro])).entries()].sort((a, b) => a[1].localeCompare(b[1], "pt-BR"));
---

<div data-agenda>
  {
    filtroBairro && bairros.length > 1 && (
      <label class="mb-3 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold shadow-sm ring-1 ring-black/5">
        <Icone nome="pin" class="size-4 text-vermelho-500" />
        <select data-bairro class="bg-transparent font-bold outline-none">
          <option value="">Todos os bairros</option>
          {bairros.map(([id, nome]) => <option value={id}>{nome}</option>)}
        </select>
      </label>
    )
  }

  <div class="-mx-1 flex snap-x gap-2 overflow-x-auto px-1 pb-2" role="tablist" aria-label="Escolha o dia">
    {
      listaDias.map((d) => (
        <button
          type="button"
          role="tab"
          data-dia={d.iso}
          aria-selected={d.iso === primeiroComShow ? "true" : "false"}
          class={`flex w-16 shrink-0 snap-start flex-col items-center rounded-2xl px-2 py-2 ring-1 transition aria-selected:bg-azul-600 aria-selected:text-white aria-selected:ring-azul-600 ${
            d.itens.length > 0 ? "bg-white text-azul-900 ring-azul-100 hover:ring-azul-400" : "bg-slate-50 text-slate-400 ring-slate-100"
          }`}
        >
          <span class="text-[0.7rem] font-bold uppercase">{d.rotulo}</span>
          <span class="font-display text-lg leading-tight font-extrabold">{d.numero.slice(0, 2)}</span>
          <span class="text-[0.65rem] font-bold">{d.itens.length > 0 ? `${d.itens.length} ${d.itens.length === 1 ? "show" : "shows"}` : "—"}</span>
        </button>
      ))
    }
  </div>

  {
    listaDias.map((d) => (
      <div data-lista={d.iso} hidden={d.iso !== primeiroComShow} class="mt-3">
        {d.itens.length === 0 ? (
          <p class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">Nenhuma apresentação neste dia.</p>
        ) : (
          <ul class="space-y-2">
            {d.itens.map((it) => (
              <li data-item-bairro={it.lugar.bairroId} class="flex items-center gap-3 rounded-2xl bg-white p-3 shadow-sm ring-1 ring-black/5">
                <span class="w-14 shrink-0 text-center">
                  <span class="block font-display text-lg leading-tight font-extrabold text-azul-900">{it.inicio}</span>
                  {it.fim && <span class="block text-[0.7rem] font-bold text-slate-400">até {it.fim}</span>}
                </span>
                <AvatarArtista artista={it.artista} class="size-11" />
                <span class="min-w-0 flex-1">
                  <a href={`/artista/${it.artista.slug}`} class="block font-bold text-azul-900 hover:underline">{it.artista.nome}</a>
                  <span class="block text-xs font-semibold text-slate-500">{it.artista.estilo}</span>
                  {mostrarLugar && (
                    <a href={it.lugar.href} class="mt-0.5 inline-flex items-center gap-1 text-sm font-bold text-azul-600 hover:underline">
                      <Icone nome="pin" class="size-3.5 text-vermelho-500" />
                      {it.lugar.nome}
                      <span class="font-semibold text-slate-500">· {it.lugar.bairro}</span>
                    </a>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )}
        <p data-vazio-bairro hidden class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
          Nenhuma apresentação neste bairro neste dia.
        </p>
      </div>
    ))
  }
</div>

<script>
  for (const agenda of document.querySelectorAll<HTMLElement>("[data-agenda]")) {
    const botoes = [...agenda.querySelectorAll<HTMLButtonElement>("[data-dia]")];
    const listas = [...agenda.querySelectorAll<HTMLElement>("[data-lista]")];
    const bairro = agenda.querySelector<HTMLSelectElement>("[data-bairro]");

    const aplicarBairro = () => {
      const escolhido = bairro?.value ?? "";
      for (const lista of listas) {
        const itens = [...lista.querySelectorAll<HTMLElement>("[data-item-bairro]")];
        let visiveis = 0;
        for (const item of itens) {
          item.hidden = escolhido !== "" && item.dataset.itemBairro !== escolhido;
          if (!item.hidden) visiveis++;
        }
        const aviso = lista.querySelector<HTMLElement>("[data-vazio-bairro]");
        if (aviso) aviso.hidden = itens.length === 0 || visiveis > 0;
      }
    };

    for (const botao of botoes) {
      botao.addEventListener("click", () => {
        for (const b of botoes) b.setAttribute("aria-selected", String(b === botao));
        for (const lista of listas) lista.hidden = lista.dataset.lista !== botao.dataset.dia;
      });
    }
    bairro?.addEventListener("change", aplicarBairro);
  }
</script>
