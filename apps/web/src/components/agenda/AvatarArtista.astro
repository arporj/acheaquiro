---
// Foto do artista; sem foto, um avatar provisório com a cor e o ícone.
import { IconeCategoria } from "@acheaqui/ui";
import type { Artista } from "@acheaqui/types";

interface Props {
  artista: Artista;
  class?: string;
}

const { artista, class: classe = "size-12" } = Astro.props;
---

{
  artista.foto?.url ? (
    <img
      src={artista.foto.url}
      alt=""
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
      class={`shrink-0 rounded-full object-cover ${classe}`}
      style={`background-color: ${artista.cor}`}
    />
  ) : (
    <span class={`grid shrink-0 place-items-center rounded-full text-white ${classe}`} style={`background-color: ${artista.cor}`} aria-hidden="true">
      <IconeCategoria nome="music" class="size-1/2" strokeWidth={2} />
    </span>
  )
}
