---
import { listarPatrocinadores } from "@/dados/consultas";
import { ambiente } from "@/lib/ambiente";
import Logo from "./Logo.astro";
import FaixaOferecimento from "./patrocinadores/FaixaOferecimento.astro";

// Fale conosco entra na lista quando a página existir.
// A página "em breve" não tem outras páginas para onde levar. "Patrocinadores"
// só aparece com algum patrocinador no ar; "Patrocine" sempre, para vender.
const temPatrocinador = ambiente !== "em-breve" && (await listarPatrocinadores()).length > 0;
const links =
  ambiente === "em-breve"
    ? []
    : [
        { href: "/sobre", rotulo: "Sobre o Ache Aqui RO" },
        { href: "/anuncie", rotulo: "Anuncie aqui" },
        { href: "/fundadores", rotulo: "Fundadores" },
        { href: "/representante", rotulo: "Seja um representante" },
        ...(temPatrocinador ? [{ href: "/patrocinadores", rotulo: "Patrocinadores" }] : []),
        { href: "/patrocine", rotulo: "Patrocine" },
        { href: "/termos", rotulo: "Termos de Uso" },
        { href: "/privacidade", rotulo: "Política de Privacidade" },
      ];
---

<footer class="mt-auto bg-azul-900 text-white/80">
  {ambiente !== "em-breve" && <FaixaOferecimento />}
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-[1.4fr_1fr]">
    <div class="space-y-3">
      <Logo />
      <p class="max-w-sm text-sm leading-relaxed">
        Os melhores profissionais e comércios de Rio das Ostras, num lugar só. Você fala direto com eles, pelo WhatsApp ou
        telefone.
      </p>
    </div>
    {
      links.length > 0 && (
        <nav aria-label="Institucional">
          <h2 class="mb-3 font-display text-lg font-bold text-amarelo-400">O Ache Aqui</h2>
          <ul class="space-y-2 text-sm">
            {links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white hover:underline">
                  {link.rotulo}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs leading-relaxed text-white/60">
      O Ache Aqui RO apenas divulga os anunciantes. Não se responsabiliza pelos serviços prestados nem pelas negociações
      entre as partes. © 2026 Ache Aqui RO · Rio das Ostras, RJ
    </p>
  </div>
</footer>
