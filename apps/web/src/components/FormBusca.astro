---
import { Icone, classesBotao } from "@acheaqui/ui";
import { listarBairros } from "@/dados/consultas";

// Funciona sem JavaScript: envia um GET para /busca?q=...&bairro=...
interface Props {
  variante?: "destaque" | "compacta";
}

const { variante = "compacta" } = Astro.props;
const bairros = await listarBairros();
---

{
  variante === "compacta" ? (
    <form action="/busca" class="flex w-full items-center gap-2" role="search">
      <label class="relative flex-1">
        <span class="sr-only">O que você procura?</span>
        <Icone nome="busca" class="pointer-events-none absolute top-1/2 left-3.5 size-5 -translate-y-1/2 text-slate-400" />
        <input
          name="q"
          type="search"
          placeholder="Eletricista, pizza, diarista..."
          class="h-11 w-full rounded-full border-0 bg-white pr-4 pl-11 text-[0.95rem] text-tinta shadow-sm ring-1 ring-azul-100 placeholder:text-slate-400 focus:ring-3 focus:ring-amarelo-400 focus:outline-none"
        />
      </label>
      <label class="hidden md:block">
        <span class="sr-only">Bairro</span>
        <select
          name="bairro"
          class="h-11 max-w-48 rounded-full border-0 bg-white px-4 text-sm font-semibold text-tinta ring-1 ring-azul-100 focus:ring-3 focus:ring-amarelo-400 focus:outline-none"
        >
          <option value="">Todos os bairros</option>
          {bairros.map((b) => <option value={b.id}>{b.nome}</option>)}
        </select>
      </label>
      <button type="submit" class={classesBotao("amarelo", "m", "shrink-0 px-4 shadow-none")}>
        <span class="hidden sm:inline">Buscar</span>
        <Icone nome="busca" class="size-5 sm:hidden" />
        <span class="sr-only sm:hidden">Buscar</span>
      </button>
    </form>
  ) : (
    <form
      action="/busca"
      role="search"
      class="flex w-full flex-col gap-2 rounded-3xl bg-white p-2 shadow-[0_12px_40px_-12px_rgb(10_34_102/0.55)] md:flex-row md:items-center md:rounded-full"
    >
      <label class="relative flex-1">
        <span class="sr-only">O que você procura?</span>
        <Icone nome="busca" class="pointer-events-none absolute top-1/2 left-4 size-6 -translate-y-1/2 text-azul-500" />
        <input
          name="q"
          type="search"
          placeholder="O que você procura? Ex.: eletricista"
          class="h-14 w-full rounded-full border-0 bg-transparent pr-4 pl-13 text-lg font-semibold text-tinta placeholder:font-normal placeholder:text-slate-400 focus:bg-azul-50 focus:outline-none"
        />
      </label>
      <span class="hidden h-8 w-px bg-slate-200 md:block" aria-hidden="true" />
      <label class="relative md:w-60">
        <span class="sr-only">Bairro</span>
        <Icone nome="pin" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-vermelho-500" />
        <select
          name="bairro"
          class="h-14 w-full appearance-none rounded-full border-0 bg-fundo pr-10 pl-11 font-semibold text-tinta focus:ring-3 focus:ring-amarelo-400 focus:outline-none md:bg-transparent"
        >
          <option value="">Todos os bairros</option>
          {bairros.map((b) => <option value={b.id}>{b.nome}</option>)}
        </select>
        <Icone nome="abaixo" class="pointer-events-none absolute top-1/2 right-4 size-5 -translate-y-1/2 text-slate-400" />
      </label>
      <button type="submit" class={classesBotao("amarelo", "g", "h-14! px-8! text-lg!")}>
        <Icone nome="busca" class="size-5" />
        Buscar
      </button>
    </form>
  )
}
