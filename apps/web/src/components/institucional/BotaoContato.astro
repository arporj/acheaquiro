---
// Botão de contato com a equipe: abre o WhatsApp da equipe com uma mensagem
// pronta (LinkContatoEquipe). Sem mensagem própria, a mensagem repete o rótulo
// ("Quero anunciar"), para a equipe saber de onde veio o contato.
import { Icone, classesBotao, type VarianteBotao } from "@acheaqui/ui";
import { mensagemEquipe } from "@/lib/contato";
import LinkContatoEquipe from "./LinkContatoEquipe.astro";

interface Props {
  rotulo: string;
  /** Texto que chega no WhatsApp. */
  mensagem?: string;
  variante?: VarianteBotao;
  class?: string;
}

const { rotulo, mensagem, variante = "amarelo", class: classe = "" } = Astro.props;
---

<LinkContatoEquipe mensagem={mensagem ?? mensagemEquipe(rotulo)} class={classesBotao(variante, "g", classe)}>
  <Icone nome="mensagem" class="size-5" />
  {rotulo}
</LinkContatoEquipe>
