---
// Campos do perfil do anunciante, no cadastro assistido (/admin/anunciantes/novo
// e /representante/anunciantes/novo) e na edição (as telas [id] das duas áreas). O servidor valida tudo de novo
// (lerFormulario, em src/lib/anunciantesAdmin.ts). Os blocos de autônomo e de
// comércio ficam desligados quando não servem, para não serem enviados. O
// cadastro próprio e a área do anunciante mostram uma parte por vez (secoes),
// gravada por salvarParte (src/lib/cadastroProprio.ts).
import { agruparCategorias, formasDaProfissao } from "@acheaqui/domain";
import { classesBotao } from "@acheaqui/ui";
import { NOMES_DIAS } from "@acheaqui/validation";
import { classesCampo, classesErroCampo, classesRotulo } from "@/components/conta/estilos";
import { textoValorPlano } from "@/lib/precos";
import type { Opcoes, SecaoFormulario, ValoresFormulario } from "@/lib/anunciantesAdmin";

interface Props {
  opcoes: Opcoes;
  valores: ValoresFormulario;
  erros: Record<string, string>;
  /** Na edição o tipo não muda. */
  tipoFixo?: "profissional" | "comercio";
  /** Com a conta já ligada, o e-mail do convite não muda aqui. */
  emailTravado?: boolean;
  textoBotao: string;
  /** O representante não escolhe: o cadastro fica sempre ligado a ele. */
  escolherRepresentante?: boolean;
  /** Partes mostradas; sem a lista, todas (cadastro assistido e edição pela equipe). */
  secoes?: SecaoFormulario[];
  /** Link "Voltar" ao lado do botão (etapas do cadastro próprio e edição pela área). */
  voltar?: { href: string; texto: string };
}

const { opcoes, valores: v, erros, tipoFixo, emailTravado = false, textoBotao, escolherRepresentante = true, secoes, voltar } = Astro.props;
const mostra = (s: SecaoFormulario) => !secoes || secoes.includes(s);
const tipo = tipoFixo ?? v.tipo;

const grupos = agruparCategorias(opcoes.categorias, (c) => c.nome, { gruposEmOrdemAlfabetica: true });
// Forma da profissão (decisão Q3 de 26/11/2026): só aparece quando a categoria
// principal tem as duas formas; o script troca os rótulos quando ela muda.
const categoriaEscolhida = opcoes.categorias.find((c) => c.id === v.categoriaPrincipalId);
const formasEscolhida = categoriaEscolhida ? formasDaProfissao(categoriaEscolhida) : null;
const FORMAS = [
  { id: "pix", rotulo: "Pix" },
  { id: "cartao", rotulo: "Cartão" },
  { id: "dinheiro", rotulo: "Dinheiro" },
];
const caixa = "mt-2 max-h-64 overflow-y-auto rounded-2xl border-2 border-azul-100 bg-white p-3";
// min-h-11: alvo de toque de 44 px no celular.
const opcaoMarcavel = "flex min-h-11 items-center gap-2 py-1 text-sm";
const tituloGrupo = "text-xs font-extrabold tracking-wide text-slate-400 uppercase";
const SEM_CATEGORIA = "Nenhuma categoria encontrada. Tente outra palavra, como o nome do serviço, e confira se o tipo (Autônomo ou Comércio) está certo.";
// Textos em que a busca de categoria procura (regra em categoriaCombinaComBusca, packages/domain).
const SEPARADOR_BUSCA = "|";
const textoBusca = (c: (typeof opcoes.categorias)[number]) => [c.nome, ...c.termosBusca, c.grupo].join(SEPARADOR_BUSCA);
const secao = "mt-6 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5";
const tituloSecao = "font-display text-lg font-bold text-azul-900";
const textarea = "mt-1 w-full rounded-2xl border-2 border-azul-100 p-3 focus:border-azul-500 focus:outline-none";
const erro = (campo: string) => erros[campo];

// Horário: a semana começa na segunda, como no perfil (Horario.astro).
const ORDEM_DIAS = [1, 2, 3, 4, 5, 6, 0];
const campoHora = "h-11 w-full min-w-0 rounded-xl border-2 border-azul-100 bg-white px-2 text-base text-tinta focus:border-azul-500 focus:outline-none disabled:opacity-40";

// O script ao fim refaz o texto quando o plano ou a periodicidade mudam.
const textoValor = textoValorPlano(opcoes.planos.find((p) => p.id === v.planoEscolhidoId)?.valores, v.periodicidade);
---

<form method="post" data-formulario-anunciante data-tipo-fixo={tipoFixo} novalidate>
  <input type="hidden" name="acao" value="salvar" />

  {mostra("perfil") && (
  <section class={secao}>
    <h2 class={tituloSecao}>Perfil</h2>

    {
      tipoFixo ? (
        <p class="mt-2 text-sm text-slate-600">{tipoFixo === "profissional" ? "Autônomo" : "Comércio"} (o tipo não muda depois do cadastro).</p>
      ) : (
        <fieldset class="mt-3">
          <legend class="text-sm font-bold text-azul-900">Tipo</legend>
          <div class="mt-1 flex gap-4">
            <label class="flex items-center gap-2"><input type="radio" name="tipo" value="profissional" checked={tipo === "profissional"} required /> Autônomo</label>
            <label class="flex items-center gap-2"><input type="radio" name="tipo" value="comercio" checked={tipo === "comercio"} /> Comércio</label>
          </div>
          {erro("tipo") && <p class={classesErroCampo}>{erro("tipo")}</p>}
        </fieldset>
      )
    }

    <label class={classesRotulo}>
      Nome no site
      <input name="nome" value={v.nome} required maxlength="100" class={classesCampo} aria-invalid={erro("nome") ? "true" : undefined} />
    </label>
    {erro("nome") && <p class={classesErroCampo}>{erro("nome")}</p>}

    <label class={classesRotulo}>
      Buscar categoria
      <input
        type="search"
        data-busca-categoria
        placeholder="Ex.: corretor, pizzaria, dentista"
        autocomplete="off"
        enterkeyhint="search"
        class={classesCampo}
      />
    </label>
    <p class="mt-1 text-xs text-slate-500">A busca vale para a categoria principal e as adicionais.</p>

    <fieldset class="mt-4">
      <legend class="text-sm font-bold text-azul-900">Categoria principal</legend>
      <p class="mt-1 text-sm text-slate-700" data-categoria-escolhida aria-live="polite"></p>
      <div class={caixa}>
        {
          grupos.map((g) => (
            <div class="mb-2" data-grupo-categoria>
              <p class={tituloGrupo}>{g.grupo}</p>
              {g.categorias.map((c) => (
                <label class={opcaoMarcavel} data-tipo-categoria={c.tipo} data-busca={textoBusca(c)}>
                  <input
                    type="radio"
                    name="categoriaPrincipalId"
                    value={c.id}
                    required
                    checked={c.id === v.categoriaPrincipalId}
                    data-forma-feminino={formasDaProfissao(c)?.feminino}
                    data-forma-masculino={formasDaProfissao(c)?.masculino}
                  />
                  {c.nome}
                </label>
              ))}
            </div>
          ))
        }
        <p class="text-sm text-slate-600" data-sem-categoria hidden>{SEM_CATEGORIA}</p>
      </div>
    </fieldset>
    {erro("categoriaPrincipalId") && <p class={classesErroCampo}>{erro("categoriaPrincipalId")}</p>}

    <fieldset class="mt-4" data-forma-profissao hidden={!formasEscolhida}>
      <legend class="text-sm font-bold text-azul-900">Como a profissão aparece no anúncio</legend>
      <p class="mt-1 text-xs text-slate-500">Vale para o card, o perfil e o link compartilhado. Sem escolha, aparece o nome da categoria.</p>
      <div class="mt-1 flex flex-wrap gap-x-4">
        {
          (["feminino", "masculino"] as const).map((forma) => (
            <label class={opcaoMarcavel}>
              <input
                type="radio"
                name="formaProfissao"
                value={forma}
                checked={v.formaProfissao === forma}
                disabled={!formasEscolhida}
              />
              <span data-rotulo-forma={forma}>{formasEscolhida?.[forma]}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    {erro("formaProfissao") && <p class={classesErroCampo}>{erro("formaProfissao")}</p>}

    <details class="mt-4" open={v.categoriasAdicionais.length > 0 || !!erro("categoriasAdicionais")}>
      <summary class="cursor-pointer text-sm font-bold text-azul-900">
        Categorias adicionais ({v.categoriasAdicionais.length} marcada(s); o limite depende do plano)
      </summary>
      <div class={caixa}>
        {
          grupos.map((g) => (
            <div class="mb-2" data-grupo-categoria>
              <p class={tituloGrupo}>{g.grupo}</p>
              {g.categorias.map((c) => (
                  <label class={opcaoMarcavel} data-tipo-categoria={c.tipo} data-busca={textoBusca(c)}>
                    <input type="checkbox" name="categoriasAdicionais" value={c.id} checked={v.categoriasAdicionais.includes(c.id)} />
                    {c.nome}
                  </label>
                ))}
            </div>
          ))
        }
        <p class="text-sm text-slate-600" data-sem-categoria hidden>{SEM_CATEGORIA}</p>
      </div>
    </details>
    {erro("categoriasAdicionais") && <p class={classesErroCampo}>{erro("categoriasAdicionais")}</p>}

    <label class={classesRotulo}>
      Descrição
      <textarea name="descricao" rows="4" maxlength="2000" class={textarea}>{v.descricao}</textarea>
    </label>
    {erro("descricao") && <p class={classesErroCampo}>{erro("descricao")}</p>}
  </section>
  )}

  {mostra("contato") && (
  <section class={secao}>
    <h2 class={tituloSecao}>Contato</h2>
    <div class="grid gap-x-4 sm:grid-cols-2">
      <div>
        <label class={classesRotulo}>
          WhatsApp
          <input name="whatsapp" value={v.whatsapp} inputmode="tel" placeholder="(22) 99999-0000" class={classesCampo} aria-invalid={erro("whatsapp") ? "true" : undefined} />
        </label>
        {erro("whatsapp") && <p class={classesErroCampo}>{erro("whatsapp")}</p>}
      </div>
      <div>
        <label class={classesRotulo}>
          Telefone
          <input name="telefone" value={v.telefone} inputmode="tel" placeholder="(22) 2764-0000" class={classesCampo} aria-invalid={erro("telefone") ? "true" : undefined} />
        </label>
        {erro("telefone") && <p class={classesErroCampo}>{erro("telefone")}</p>}
      </div>
      <div>
        <label class={classesRotulo}>
          Instagram
          <input name="instagram" value={v.instagram} placeholder="@perfil" class={classesCampo} aria-invalid={erro("instagram") ? "true" : undefined} />
        </label>
        {erro("instagram") && <p class={classesErroCampo}>{erro("instagram")}</p>}
      </div>
      <div data-so="comercio">
        <label class={classesRotulo}>
          Site próprio
          <input name="siteProprio" value={v.siteProprio} placeholder="https://" class={classesCampo} aria-invalid={erro("siteProprio") ? "true" : undefined} />
        </label>
        {erro("siteProprio") && <p class={classesErroCampo}>{erro("siteProprio")}</p>}
      </div>
      <div data-so="profissional">
        <label class={classesRotulo}>
          Registro no conselho (CRM, CREA...)
          <input name="registroConselho" value={v.registroConselho} maxlength="60" class={classesCampo} />
        </label>
        {erro("registroConselho") && <p class={classesErroCampo}>{erro("registroConselho")}</p>}
      </div>
    </div>
    <fieldset class="mt-4">
      <legend class="text-sm font-bold text-azul-900">Formas de pagamento</legend>
      <div class="mt-1 flex flex-wrap gap-4">
        {
          FORMAS.map((f) => (
            <label class="flex items-center gap-2">
              <input type="checkbox" name="formasPagamento" value={f.id} checked={v.formasPagamento.includes(f.id)} />
              {f.rotulo}
            </label>
          ))
        }
      </div>
    </fieldset>
  </section>
  )}

  {mostra("horario") && (
  <section class={secao} data-horario>
    <h2 class={tituloSecao}>
      <span data-so-texto="profissional" hidden={tipo === "comercio"}>Horário de atendimento</span><span data-so-texto="comercio" hidden={tipo !== "comercio"}>Horário de funcionamento</span>
    </h2>
    <p class="mt-1 text-sm text-slate-600">
      Marque os dias em que atende e as horas. A segunda faixa é opcional (ex.: das 08:00 às 12:00 e das 14:00 às 18:00). Fechar depois da
      meia-noite vale (ex.: das 18:00 às 02:00); 24 horas é das 00:00 às 23:59. Sem nenhum dia marcado, o perfil mostra "Horário a combinar pelo
      WhatsApp".
    </p>
    <div class="mt-3 space-y-3">
      {
        ORDEM_DIAS.map((dia) => {
          const d = v.horario[dia]!;
          const rotulo = NOMES_DIAS[dia];
          return (
            <fieldset class="rounded-2xl bg-fundo p-3" data-dia-horario={dia}>
              <legend class="sr-only">{rotulo}</legend>
              <div class="grid grid-cols-[7rem_minmax(0,1fr)] items-center gap-x-3 gap-y-2 sm:grid-cols-[7rem_repeat(2,minmax(0,1fr))]">
                <label class="flex min-h-11 items-center gap-2 font-bold text-azul-900">
                  <input type="checkbox" name={`horario.${dia}.aberto`} checked={d.aberto} data-dia-aberto />
                  {rotulo}
                </label>
                {[1, 2].map((faixa) => (
                  <div class:list={["flex items-center gap-1.5", faixa === 2 && "col-start-2 sm:col-start-auto"]} data-faixa>
                    <input
                      type="time"
                      name={`horario.${dia}.abre${faixa}`}
                      value={faixa === 1 ? d.abre1 : d.abre2}
                      aria-label={`${rotulo}, ${faixa}ª faixa: abre às`}
                      class={campoHora}
                    />
                    <span class="text-sm text-slate-500">às</span>
                    <input
                      type="time"
                      name={`horario.${dia}.fecha${faixa}`}
                      value={faixa === 1 ? d.fecha1 : d.fecha2}
                      aria-label={`${rotulo}, ${faixa}ª faixa: fecha às`}
                      class={campoHora}
                    />
                  </div>
                ))}
              </div>
              {erro(`horario.${dia}`) && <p class={classesErroCampo}>{erro(`horario.${dia}`)}</p>}
            </fieldset>
          );
        })
      }
    </div>
    <button type="button" class={classesBotao("contorno", "m", "mt-3")} data-copiar-segunda>Copiar o horário de segunda para os outros dias marcados</button>
  </section>
  )}

  {mostra("onde") && (
  <section class={secao} data-so="profissional">
    <h2 class={tituloSecao}>Onde atende</h2>
    <label class="mt-3 flex items-center gap-2 font-bold">
      <input type="checkbox" name="atendeTodaCidade" checked={v.atendeTodaCidade} data-esconde-bairros="atendimento" />
      Atende a cidade toda
    </label>
    <div class={caixa} data-bairros="atendimento">
      {
        opcoes.bairros.map((b) => (
          <label class={opcaoMarcavel}>
            <input type="checkbox" name="bairrosAtendidos" value={b.id} checked={v.bairrosAtendidos.includes(b.id)} />
            {b.nome}
          </label>
        ))
      }
    </div>
  </section>
  )}

  {mostra("onde") && (
  <section class={secao} data-so="comercio">
    <h2 class={tituloSecao}>Endereço</h2>
    <p class="mt-1 text-sm text-slate-600">Mudar a rua, o número ou o bairro tira o ponto do mapa; o "Como chegar" passa a usar o endereço escrito.</p>
    <div class="grid gap-x-4 sm:grid-cols-[1fr_8rem]">
      <div>
        <label class={classesRotulo}>
          Rua
          <input name="endereco.logradouro" value={v.logradouro} required maxlength="120" class={classesCampo} aria-invalid={erro("endereco.logradouro") ? "true" : undefined} />
        </label>
        {erro("endereco.logradouro") && <p class={classesErroCampo}>{erro("endereco.logradouro")}</p>}
      </div>
      <div>
        <label class={classesRotulo}>
          Número
          <input name="endereco.numero" value={v.numero} required maxlength="10" placeholder="S/N" class={classesCampo} aria-invalid={erro("endereco.numero") ? "true" : undefined} />
        </label>
        {erro("endereco.numero") && <p class={classesErroCampo}>{erro("endereco.numero")}</p>}
      </div>
      <label class={classesRotulo}>
        Complemento
        <input name="endereco.complemento" value={v.complemento} maxlength="60" class={classesCampo} />
      </label>
      <div class="sm:col-span-2">
        <label class={classesRotulo}>
          Bairro
          <select name="endereco.bairroId" required class={classesCampo} aria-invalid={erro("endereco.bairroId") ? "true" : undefined}>
            <option value="">Escolha</option>
            {opcoes.bairros.map((b) => <option value={b.id} selected={b.id === v.bairroEnderecoId}>{b.nome}</option>)}
          </select>
        </label>
        {erro("endereco.bairroId") && <p class={classesErroCampo}>{erro("endereco.bairroId")}</p>}
      </div>
    </div>

    <label class="mt-5 flex items-center gap-2 font-bold">
      <input type="checkbox" name="fazEntrega" checked={v.fazEntrega} data-mostra-entrega />
      Faz entrega
    </label>
    <div data-entrega>
      <label class="mt-2 flex items-center gap-2">
        <input type="checkbox" name="entregaTodaCidade" checked={v.entregaTodaCidade} data-esconde-bairros="entrega" />
        Na cidade toda
      </label>
      <div class={caixa} data-bairros="entrega">
        {
          opcoes.bairros.map((b) => (
            <label class={opcaoMarcavel}>
              <input type="checkbox" name="bairrosEntrega" value={b.id} checked={v.bairrosEntrega.includes(b.id)} />
              {b.nome}
            </label>
          ))
        }
      </div>
    </div>
  </section>
  )}

  {mostra("cadastro") && (
  <section class={secao}>
    <h2 class={tituloSecao}>Cadastro assistido</h2>
    <p class="mt-1 text-sm text-slate-600">
      O convite vai para este e-mail: o anunciante confere o perfil, aceita os Termos e cria a senha. O perfil só vai para o ar depois disso e da aprovação.
    </p>
    <label class={classesRotulo}>
      E-mail do anunciante
      <input
        name="emailConvite"
        type="email"
        value={v.emailConvite}
        maxlength="254"
        readonly={emailTravado}
        class={classesCampo}
        aria-invalid={erro("emailConvite") ? "true" : undefined}
      />
    </label>
    {emailTravado && <p class="mt-1 text-xs text-slate-500">A conta já está ligada a este e-mail.</p>}
    {erro("emailConvite") && <p class={classesErroCampo}>{erro("emailConvite")}</p>}

    <div class="grid gap-x-4 sm:grid-cols-2">
      <div>
        <label class={classesRotulo}>
          Plano escolhido
          <select name="planoEscolhidoId" required class={classesCampo} aria-invalid={erro("planoEscolhidoId") ? "true" : undefined}>
            <option value="" disabled selected={!v.planoEscolhidoId}>Escolha o plano</option>
            {
              opcoes.planos.map((p) => (
                <option
                  value={p.id}
                  data-tipo-plano={p.tipo}
                  data-gratuito={p.tipo === "comercio" && p.valor_mensal_centavos === 0 ? "" : undefined}
                  data-mensal={p.valores.mensal}
                  data-anual={p.valores.anual}
                  data-anual-fundador={p.valores.anualFundador ?? undefined}
                  selected={p.id === v.planoEscolhidoId}
                >
                  {p.nome} ({p.tipo === "profissional" ? "autônomo" : "comércio"})
                </option>
              ))
            }
          </select>
        </label>
        {erro("planoEscolhidoId") && <p class={classesErroCampo}>{erro("planoEscolhidoId")}</p>}
      </div>
      <fieldset class="mt-4">
        <legend class="text-sm font-bold text-azul-900">Pagamento</legend>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
          <label class="flex items-center gap-2"><input type="radio" name="periodicidade" value="anual" checked={v.periodicidade === "anual"} /> Anual</label>
          <label class="flex items-center gap-2"><input type="radio" name="periodicidade" value="mensal" checked={v.periodicidade === "mensal"} /> Mensal</label>
          <span class="font-bold text-azul-900" data-valor-plano aria-live="polite">{textoValor.valor}</span>
        </div>
        <p class="mt-1 text-sm font-bold text-zap-700" data-valor-fundador>{textoValor.fundador}</p>
      </fieldset>
    </div>

    {escolherRepresentante && (
    <label class={classesRotulo}>
      Representante que trouxe
      <select name="representanteId" class={classesCampo}>
        <option value="">Nenhum (equipe)</option>
        {opcoes.representantes.map((r) => <option value={r.id} selected={r.id === v.representanteId}>{r.nome} ({r.codigo})</option>)}
      </select>
    </label>
    )}
  </section>
  )}

  <div class="mt-6 flex flex-wrap items-center justify-end gap-3">
    {voltar && <a href={voltar.href} class={classesBotao("contorno", "g")}>{voltar.texto}</a>}
    <button type="submit" class={classesBotao("azul", "g")}>{textoBotao}</button>
  </div>
</form>

<script>
  import { categoriaCombinaComBusca } from "@acheaqui/domain";

  // Mostra só os campos do tipo escolhido e desliga os outros (não vão no envio).
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-formulario-anunciante]")) {
    const busca = form.querySelector<HTMLInputElement>("[data-busca-categoria]");

    // Busca de categoria: só esconde (com a classe), sem desligar, para as categorias
    // marcadas e escondidas pela busca continuarem no envio. O tipo usa o atributo hidden.
    const filtrarCategorias = () => {
      const texto = busca?.value ?? "";
      for (const opcao of form.querySelectorAll<HTMLElement>("[data-busca]")) {
        opcao.classList.toggle("hidden", !categoriaCombinaComBusca((opcao.dataset.busca ?? "").split("|"), texto));
      }
      const visivel = (el: HTMLElement) => !el.hidden && !el.classList.contains("hidden");
      for (const grupo of form.querySelectorAll<HTMLElement>("[data-grupo-categoria]")) {
        grupo.hidden = ![...grupo.querySelectorAll<HTMLElement>("[data-busca]")].some(visivel);
      }
      for (const vazio of form.querySelectorAll<HTMLElement>("[data-sem-categoria]")) {
        vazio.hidden = [...(vazio.parentElement?.querySelectorAll<HTMLElement>("[data-grupo-categoria]") ?? [])].some((g) => !g.hidden);
      }
      const principal = form.querySelector<HTMLInputElement>('input[name="categoriaPrincipalId"]:checked:not(:disabled)');
      const escolhida = form.querySelector<HTMLElement>("[data-categoria-escolhida]");
      if (escolhida) escolhida.textContent = principal ? `Escolhida: ${principal.parentElement?.textContent?.trim() ?? ""}` : "Nenhuma escolhida ainda.";
      mostrarFormaProfissao(principal);
    };

    // Forma da profissão: só com a categoria principal que tem as duas formas.
    // Desligada, não vai no envio, e o anúncio mostra o nome da categoria.
    const blocoForma = form.querySelector<HTMLElement>("[data-forma-profissao]");
    const mostrarFormaProfissao = (principal: HTMLInputElement | null) => {
      if (!blocoForma) return;
      const formas = { feminino: principal?.dataset.formaFeminino, masculino: principal?.dataset.formaMasculino };
      const temFormas = Boolean(formas.feminino && formas.masculino);
      blocoForma.hidden = !temFormas;
      for (const rotulo of blocoForma.querySelectorAll<HTMLElement>("[data-rotulo-forma]")) {
        rotulo.textContent = formas[rotulo.dataset.rotuloForma as keyof typeof formas] ?? "";
      }
      for (const opcao of blocoForma.querySelectorAll<HTMLInputElement>("input")) opcao.disabled = !temFormas;
    };
    busca?.addEventListener("input", filtrarCategorias);
    // Enter na busca não envia o formulário.
    busca?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") e.preventDefault();
    });
    const escolhido = () => form.querySelector<HTMLInputElement>('input[name="tipo"]:checked')?.value ?? form.dataset.tipoFixo ?? "";
    const ligar = (el: HTMLElement, ligado: boolean) => {
      el.hidden = !ligado;
      for (const campo of el.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea")) campo.disabled = !ligado;
    };

    // Mesmo texto de textoValorPlano (no servidor), com os valores calculados lá.
    const reais = (centavos: number) => (centavos / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
    const mostrarValor = () => {
      const op = form.querySelector<HTMLSelectElement>('select[name="planoEscolhidoId"]')?.selectedOptions[0];
      const periodicidade = form.querySelector<HTMLInputElement>('input[name="periodicidade"]:checked')?.value;
      const valor = form.querySelector<HTMLElement>("[data-valor-plano]");
      const fundador = form.querySelector<HTMLElement>("[data-valor-fundador]");
      if (!valor || !fundador) return;
      valor.textContent = "";
      fundador.textContent = "";
      if (!op?.value || op.disabled) return;
      const mensal = Number(op.dataset.mensal);
      if (mensal === 0) {
        valor.textContent = "Grátis";
      } else if (periodicidade === "mensal") {
        valor.textContent = `${reais(mensal)} por mês`;
      } else {
        valor.textContent = `${reais(Number(op.dataset.anual))} por ano`;
        if (op.dataset.anualFundador) fundador.textContent = `Fundador: ${reais(Number(op.dataset.anualFundador))} no 1º ano`;
      }
    };

    // Horário: as horas de um dia fechado ficam desligadas (não vão no envio).
    const atualizarHorario = () => {
      for (const dia of form.querySelectorAll<HTMLElement>("[data-dia-horario]")) {
        const aberto = dia.querySelector<HTMLInputElement>("[data-dia-aberto]")?.checked ?? false;
        for (const hora of dia.querySelectorAll<HTMLInputElement>('input[type="time"]')) hora.disabled = !aberto;
      }
    };
    form.querySelector("[data-copiar-segunda]")?.addEventListener("click", () => {
      const horas = (dia: Element) => [...dia.querySelectorAll<HTMLInputElement>('input[type="time"]')];
      const segunda = form.querySelector('[data-dia-horario="1"]');
      if (!segunda) return;
      const modelo = horas(segunda).map((h) => h.value);
      for (const dia of form.querySelectorAll<HTMLElement>("[data-dia-horario]")) {
        if (dia === segunda || !dia.querySelector<HTMLInputElement>("[data-dia-aberto]")?.checked) continue;
        horas(dia).forEach((h, i) => (h.value = modelo[i] ?? ""));
      }
    });

    const atualizar = () => {
      const tipo = escolhido();
      for (const bloco of form.querySelectorAll<HTMLElement>("[data-so]")) ligar(bloco, bloco.dataset.so === tipo);
      for (const texto of form.querySelectorAll<HTMLElement>("[data-so-texto]")) texto.hidden = !!tipo && texto.dataset.soTexto !== tipo;
      // Antes de escolher o tipo, só o primeiro título aparece.
      if (!tipo) form.querySelectorAll<HTMLElement>("[data-so-texto]").forEach((t, i) => (t.hidden = i > 0));
      atualizarHorario();
      // Categorias e planos só do tipo escolhido.
      for (const el of form.querySelectorAll<HTMLElement>("[data-tipo-categoria]")) {
        ligar(el, !tipo || el.dataset.tipoCategoria === "ambos" || el.dataset.tipoCategoria === tipo);
      }
      filtrarCategorias();
      for (const op of form.querySelectorAll<HTMLOptionElement>("[data-tipo-plano]")) op.hidden = op.disabled = !!tipo && op.dataset.tipoPlano !== tipo;
      // Comércio começa no Gratuito; autônomo escolhe. Plano de outro tipo não fica marcado.
      const plano = form.querySelector<HTMLSelectElement>('select[name="planoEscolhidoId"]');
      if (plano && (plano.value === "" || plano.selectedOptions[0]?.disabled)) {
        const gratuito = plano.querySelector<HTMLOptionElement>("option[data-gratuito]");
        if (tipo === "comercio" && gratuito) gratuito.selected = true;
        else plano.value = "";
      }
      for (const marca of form.querySelectorAll<HTMLInputElement>("[data-esconde-bairros]")) {
        const caixa = form.querySelector<HTMLElement>(`[data-bairros="${marca.dataset.escondeBairros}"]`);
        if (caixa && !caixa.closest("[hidden]")) ligar(caixa, !marca.checked);
      }
      const entrega = form.querySelector<HTMLInputElement>("[data-mostra-entrega]");
      const blocoEntrega = form.querySelector<HTMLElement>("[data-entrega]");
      if (entrega && blocoEntrega && tipo === "comercio") {
        ligar(blocoEntrega, entrega.checked);
        const todaCidade = form.querySelector<HTMLInputElement>('[data-esconde-bairros="entrega"]');
        const caixa = form.querySelector<HTMLElement>('[data-bairros="entrega"]');
        if (entrega.checked && todaCidade && caixa) ligar(caixa, !todaCidade.checked);
      }
      mostrarValor();
    };
    form.addEventListener("change", atualizar);
    atualizar();
  }
</script>
