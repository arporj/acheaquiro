---
// Fotos do perfil no cadastro (administração e representante, antes de o
// anunciante assumir): foto de perfil, capa e galeria. Escolhida a foto, a
// pessoa ajusta o enquadramento e vê a prévia no celular e no computador
// (AjusteDaFoto.astro); a foto é preparada no navegador (fotoNavegador.ts: três
// versões em JPEG do recorte, sem a localização) e vai
// para /api/fotos, que confere o tipo, o tamanho, o limite do plano e a
// permissão (RLS) de novo. Tamanhos recomendados em MEDIDAS_FOTO.
import { Modal, classesBotao } from "@acheaqui/ui";
import { MEDIDAS_FOTO } from "@acheaqui/validation";
import AjusteDaFoto from "@/components/fotos/AjusteDaFoto.astro";
import type { FotoDoCadastro, FotosDoCadastro } from "@/lib/fotos";

interface Props {
  anuncianteId: string;
  /** Nome do anunciante, para a prévia do topo do perfil. */
  nome: string;
  tipo: "profissional" | "comercio";
  fotos: FotosDoCadastro;
}

const { anuncianteId, nome, tipo, fotos } = Astro.props;
const galeriaCheia = fotos.galeria.length >= fotos.limiteGaleria;
const secao = "mt-6 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5";
const subtitulo = "font-display text-base font-bold text-azul-900";
const orientacao = "mt-1 text-sm text-slate-600";
// O campo de arquivo fica escondido dentro do rótulo: o foco e o desligado aparecem no botão.
const botaoEscolher = classesBotao(
  "azul",
  "m",
  "cursor-pointer has-[:disabled]:pointer-events-none has-[:disabled]:opacity-50 has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-azul-500",
);
const fotosUnicas: { finalidade: "perfil" | "capa"; titulo: string; foto: FotoDoCadastro | null; moldura: string }[] = [
  {
    finalidade: "perfil",
    titulo: "Foto de perfil",
    foto: fotos.perfil,
    moldura: `size-28 shrink-0 ${tipo === "profissional" ? "rounded-full" : "rounded-2xl"}`,
  },
  { finalidade: "capa", titulo: "Foto de capa", foto: fotos.capa, moldura: "aspect-[4/1] w-full rounded-2xl" },
];
---

<section id="fotos" class={secao} data-fotos-perfil data-anunciante={anuncianteId}>
  <h2 class="font-display text-lg font-bold text-azul-900">Fotos</h2>
  <p class="mt-1 text-sm text-slate-600">
    Qualquer foto do celular serve (JPG, PNG, WebP). Depois de escolher, você ajusta o enquadramento e vê como fica no celular e no computador; o
    site reduz a foto e tira a localização antes de enviar. As alterações aparecem no site na hora.
  </p>
  <p data-mensagem-fotos role="status" aria-live="polite" class="mt-3 hidden rounded-2xl p-3 text-sm font-semibold"></p>

  <!-- Perfil numa coluna estreita e fixa; a capa ocupa o resto (com "auto", o texto do perfil espremia a capa). -->
  <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-[16rem_minmax(0,1fr)] md:gap-8">
    {
      fotosUnicas.map((f) => (
        <div data-bloco-foto={f.finalidade}>
          <h3 class={subtitulo}>{f.titulo}</h3>
          <p class={orientacao}>{MEDIDAS_FOTO[f.finalidade].orientacao}</p>
          <div class={`mt-3 overflow-hidden bg-fundo ring-1 ring-black/5 ${f.moldura}`}>
            {f.foto ? (
              <img src={f.foto.url} alt={f.titulo} class="size-full object-cover" loading="lazy" decoding="async" />
            ) : (
              <p class="grid size-full place-items-center p-2 text-center text-xs text-slate-500">Sem foto</p>
            )}
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <label class={botaoEscolher}>
              {f.foto ? "Trocar foto" : "Escolher foto"}
              <input type="file" accept="image/*" class="sr-only" data-escolher-foto={f.finalidade} />
            </label>
            {f.foto && (
              <button type="button" class={classesBotao("contorno", "m")} data-apagar-foto={f.foto.id} data-descricao={f.titulo.toLowerCase()}>
                Apagar
              </button>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-8" data-bloco-foto="galeria">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class={subtitulo}>{tipo === "profissional" ? "Fotos dos trabalhos" : "Fotos do espaço"}</h3>
      <p class="text-sm font-bold text-slate-600">
        {fotos.galeria.length} de {fotos.limiteGaleria} no plano
      </p>
    </div>
    <p class={orientacao}>{MEDIDAS_FOTO.galeria.orientacao}</p>
    {
      fotos.limiteGaleria === 0 && (
        <p class="mt-2 text-sm text-slate-600">O plano não inclui fotos na galeria. A foto de perfil e a capa valem para todos os planos.</p>
      )
    }
    {
      fotos.galeria.length > fotos.limiteGaleria && fotos.limiteGaleria > 0 && (
        <p class="mt-2 text-sm text-slate-600">
          O site mostra só as {fotos.limiteGaleria} primeiras; as outras ficam guardadas e voltam se o plano aumentar.
        </p>
      )
    }
    {
      fotos.galeria.length > 0 && (
        <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {fotos.galeria.map((foto, i) => (
            <li class="overflow-hidden rounded-2xl bg-fundo ring-1 ring-black/5">
              {/* Inteira, como foi enviada: o folheto em pé ou deitado não aparece cortado aqui. */}
              <img src={foto.url} alt={foto.legenda ?? `Foto ${i + 1}`} class="aspect-square w-full object-contain" loading="lazy" decoding="async" />
              <div class="flex items-start justify-between gap-2 p-2">
                <p class="line-clamp-2 min-w-0 text-xs text-slate-600">{foto.legenda ?? "Sem descrição"}</p>
                <button
                  type="button"
                  class="min-h-11 shrink-0 rounded-full px-3 text-sm font-bold text-vermelho-700 hover:bg-vermelho-500/10"
                  data-apagar-foto={foto.id}
                  data-descricao={`a foto ${i + 1} da galeria`}
                >
                  Apagar
                </button>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    {
      fotos.limiteGaleria > 0 && (
        <div class="mt-4">
          {/* A descrição é pedida no ajuste, depois de escolher a foto (decisão de 26/11/2026). */}
          <label class={botaoEscolher}>
            Adicionar foto
            <input type="file" accept="image/*" class="sr-only" data-escolher-foto="galeria" disabled={galeriaCheia} />
          </label>
        </div>
      )
    }
    {galeriaCheia && fotos.limiteGaleria > 0 && <p class="mt-2 text-sm text-slate-600">A galeria está cheia: apague uma foto para enviar outra.</p>}
  </div>

</section>

<AjusteDaFoto nome={nome} tipo={tipo} urlPerfil={fotos.perfil?.url} urlCapa={fotos.capa?.url} />

<Modal id="modal-apagar-foto" titulo="Apagar foto">
  <p class="text-sm text-slate-600">
    Apagar <span data-descricao-apagar>esta foto</span>? Ela sai do site na hora e não volta: para usar de novo, será preciso enviar a foto outra vez.
  </p>
  <div class="mt-5 flex gap-2">
    <button type="button" data-modal-fechar class={classesBotao("contorno", "m", "flex-1")}>Cancelar</button>
    <button type="button" data-confirmar-apagar class={classesBotao("perigo", "m", "flex-1")}>Apagar</button>
  </div>
</Modal>

<script>
  import type { FinalidadeFotoPerfil } from "@acheaqui/validation";
  import { ajustarFoto, type FotoAjustada } from "@/lib/ajusteFotoNavegador";

  const secao = document.querySelector<HTMLElement>("[data-fotos-perfil]");
  const modal = document.querySelector<HTMLDialogElement>("#modal-apagar-foto");

  if (secao && modal) {
    const anuncianteId = secao.dataset.anunciante ?? "";
    const mensagem = secao.querySelector<HTMLElement>("[data-mensagem-fotos]")!;
    const controles = () => [...secao.querySelectorAll<HTMLInputElement | HTMLButtonElement>("input, button"), ...modal.querySelectorAll("button")];
    let idParaApagar = "";

    const mostrar = (texto: string, tipo: "erro" | "info") => {
      mensagem.textContent = texto;
      mensagem.classList.remove("hidden", "bg-vermelho-500/10", "text-vermelho-700", "bg-azul-50", "text-azul-900");
      mensagem.classList.add(...(tipo === "erro" ? ["bg-vermelho-500/10", "text-vermelho-700"] : ["bg-azul-50", "text-azul-900"]));
      mensagem.setAttribute("role", tipo === "erro" ? "alert" : "status");
    };
    // Enquanto envia ou apaga, nada mais é clicável (sem envio repetido).
    const ocupar = (ocupado: boolean) => {
      for (const c of controles()) {
        if (ocupado) {
          c.dataset.estavaDesligado = c.disabled ? "sim" : "";
          c.disabled = true;
        } else {
          c.disabled = c.dataset.estavaDesligado === "sim";
        }
      }
    };
    // Volta para a mesma página, no quadro de fotos, com o aviso do servidor.
    const recarregar = (aviso: string) => {
      const url = new URL(location.href);
      url.searchParams.set("aviso", aviso);
      url.hash = "fotos";
      location.assign(url.toString());
    };
    const textoDoErro = async (resposta: Response) => {
      try {
        const corpo = (await resposta.json()) as { erro?: { mensagem?: string } };
        return corpo.erro?.mensagem ?? "Não foi possível concluir. Tente de novo.";
      } catch (erro) {
        console.error("Fotos: resposta sem JSON", resposta.status, erro);
        return "Não foi possível concluir. Tente de novo.";
      }
    };

    const enviar = async (finalidade: FinalidadeFotoPerfil, foto: FotoAjustada, campo: HTMLInputElement) => {
      ocupar(true);
      mostrar("Enviando a foto…", "info");
      try {
        const dados = new FormData();
        dados.set("anunciante", anuncianteId);
        dados.set("finalidade", finalidade);
        if (finalidade === "galeria") dados.set("legenda", foto.legenda);
        for (const [tamanho, arquivo] of foto.versoes) dados.set(`foto_${tamanho}`, arquivo);
        const resposta = await fetch("/api/fotos", { method: "POST", body: dados });
        if (resposta.ok) return recarregar("foto");
        mostrar(await textoDoErro(resposta), "erro");
      } catch (erro) {
        console.error("Fotos: envio falhou", erro);
        mostrar("Sem conexão com o site. Confira a internet e tente de novo.", "erro");
      }
      campo.value = "";
      ocupar(false);
    };

    for (const campo of secao.querySelectorAll<HTMLInputElement>("[data-escolher-foto]")) {
      campo.addEventListener("change", async () => {
        const arquivo = campo.files?.[0];
        if (!arquivo) return;
        const finalidade = campo.dataset.escolherFoto as FinalidadeFotoPerfil;
        mensagem.classList.add("hidden");
        let foto: FotoAjustada | null;
        try {
          foto = await ajustarFoto(arquivo, finalidade);
        } catch (erro) {
          console.error("Fotos: ajuste falhou", erro);
          mostrar(erro instanceof Error && erro.message ? erro.message : "Não foi possível ler esta imagem.", "erro");
          campo.value = "";
          return;
        }
        // Cancelou o ajuste: nada muda.
        if (!foto) {
          campo.value = "";
          return;
        }
        await enviar(finalidade, foto, campo);
      });
    }

    for (const botao of secao.querySelectorAll<HTMLButtonElement>("[data-apagar-foto]")) {
      botao.addEventListener("click", () => {
        idParaApagar = botao.dataset.apagarFoto ?? "";
        const descricao = modal.querySelector<HTMLElement>("[data-descricao-apagar]");
        if (descricao) descricao.textContent = botao.dataset.descricao ?? "esta foto";
        modal.showModal();
      });
    }

    modal.querySelector<HTMLButtonElement>("[data-confirmar-apagar]")?.addEventListener("click", async (evento) => {
      const confirmar = evento.currentTarget as HTMLButtonElement;
      if (!idParaApagar) return;
      ocupar(true);
      confirmar.textContent = "Apagando…";
      try {
        const resposta = await fetch(`/api/fotos?id=${encodeURIComponent(idParaApagar)}`, { method: "DELETE" });
        if (resposta.ok) return recarregar("foto-apagada");
        modal.close();
        mostrar(await textoDoErro(resposta), "erro");
      } catch (erro) {
        console.error("Fotos: exclusão falhou", erro);
        modal.close();
        mostrar("Sem conexão com o site. Confira a internet e tente de novo.", "erro");
      }
      confirmar.textContent = "Apagar";
      ocupar(false);
    });
  }
</script>
