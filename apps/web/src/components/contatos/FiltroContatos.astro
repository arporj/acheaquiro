---
// Filtro da lista de contatos (área do representante e administração): período,
// busca pelo nome do comércio, etapa e, só na administração, a pessoa.
import { Icone, classesBotao } from "@acheaqui/ui";
import { classesCampo, classesRotulo } from "@/components/conta/estilos";
import { ROTULO_ETAPA, type EtapaContato, type FiltroContatos } from "@/lib/contatos";

interface Props {
  filtro: FiltroContatos;
  /** Endereço da página, para o "Limpar". */
  limpar: string;
  /** Só na administração: quem pode ser escolhido no filtro. */
  pessoas?: { id: string; nome: string }[];
}

const { filtro, limpar, pessoas } = Astro.props;
const etapas = Object.entries(ROTULO_ETAPA) as [EtapaContato, string][];
---

<form method="get" role="search" class="mt-5 grid gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5 sm:grid-cols-2 lg:grid-cols-6 lg:items-end">
  <div>
    <label class={classesRotulo} for="filtro-de">De</label>
    <input id="filtro-de" name="de" type="date" value={filtro.inicio} max={filtro.fim} class={classesCampo} />
  </div>
  <div>
    <label class={classesRotulo} for="filtro-ate">Até</label>
    <input id="filtro-ate" name="ate" type="date" value={filtro.fim} class={classesCampo} />
  </div>
  <div class="lg:col-span-2">
    <label class={classesRotulo} for="filtro-q">Comércio</label>
    <input id="filtro-q" name="q" type="search" value={filtro.busca} maxlength="80" placeholder="Nome do comércio ou profissional" class={classesCampo} />
  </div>
  <div>
    <label class={classesRotulo} for="filtro-etapa">Etapa</label>
    <select id="filtro-etapa" name="etapa" class={classesCampo}>
      <option value="">Todas</option>
      {etapas.map(([valor, rotulo]) => <option value={valor} selected={filtro.etapa === valor}>{rotulo}</option>)}
    </select>
  </div>
  {
    pessoas && (
      <div>
        <label class={classesRotulo} for="filtro-autor">Quem registrou</label>
        <select id="filtro-autor" name="autor" class={classesCampo}>
          <option value="">Todos</option>
          {pessoas.map((p) => <option value={p.id} selected={filtro.autorId === p.id}>{p.nome}</option>)}
        </select>
      </div>
    )
  }
  <div class="flex flex-wrap gap-2 sm:col-span-2 lg:col-span-6">
    <button type="submit" class={classesBotao("azul", "m")}>
      <Icone nome="filtro" class="size-4" />
      Filtrar
    </button>
    <a href={limpar} class={classesBotao("contorno", "m")}>Limpar</a>
  </div>
</form>
