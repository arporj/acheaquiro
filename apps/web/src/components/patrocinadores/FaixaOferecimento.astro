---
// Faixa "Parceiros do Ache Aqui" no fim de todas as páginas (antiga "Oferecimento",
// nome trocado em 26/11/2026 porque era confundido com anúncio).
// No computador, três colunas da mesma largura: o Master, os Ouro um embaixo
// do outro e os de Apoio dois por linha, todos visíveis, sem revezamento. No
// celular, as três partes ficam uma embaixo da outra, na mesma ordem, com o
// Master mais estreito para não ocupar a tela inteira.
// Cada vaga sem parceiro é um quadro tracejado no tamanho do logo da cota, com
// o preço dentro (decisão de 27/11/2026, no lugar da linha única sem parceiros
// e do convite por cota): 1 Master, 3 Ouro e 6 Apoio com o rodapé vazio.
// Quantos quadros, em quadrosLivresNoRodape (packages/domain); cota esgotada
// não tem quadro.
import type { CotaPatrocinio } from "@acheaqui/types";
import { quadrosLivresNoRodape, valorDoPatrocinio } from "@acheaqui/domain";
import CartaoPatrocinador from "./CartaoPatrocinador.astro";
import { hojeNaCidade, listarCotasPatrocinio, listarPatrocinadores, obterRegrasCobranca } from "@/dados/consultas";
import { linkConvitePatrocinio } from "@/lib/convitePatrocinio";
import { formatarCentavos } from "@/lib/precos";

const [todos, cotas, regras] = await Promise.all([listarPatrocinadores(), listarCotasPatrocinio(), obterRegrasCobranca()]);
const hoje = hojeNaCidade();
const coluna = (cota: CotaPatrocinio, titulo: string, grade: string) => {
  const itens = todos.filter((p) => p.cota === cota);
  const daCota = cotas.find((c) => c.cota === cota);
  const vagas = daCota
    ? Array.from({ length: quadrosLivresNoRodape(daCota, itens.length) }, () => ({
        ...valorDoPatrocinio(daCota, hoje, regras.prazoFundador),
        formato: daCota.formatoLogo,
      }))
    : [];
  return { cota, titulo, grade, itens, vagas };
};
const colunas = [
  coluna("master", "Master", "grid-cols-1 max-md:mx-auto max-md:w-3/5"),
  coluna("ouro", "Ouro", "grid-cols-1"),
  coluna("apoio", "Apoio", "grid-cols-2"),
].filter((c) => c.itens.length > 0 || c.vagas.length > 0);
---

{
  colunas.length > 0 && (
    <section aria-labelledby="parceiros-rodape" class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="parceiros-rodape" class="text-xs font-extrabold tracking-[0.2em] text-slate-500 uppercase">
            Parceiros do Ache Aqui
          </h2>
          <span class="flex gap-4 text-sm font-bold">
            {todos.length > 0 && (
              <a href="/parceiros" class="text-azul-600 hover:underline">
                Conheça os parceiros
              </a>
            )}
            <a href="/seja-parceiro" class="text-azul-600 hover:underline">
              Seja parceiro
            </a>
          </span>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {colunas.map((coluna) => (
            <div>
              <h3 class="mb-2 text-[0.7rem] font-bold tracking-widest text-slate-400 uppercase">{coluna.titulo}</h3>
              <div class={`grid gap-3 ${coluna.grade}`}>
                {coluna.itens.map((p) => (
                  <CartaoPatrocinador patrocinador={p} />
                ))}
                {coluna.vagas.map((vaga) => (
                  <a
                    href={linkConvitePatrocinio(coluna.cota)}
                    aria-label={`Vaga livre na cota ${coluna.titulo}: ${formatarCentavos(vaga.valorCentavos)} por 12 meses${vaga.precoFundador ? ", preço de Parceiro Fundador" : ""}. Seja parceiro`}
                    class="flex flex-col items-center justify-center gap-0.5 rounded-xl border-2 border-dashed border-slate-300 p-2 text-center leading-tight transition hover:border-azul-400 hover:bg-azul-50"
                    style={`aspect-ratio: ${vaga.formato.largura} / ${vaga.formato.altura}`}
                  >
                    <span class="text-[0.65rem] font-bold tracking-wider text-slate-500 uppercase">Vaga livre</span>
                    <span class={`font-display font-extrabold text-azul-900 ${coluna.cota === "apoio" ? "text-sm" : "text-lg"}`}>
                      {formatarCentavos(vaga.valorCentavos)}
                    </span>
                    <span class="text-[0.7rem] text-slate-500">
                      por 12 meses{vaga.precoFundador ? " · Parceiro Fundador" : ""}
                    </span>
                    {coluna.cota === "master" && <span class="mt-2 text-sm font-bold text-azul-700">Seja parceiro</span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
