---
// Faixa "Oferecimento" no fim de todas as páginas (proposta Patrocinadores v3).
// No computador, três colunas da mesma largura: o Master, os Ouro um embaixo
// do outro e os de Apoio dois por linha, todos visíveis, sem revezamento. No
// celular, as três partes ficam uma embaixo da outra, na mesma ordem, com o
// Master mais estreito para não ocupar a tela inteira.
// Cada coluna com vaga termina num convite "Quer seu nome aqui?", um por
// cota e não por vaga (decisão de 29/10/2026); cota esgotada não convida. Só
// aparece com algum patrocinador ou convite nessas três cotas.
import type { CotaPatrocinio } from "@acheaqui/types";
import { mostraConvitePatrocinio } from "@acheaqui/domain";
import CartaoPatrocinador from "./CartaoPatrocinador.astro";
import { listarCotasPatrocinio, listarPatrocinadores } from "@/dados/consultas";
import { TEXTO_CONVITE, linkConvitePatrocinio } from "@/lib/convitePatrocinio";

const [todos, cotas] = await Promise.all([listarPatrocinadores(), listarCotasPatrocinio()]);
const coluna = (cota: CotaPatrocinio, titulo: string, grade: string) => {
  const itens = todos.filter((p) => p.cota === cota);
  const daCota = cotas.find((c) => c.cota === cota);
  const convite = mostraConvitePatrocinio(daCota, daCota !== undefined && itens.length >= daCota.vagasTotais) ? daCota : undefined;
  return { cota, titulo, grade, itens, convite };
};
const colunas = [
  coluna("master", "Master", "grid-cols-1 max-md:mx-auto max-md:w-3/5"),
  coluna("ouro", "Ouro", "grid-cols-1"),
  coluna("apoio", "Apoio", "grid-cols-2"),
].filter((c) => c.itens.length > 0 || c.convite);
---

{
  colunas.length > 0 && (
    <section aria-labelledby="oferecimento" class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="oferecimento" class="text-xs font-extrabold tracking-[0.2em] text-slate-500 uppercase">
            Oferecimento
          </h2>
          <span class="flex gap-4 text-sm font-bold">
            {todos.length > 0 && <a href="/patrocinadores" class="text-azul-600 hover:underline">Conheça os patrocinadores</a>}
            <a href="/patrocine" class="text-azul-600 hover:underline">Patrocine</a>
          </span>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {colunas.map((coluna) => (
            <div>
              <h3 class="mb-2 text-[0.7rem] font-bold tracking-widest text-slate-400 uppercase">{coluna.titulo}</h3>
              <div class={`grid gap-3 ${coluna.grade}`}>
                {coluna.itens.map((p) => (
                  <CartaoPatrocinador patrocinador={p} />
                ))}
                {coluna.convite && (
                  <a
                    href={linkConvitePatrocinio(coluna.cota)}
                    class={`grid place-items-center rounded-xl border-2 border-dashed border-slate-300 p-2 text-center text-xs font-bold text-azul-700 transition hover:border-azul-400 hover:bg-azul-50 ${
                      coluna.cota === "master" ? "md:w-3/5" : ""
                    }`}
                    style={`aspect-ratio: ${coluna.convite.formatoLogo.largura} / ${coluna.convite.formatoLogo.altura}`}
                  >
                    {TEXTO_CONVITE}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
