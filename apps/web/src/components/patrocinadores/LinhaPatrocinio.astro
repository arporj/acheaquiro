---
// "patrocinado por ..." ao lado do grupo e da categoria. Só o nome do
// patrocinador é link. Não muda a ordem da lista nem ocupa o topo.
import type { Patrocinador } from "@acheaqui/types";

interface Props {
  patrocinador: Patrocinador;
}

const { patrocinador } = Astro.props;
---

<span class="text-xs font-semibold text-slate-500">
  patrocinado por{" "}
  <a href={`/patrocinadores#${patrocinador.slug}`} class="font-bold text-azul-700 hover:underline">{patrocinador.nome}</a>
</span>
