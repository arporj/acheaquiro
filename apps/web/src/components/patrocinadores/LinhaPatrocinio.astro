---
// "com apoio de ..." ao lado do grupo e da categoria (antigo "patrocinado por",
// trocado em 26/11/2026). Só o nome do parceiro é link. Não muda a ordem da
// lista nem ocupa o topo.
import type { Patrocinador } from "@acheaqui/types";

interface Props {
  patrocinador: Patrocinador;
}

const { patrocinador } = Astro.props;
---

<span class="text-xs font-semibold text-slate-500">
  com apoio de{" "}
  <a href={`/parceiros#${patrocinador.slug}`} class="font-bold text-azul-700 hover:underline">{patrocinador.nome}</a>
</span>
