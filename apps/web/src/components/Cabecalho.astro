---
import { Icone, classesBotao } from "@acheaqui/ui";
import { temPatrocinioDisponivel } from "@/dados/consultas";
import { ambiente } from "@/lib/ambiente";
import FormBusca from "./FormBusca.astro";
import Logo from "./Logo.astro";

interface Props {
  comBusca?: boolean;
}

const { comBusca = false } = Astro.props;
// "Patrocine" no cabeçalho enquanto Master, Ouro ou Apoio tiver vaga (decisão de 23/10/2026).
const patrocinioDisponivel = await temPatrocinioDisponivel();

// Uma lista só para o computador e para o menu do celular (decisão de 23/10/2026).
// Os links ficam na barra a partir de 1024 px (lg); abaixo disso, no menu, que
// aparece até essa mesma largura (antes, entre 768 e 1023 px, a barra não cabia
// e "Artistas" ficava sem acesso).
const links = [
  { href: "/#categorias", rotulo: "Categorias" },
  // Agenda e Artistas: por enquanto só no site de apresentação (módulo de eventos).
  ...(ambiente === "apresentacao"
    ? [
        { href: "/agenda", rotulo: "Agenda" },
        { href: "/artistas", rotulo: "Artistas" },
      ]
    : []),
  { href: "/sobre", rotulo: "Como funciona" },
  { href: "/fundadores", rotulo: "Fundadores" },
  // Entrada de anunciantes, representantes e equipe (decisão de 22/10/2026). O site de apresentação não tem login.
  ...(ambiente === "producao" ? [{ href: "/entrar", rotulo: "Entrar" }] : []),
];
---

<header class="fundo-raios text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 lg:py-4">
    <Logo reduzidaNoCelular />
    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hidden rounded-full px-3 py-2 text-sm font-bold whitespace-nowrap text-white/90 hover:bg-white/10 lg:inline-flex xl:px-4"
          >
            {l.rotulo}
          </a>
        ))
      }
      {/* Abaixo de 1024 px, "Patrocine" fica só no menu, para a logo completa caber (decisão M1 de 30/10/2026). */}
      {
        patrocinioDisponivel && (
          <a
            href="/patrocine"
            class="hidden items-center gap-1.5 rounded-full border-2 border-amarelo-400 px-4 py-1.5 text-sm font-bold text-amarelo-400 hover:bg-amarelo-400 hover:text-azul-900 lg:inline-flex"
          >
            <Icone nome="estrela" class="size-4" />
            Patrocine
          </a>
        )
      }
      <a href="/anuncie" class={classesBotao("amarelo", "p", "shadow-none")}>
        <Icone nome="megafone" class="size-4" />
        <span class="whitespace-nowrap max-[359px]:hidden">Anuncie aqui</span>
        <span class="min-[360px]:hidden">Anuncie</span>
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-white/10 lg:hidden"
        aria-label="Abrir o menu"
        aria-expanded="false"
        aria-controls="menu-celular"
        data-menu-celular
      >
        <Icone nome="menu" class="size-6" data-icone-abrir />
        <Icone nome="fechar" class="hidden size-6" data-icone-fechar />
      </button>
    </nav>
  </div>
  <nav id="menu-celular" class="hidden border-t border-white/15 lg:hidden" aria-label="Menu">
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-xl px-3 py-3 font-bold text-white/90 hover:bg-white/10">
              {l.rotulo}
            </a>
          </li>
        ))
      }
      {
        patrocinioDisponivel && (
          <li>
            <a href="/patrocine" class="block rounded-xl px-3 py-3 font-bold text-amarelo-400 hover:bg-white/10">
              Patrocine
            </a>
          </li>
        )
      }
    </ul>
  </nav>
  {
    comBusca && (
      <div class="mx-auto max-w-6xl px-4 pb-3 lg:pb-4">
        <FormBusca />
      </div>
    )
  }
</header>

<script>
  // Abre e fecha o menu do celular. Clicar num link (inclusive /#categorias,
  // na mesma página) fecha o menu.
  const botao = document.querySelector<HTMLButtonElement>("[data-menu-celular]");
  const menu = document.getElementById("menu-celular");
  if (botao && menu) {
    const alternar = (aberto: boolean) => {
      menu.classList.toggle("hidden", !aberto);
      botao.setAttribute("aria-expanded", String(aberto));
      botao.setAttribute("aria-label", aberto ? "Fechar o menu" : "Abrir o menu");
      botao.querySelector("[data-icone-abrir]")?.classList.toggle("hidden", aberto);
      botao.querySelector("[data-icone-fechar]")?.classList.toggle("hidden", !aberto);
    };
    botao.addEventListener("click", () => alternar(menu.classList.contains("hidden")));
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) alternar(false);
    });
  }
</script>
