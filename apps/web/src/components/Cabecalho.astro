---
import { Icone, classesBotao } from "@acheaqui/ui";
import FormBusca from "./FormBusca.astro";
import Logo from "./Logo.astro";

interface Props {
  comBusca?: boolean;
}

const { comBusca = false } = Astro.props;
---

<header class="fundo-raios text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 lg:py-4">
    <Logo />
    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Principal">
      <a href="/#categorias" class="hidden rounded-full px-4 py-2 text-sm font-bold text-white/90 hover:bg-white/10 md:inline-flex">
        Categorias
      </a>
      <a href="/sobre" class="hidden rounded-full px-4 py-2 text-sm font-bold text-white/90 hover:bg-white/10 md:inline-flex">
        Como funciona
      </a>
      <a href="/fundadores" class="hidden rounded-full px-4 py-2 text-sm font-bold text-white/90 hover:bg-white/10 md:inline-flex">
        Fundadores
      </a>
      <a href="/anuncie" class={classesBotao("amarelo", "p", "shadow-none")}>
        <Icone nome="megafone" class="size-4" />
        Anuncie aqui
      </a>
    </nav>
  </div>
  {
    comBusca && (
      <div class="mx-auto max-w-6xl px-4 pb-3 lg:pb-4">
        <FormBusca />
      </div>
    )
  }
</header>
