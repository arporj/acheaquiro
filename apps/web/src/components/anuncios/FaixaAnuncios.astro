---
// Versão escolhida no protótipo (B): faixas completas na página inicial e
// compactas, em uma linha, nos resultados e nos perfis.
import { FotoMarcador, Icone, Selo } from "@acheaqui/ui";
import type { ItemResultado } from "@/dados/consultas";

type Destaque = { item: ItemResultado; descricao: string; bairro: string };

interface Props {
  pagina: "inicial" | "interna";
  destaque?: Destaque;
  superDestaques: ItemResultado[];
}

const { pagina, destaque, superDestaques } = Astro.props;
const compacta = pagina === "interna";
// O carrossel repete a lista para o giro contínuo; a cópia fica fora do leitor de tela e do Tab.
const copias = [0, 1];
---

<section aria-label="Anunciantes em destaque" class={compacta ? "bg-white pb-2 shadow-sm" : "pb-2"}>
  {
    destaque && !compacta && (
      <div class="mx-auto max-w-6xl px-4 pt-4">
        <a
          href={`/perfil/${destaque.item.slug}`}
          class="group relative flex min-h-36 overflow-hidden rounded-3xl bg-white shadow-[0_10px_30px_-12px_rgb(10_34_102/0.35)] ring-3 ring-amarelo-400 transition hover:-translate-y-0.5 sm:min-h-44"
        >
          <FotoMarcador
            foto={destaque.item.foto}
            prioritaria
            icone={destaque.item.icone}
            cor={destaque.item.cor}
            class="w-28 shrink-0 sm:w-64"
            tamanhoIcone="text-5xl sm:text-7xl"
          />
          <div class="flex flex-1 flex-col justify-center gap-1 p-4 sm:p-6">
            <span class="inline-flex w-fit items-center gap-1 rounded-full bg-amarelo-400 px-2.5 py-0.5 text-[0.7rem] font-extrabold uppercase tracking-wide text-azul-900">
              <Icone nome="estrela" class="size-3" fill="currentColor" />
              Destaque exclusivo
            </span>
            <h2 class="font-display text-2xl leading-tight font-extrabold text-azul-900 sm:text-3xl">
              {destaque.item.nome} <Selo selo={destaque.item.selo} class="align-[-0.1em]" />
            </h2>
            <p class="text-sm font-semibold text-slate-600">
              {destaque.item.categoriaNome} · {destaque.bairro}
            </p>
            <p class="mt-1 hidden max-w-xl text-sm text-slate-600 sm:line-clamp-2">{destaque.descricao}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-sm font-extrabold text-azul-600 group-hover:underline">
              Ver perfil <Icone nome="direita" class="size-4" />
            </span>
          </div>
        </a>
      </div>
    )
  }
  {
    destaque && compacta && (
      <div class="mx-auto max-w-6xl px-4 pt-2">
        <a
          href={`/perfil/${destaque.item.slug}`}
          class="flex items-center gap-3 rounded-2xl bg-amarelo-200/60 px-3 py-1.5 ring-1 ring-amarelo-400 hover:bg-amarelo-200"
        >
          <FotoMarcador foto={destaque.item.foto} icone={destaque.item.icone} cor={destaque.item.cor} class="size-9 shrink-0 rounded-xl" tamanhoIcone="text-lg" />
          <span class="min-w-0 flex-1 truncate text-sm">
            <span class="font-extrabold text-azul-900 uppercase text-[0.7rem] tracking-wide">Destaque exclusivo · </span>
            <span class="font-bold">{destaque.item.nome}</span>
            <span class="text-slate-600"> · {destaque.item.categoriaNome}</span>
          </span>
          <Icone nome="direita" class="size-4 shrink-0 text-azul-700" />
        </a>
      </div>
    )
  }
  {
    superDestaques.length > 0 && !compacta && (
      <div class="pt-4">
        <h2 class="mx-auto max-w-6xl px-4 text-xs font-extrabold tracking-wider text-azul-700 uppercase">Super Destaque</h2>
        <div class="mt-2 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_4%,black_96%,transparent)]">
          <div data-carrossel class="flex w-max animate-carrossel gap-3 py-2 hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]">
            {copias.map((copia) => (
              <ul class="flex gap-3" aria-hidden={copia === 1 ? "true" : undefined}>
                {superDestaques.map((item) => (
                  <li>
                    <a
                      href={`/perfil/${item.slug}`}
                      tabindex={copia === 1 ? -1 : undefined}
                      class="block w-40 overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-lg sm:w-48"
                    >
                      <FotoMarcador foto={item.foto} icone={item.icone} cor={item.cor} class="h-24 w-full sm:h-28" />
                      <div class="p-2.5">
                        <p class="flex items-center gap-1 truncate text-sm font-extrabold text-tinta">
                          <span class="truncate">{item.nome}</span>
                          <Selo selo={item.selo} />
                        </p>
                        <p class="truncate text-xs font-semibold text-slate-500">{item.categoriaNome}</p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>
    )
  }
  {
    superDestaques.length > 0 && compacta && (
      <div class="overflow-hidden pt-2 [mask-image:linear-gradient(90deg,transparent,black_4%,black_96%,transparent)]">
        <div data-carrossel class="flex w-max animate-carrossel gap-2 hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]">
          {copias.map((copia) => (
            <ul class="flex gap-2" aria-hidden={copia === 1 ? "true" : undefined}>
              {superDestaques.map((item) => (
                <li>
                  <a
                    href={`/perfil/${item.slug}`}
                    tabindex={copia === 1 ? -1 : undefined}
                    class="flex h-10 items-center gap-2 rounded-full bg-fundo py-1 pr-4 pl-1 ring-1 ring-azul-100 hover:bg-azul-50"
                  >
                    <FotoMarcador foto={item.foto} icone={item.icone} cor={item.cor} class="size-8 rounded-full" tamanhoIcone="text-base" />
                    <span class="text-sm font-bold whitespace-nowrap">{item.nome}</span>
                    <Selo selo={item.selo} class="text-sm" />
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )
  }
</section>

<script>
  // Super Destaque: a ordem é sorteada a cada visita, com a mesma chance para
  // todos (decisão de 20/10/2026). A página fica em cache, então o sorteio é
  // feito aqui; as duas cópias do carrossel recebem a mesma ordem.
  import { criarAleatorio, embaralhar } from "@acheaqui/domain";

  for (const carrossel of document.querySelectorAll<HTMLElement>("[data-carrossel]")) {
    const listas = [...carrossel.querySelectorAll<HTMLUListElement>(":scope > ul")];
    const quantidade = listas[0]?.children.length ?? 0;
    const [semente] = crypto.getRandomValues(new Uint32Array(1));
    const ordem = embaralhar(
      Array.from({ length: quantidade }, (_, i) => i),
      criarAleatorio(semente ?? 0),
    );
    for (const lista of listas) {
      const itens = [...lista.children];
      if (itens.length !== quantidade) {
        console.error("Carrossel do Super Destaque: as cópias têm quantidades diferentes de anunciantes.");
        continue;
      }
      lista.replaceChildren(...ordem.map((i) => itens[i]!));
    }
  }
</script>
