---
// Versão escolhida no protótipo (B): faixas completas na página inicial e
// compactas, em uma linha, nos resultados e nos perfis. Espaço sem anunciante
// mostra a propaganda do Ache Aqui no mesmo tamanho (src/lib/anunciosDaCasa.ts).
import { FotoMarcador, Icone, IconeCategoria, Selo } from "@acheaqui/ui";
import type { Categoria } from "@acheaqui/types";
import type { ItemResultado } from "@/dados/consultas";
import {
  EXTRA_BANNER,
  EXTRA_CARROSSEL,
  TEXTOS_BANNER_DA_CASA as TEXTO_BANNER,
  TEXTOS_CONVITE_CARROSSEL as TEXTO_CONVITE,
  linkDoExtra,
  type AnunciosDaCasa,
} from "@/lib/anunciosDaCasa";
import { formatarCentavos } from "@/lib/precos";

type Banner = { item: ItemResultado; descricao: string; bairro: string };
type Entrada = { tipo: "anunciante"; item: ItemResultado } | { tipo: "atalho"; categoria: Categoria } | { tipo: "convite" };

interface Props {
  pagina: "inicial" | "interna";
  banner?: Banner;
  carrossel: ItemResultado[];
  casa: AnunciosDaCasa;
}

const { pagina, banner, carrossel, casa } = Astro.props;
const compacta = pagina === "interna";
const bannerDaCasa = !banner ? casa.banner : undefined;
const linkBanner = linkDoExtra(EXTRA_BANNER);
const linkCarrossel = linkDoExtra(EXTRA_CARROSSEL);
const entradas: Entrada[] = [
  ...carrossel.map((item) => ({ tipo: "anunciante" as const, item })),
  ...casa.atalhos.map((categoria) => ({ tipo: "atalho" as const, categoria })),
  ...Array.from({ length: casa.convites }, () => ({ tipo: "convite" as const })),
];
// O carrossel repete a lista para o giro contínuo; a cópia fica fora do leitor de tela e do Tab.
const copias = [0, 1];
// "relative": o texto oculto do selo (sr-only, posição absoluta) fica preso à
// faixa com rolagem; sem isso, escapa dela e alarga a página no celular.
const classeTrilho =
  "relative overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [mask-image:linear-gradient(90deg,transparent,black_4%,black_96%,transparent)]";
const classeSeta =
  "absolute top-1/2 z-10 hidden -translate-y-1/2 place-items-center rounded-full bg-white/95 text-azul-800 shadow-md ring-1 ring-black/10 hover:bg-white md:grid";
---

<section aria-label="Anunciantes em banner" class={compacta ? "bg-white pb-2 shadow-sm" : "pb-2"}>
  {
    banner && !compacta && (
      <div class="mx-auto max-w-6xl px-4 pt-4">
        <a
          href={`/perfil/${banner.item.slug}`}
          class="group relative flex min-h-36 overflow-hidden rounded-3xl bg-white shadow-[0_10px_30px_-12px_rgb(10_34_102/0.35)] ring-3 ring-amarelo-400 transition hover:-translate-y-0.5 sm:min-h-44"
        >
          <FotoMarcador
            foto={banner.item.foto}
            prioritaria
            icone={banner.item.icone}
            cor={banner.item.cor}
            class="w-28 shrink-0 sm:w-64"
            tamanhoIcone="text-5xl sm:text-7xl"
          />
          <div class="flex flex-1 flex-col justify-center gap-1 p-4 sm:p-6">
            <span class="inline-flex w-fit items-center gap-1 rounded-full bg-amarelo-400 px-2.5 py-0.5 text-[0.7rem] font-extrabold uppercase tracking-wide text-azul-900">
              <Icone nome="estrela" class="size-3" fill="currentColor" />
              Anúncio
            </span>
            <h2 class="font-display text-2xl leading-tight font-extrabold text-azul-900 sm:text-3xl">
              {banner.item.nome} <Selo selo={banner.item.selo} class="align-[-0.1em]" />
            </h2>
            <p class="text-sm font-semibold text-slate-600">
              {banner.item.categoriaNome} · {banner.bairro}
            </p>
            <p class="mt-1 hidden max-w-xl text-sm text-slate-600 sm:line-clamp-2">{banner.descricao}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-sm font-extrabold text-azul-600 group-hover:underline">
              Ver perfil <Icone nome="direita" class="size-4" />
            </span>
          </div>
        </a>
      </div>
    )
  }
  {
    bannerDaCasa && !compacta && (
      <div class="mx-auto max-w-6xl px-4 pt-4">
        <a
          href={linkBanner}
          class="group relative flex min-h-36 overflow-hidden rounded-3xl bg-white shadow-[0_10px_30px_-12px_rgb(10_34_102/0.35)] ring-3 ring-amarelo-400 transition hover:-translate-y-0.5 sm:min-h-44"
        >
          <div class="fundo-raios relative grid w-28 shrink-0 place-items-center overflow-hidden sm:w-64">
            <span aria-hidden="true" class="absolute -bottom-10 -left-8 size-32 rounded-full bg-white/10 sm:size-48" />
            <img src="/marca/simbolo-fundo-azul.svg" alt="" width="227" height="267" class="relative h-20 w-auto drop-shadow-md sm:h-32" />
          </div>
          <div class="flex flex-1 flex-col justify-center gap-1 p-4 sm:p-6">
            <span class="inline-flex w-fit items-center gap-1 rounded-full bg-amarelo-400 px-2.5 py-0.5 text-[0.7rem] font-extrabold uppercase tracking-wide text-azul-900">
              <Icone nome="estrela" class="size-3" fill="currentColor" />
              {TEXTO_BANNER.etiqueta}
            </span>
            <h2 class="font-display text-2xl leading-tight font-extrabold text-azul-900 sm:text-3xl">{TEXTO_BANNER.titulo}</h2>
            <p class="text-sm font-semibold text-slate-600">
              {bannerDaCasa.nome}
              {bannerDaCasa.diariaCentavos !== undefined && ` · ${formatarCentavos(bannerDaCasa.diariaCentavos)} por dia`}
            </p>
            <p class="mt-1 hidden max-w-xl text-sm text-slate-600 sm:line-clamp-2">{TEXTO_BANNER.descricao}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-sm font-extrabold text-azul-600 group-hover:underline">
              {TEXTO_BANNER.chamada} <Icone nome="direita" class="size-4" />
            </span>
          </div>
        </a>
      </div>
    )
  }
  {
    banner && compacta && (
      <div class="mx-auto max-w-6xl px-4 pt-2">
        <a
          href={`/perfil/${banner.item.slug}`}
          class="flex items-center gap-3 rounded-2xl bg-amarelo-200/60 px-3 py-1.5 ring-1 ring-amarelo-400 hover:bg-amarelo-200"
        >
          <FotoMarcador foto={banner.item.foto} icone={banner.item.icone} cor={banner.item.cor} class="size-9 shrink-0 rounded-xl" tamanhoIcone="text-lg" />
          <span class="min-w-0 flex-1 truncate text-sm">
            <span class="font-extrabold text-azul-900 uppercase text-[0.7rem] tracking-wide">Anúncio · </span>
            <span class="font-bold">{banner.item.nome}</span>
            <span class="text-slate-600"> · {banner.item.categoriaNome}</span>
          </span>
          <Icone nome="direita" class="size-4 shrink-0 text-azul-700" />
        </a>
      </div>
    )
  }
  {
    bannerDaCasa && compacta && (
      <div class="mx-auto max-w-6xl px-4 pt-2">
        <a href={linkBanner} class="flex items-center gap-3 rounded-2xl bg-amarelo-200/60 px-3 py-1.5 ring-1 ring-amarelo-400 hover:bg-amarelo-200">
          <span class="fundo-raios grid size-9 shrink-0 place-items-center rounded-xl">
            <img src="/marca/simbolo-fundo-azul.svg" alt="" width="227" height="267" class="h-6 w-auto" />
          </span>
          <span class="min-w-0 flex-1 truncate text-sm">
            <span class="font-bold text-azul-900">{TEXTO_BANNER.compacto}</span>
            <span class="text-slate-600">
              {` · ${bannerDaCasa.nome}`}
              {bannerDaCasa.diariaCentavos !== undefined && ` · ${formatarCentavos(bannerDaCasa.diariaCentavos)} por dia`}
            </span>
          </span>
          <Icone nome="direita" class="size-4 shrink-0 text-azul-700" />
        </a>
      </div>
    )
  }
  {
    entradas.length > 0 && !compacta && (
      <div class="pt-4">
        <h2 class="mx-auto max-w-6xl px-4 text-xs font-extrabold tracking-wider text-azul-700 uppercase">Anúncios</h2>
        <div data-carrossel class="relative mt-2">
          <div data-carrossel-trilho class={classeTrilho}>
            <div data-carrossel-faixa class="flex w-max gap-3 py-2">
              {copias.map((copia) => (
                <ul class="flex gap-3" aria-hidden={copia === 1 ? "true" : undefined}>
                  {entradas.map((entrada) => (
                    <li>
                      {entrada.tipo === "anunciante" && (
                        <a
                          href={`/perfil/${entrada.item.slug}`}
                          tabindex={copia === 1 ? -1 : undefined}
                          class="block w-40 overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-lg sm:w-48"
                        >
                          <FotoMarcador foto={entrada.item.foto} icone={entrada.item.icone} cor={entrada.item.cor} class="h-24 w-full sm:h-28" />
                          <div class="p-2.5">
                            <p class="flex items-center gap-1 truncate text-sm font-extrabold text-tinta">
                              <span class="truncate">{entrada.item.nome}</span>
                              <Selo selo={entrada.item.selo} />
                            </p>
                            <p class="truncate text-xs font-semibold text-slate-500">{entrada.item.categoriaNome}</p>
                          </div>
                        </a>
                      )}
                      {entrada.tipo === "atalho" && (
                        <a
                          href={`/${entrada.categoria.slugLista}`}
                          tabindex={copia === 1 ? -1 : undefined}
                          class="block w-40 overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-lg sm:w-48"
                        >
                          <FotoMarcador icone={entrada.categoria.icone} cor={entrada.categoria.cor} class="h-24 w-full sm:h-28" />
                          <div class="p-2.5">
                            <p class="truncate text-sm font-extrabold text-tinta">{entrada.categoria.nomePlural}</p>
                            <p class="flex items-center gap-0.5 truncate text-xs font-semibold text-azul-600">
                              Ver todos <Icone nome="direita" class="size-3" />
                            </p>
                          </div>
                        </a>
                      )}
                      {entrada.tipo === "convite" && (
                        <a
                          href={linkCarrossel}
                          tabindex={copia === 1 ? -1 : undefined}
                          class="block w-40 overflow-hidden rounded-2xl bg-white shadow-md ring-2 ring-amarelo-400 transition hover:-translate-y-0.5 hover:shadow-lg sm:w-48"
                        >
                          <div class="fundo-raios relative grid h-24 w-full place-items-center overflow-hidden sm:h-28">
                            <span class="absolute top-2 left-2 rounded-full bg-amarelo-400 px-2 py-0.5 text-[0.65rem] font-extrabold tracking-wide text-azul-900 uppercase">
                              {TEXTO_CONVITE.etiqueta}
                            </span>
                            <Icone nome="megafone" class="relative mt-3 size-10 text-white drop-shadow-sm sm:size-12" />
                          </div>
                          <div class="p-2.5">
                            <p class="truncate text-sm font-extrabold text-azul-900">{TEXTO_CONVITE.titulo}</p>
                            <p class="truncate text-xs font-semibold text-slate-500">{TEXTO_CONVITE.subtitulo}</p>
                          </div>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
          <button type="button" data-carrossel-voltar aria-label="Voltar os anúncios" class={`${classeSeta} left-3 size-10`}>
            <Icone nome="esquerda" class="size-5" />
          </button>
          <button type="button" data-carrossel-avancar aria-label="Avançar os anúncios" class={`${classeSeta} right-3 size-10`}>
            <Icone nome="direita" class="size-5" />
          </button>
        </div>
      </div>
    )
  }
  {
    entradas.length > 0 && compacta && (
      <div class="flex items-center gap-2 pt-2 pl-4">
        <span class="shrink-0 text-[0.65rem] font-extrabold tracking-wider text-azul-700 uppercase">Anúncios</span>
        <div data-carrossel class="relative min-w-0 flex-1">
          <div data-carrossel-trilho class={classeTrilho}>
            <div data-carrossel-faixa class="flex w-max gap-2">
              {copias.map((copia) => (
                <ul class="flex gap-2" aria-hidden={copia === 1 ? "true" : undefined}>
                  {entradas.map((entrada) => (
                    <li>
                      {entrada.tipo === "anunciante" && (
                        <a
                          href={`/perfil/${entrada.item.slug}`}
                          tabindex={copia === 1 ? -1 : undefined}
                          class="flex h-10 items-center gap-2 rounded-full bg-fundo py-1 pr-4 pl-1 ring-1 ring-azul-100 hover:bg-azul-50"
                        >
                          <FotoMarcador foto={entrada.item.foto} icone={entrada.item.icone} cor={entrada.item.cor} class="size-8 rounded-full" tamanhoIcone="text-base" />
                          <span class="text-sm font-bold whitespace-nowrap">{entrada.item.nome}</span>
                          <Selo selo={entrada.item.selo} class="text-sm" />
                        </a>
                      )}
                      {entrada.tipo === "atalho" && (
                        <a
                          href={`/${entrada.categoria.slugLista}`}
                          tabindex={copia === 1 ? -1 : undefined}
                          class="flex h-10 items-center gap-2 rounded-full bg-fundo py-1 pr-4 pl-1 ring-1 ring-azul-100 hover:bg-azul-50"
                        >
                          <span class="grid size-8 place-items-center rounded-full text-white" style={`background: ${entrada.categoria.cor}`}>
                            <IconeCategoria nome={entrada.categoria.icone} class="size-4" />
                          </span>
                          <span class="text-sm font-bold whitespace-nowrap">{entrada.categoria.nomePlural}</span>
                        </a>
                      )}
                      {entrada.tipo === "convite" && (
                        <a
                          href={linkCarrossel}
                          tabindex={copia === 1 ? -1 : undefined}
                          class="flex h-10 items-center gap-2 rounded-full bg-amarelo-200/60 py-1 pr-4 pl-1 ring-1 ring-amarelo-400 hover:bg-amarelo-200"
                        >
                          <span class="fundo-raios grid size-8 place-items-center rounded-full text-white">
                            <Icone nome="megafone" class="size-4" />
                          </span>
                          <span class="text-sm font-bold whitespace-nowrap text-azul-900">{TEXTO_CONVITE.titulo}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
          <button type="button" data-carrossel-voltar aria-label="Voltar os anúncios" class={`${classeSeta} left-1 size-8`}>
            <Icone nome="esquerda" class="size-4" />
          </button>
          <button type="button" data-carrossel-avancar aria-label="Avançar os anúncios" class={`${classeSeta} right-1 size-8`}>
            <Icone nome="direita" class="size-4" />
          </button>
        </div>
      </div>
    )
  }
</section>

<script>
  import { iniciarCarrossel } from "@/lib/carrosselNavegador";

  for (const raiz of document.querySelectorAll<HTMLElement>("[data-carrossel]")) iniciarCarrossel(raiz);
</script>
