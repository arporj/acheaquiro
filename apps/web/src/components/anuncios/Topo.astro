---
// Cabeçalho + Banner Exclusivo + Carrossel (item 4.1),
// presentes no topo de todas as páginas.
import { bannerExclusivo, nomeBairro, anunciantesDoCarrossel } from "@/dados/consultas";
import Cabecalho from "../Cabecalho.astro";
import FaixaAnuncios from "./FaixaAnuncios.astro";

interface Props {
  pagina: "inicial" | "interna";
}

const { pagina } = Astro.props;
const exclusivo = await bannerExclusivo();
const banner = exclusivo && {
  item: exclusivo.item,
  descricao: exclusivo.anunciante.descricao,
  bairro:
    exclusivo.anunciante.tipo === "comercio" ? await nomeBairro(exclusivo.anunciante.enderecos[0].bairroId) : "Rio das Ostras",
};
---

<Cabecalho comBusca={pagina === "interna"} />
<FaixaAnuncios pagina={pagina} banner={banner} carrossel={await anunciantesDoCarrossel()} />
