---
// Página única de acheaquiro.com.br até a abertura (ambiente "em-breve"). O
// middleware leva todos os endereços para cá; nos outros sites, dá 404.
import { Icone } from "@acheaqui/ui";
import BotaoContato from "@/components/institucional/BotaoContato.astro";
import Logo from "@/components/Logo.astro";
import { obterRegrasCobranca } from "@/dados/consultas";
import Layout from "@/layouts/Layout.astro";
import { ABERTURA, ENDERECO_EXEMPLO } from "@/lib/ambiente";
import { guardarNoCache } from "@/lib/cache";
import { percentualInicialFundador } from "@/lib/precos";
import { formatarData } from "@/lib/texto";

guardarNoCache(Astro);

const abertura = formatarData(ABERTURA);
const regras = await obterRegrasCobranca();
---

<Layout descricao={`O Ache Aqui RO abre em ${abertura}: profissionais autônomos e comércios de Rio das Ostras, num lugar só.`}>
  <main class="fundo-raios flex flex-1 flex-col text-white">
    <header class="mx-auto w-full max-w-6xl px-4 py-3 lg:py-4">
      <Logo />
    </header>

    <div class="mx-auto grid w-full max-w-6xl flex-1 place-items-center px-4 py-10 md:py-16">
      <section
        class="w-full max-w-3xl rounded-[2rem] bg-white px-6 py-10 text-center text-tinta shadow-[0_20px_60px_-20px_rgb(10_34_102/0.6)] ring-4 ring-amarelo-400 md:px-12 md:py-14"
      >
        <span class="inline-flex items-center gap-1.5 rounded-full bg-vermelho-500 px-3 py-1 text-xs font-extrabold tracking-wide text-white uppercase">
          <Icone nome="estrela" class="size-3.5" fill="currentColor" />
          Na Black Friday
        </span>
        <h1 class="mt-4 font-display text-3xl leading-tight font-extrabold text-azul-900 md:text-4xl">
          O Ache Aqui RO abre em
        </h1>
        {/* A data acompanha a largura da tela (13vw), para caber em 320 px sem rolagem lateral. */}
        <p class="mt-1 font-display text-[min(13vw,3.75rem)] leading-none font-extrabold text-azul-600 md:text-8xl">
          <time datetime={ABERTURA}>{abertura}</time>
        </p>
        <p class="mt-4 font-display text-xl font-bold text-vermelho-600" data-contagem={ABERTURA} hidden></p>
        <p class="mx-auto mt-5 max-w-xl text-lg text-slate-600">
          Os profissionais autônomos e os comércios de Rio das Ostras, num lugar só. Você busca, escolhe e fala direto pelo
          WhatsApp, sem cadastro.
        </p>
        {/* Site de apresentação, com anunciantes fictícios (decisão de 30/10/2026). */}
        <a
          href={ENDERECO_EXEMPLO}
          class="mt-4 inline-flex min-h-11 items-center gap-1.5 font-bold text-azul-600 underline underline-offset-4 hover:text-azul-800"
        >
          Veja como o site vai ficar
          <Icone nome="direita" class="size-4 shrink-0" strokeWidth={2.5} />
        </a>
        <div class="mx-auto mt-8 flex max-w-xl gap-3 rounded-2xl bg-amarelo-200 p-4 text-left text-azul-900">
          <Icone nome="medalha" class="mt-0.5 size-6 shrink-0" />
          <p>
            <strong>Quer anunciar?</strong> Quem paga a assinatura anual até {formatarData(regras.prazoFundador)} vira
            Fundador e tem {percentualInicialFundador(regras)}% de desconto já no primeiro ano.{" "}
            <a href={`${ENDERECO_EXEMPLO}/seu-anuncio`} class="font-bold underline underline-offset-2 hover:text-azul-700">
              Veja como fica o seu anúncio
            </a>
          </p>
        </div>
        <BotaoContato rotulo="Quero ser Fundador" class="mt-6" />
      </section>
    </div>
  </main>
</Layout>

<script>
  // Contagem feita no navegador: a página fica no cache, então a conta do servidor envelheceria.
  const alvo = document.querySelector<HTMLElement>("[data-contagem]");
  if (alvo?.dataset.contagem) {
    const [ano, mes, dia] = alvo.dataset.contagem.split("-").map(Number);
    const hoje = new Date();
    const dias = Math.round(
      (Date.UTC(ano, mes - 1, dia) - Date.UTC(hoje.getFullYear(), hoje.getMonth(), hoje.getDate())) / 86_400_000,
    );
    if (dias > 0) {
      alvo.textContent = dias === 1 ? "Falta 1 dia" : `Faltam ${dias} dias`;
      alvo.hidden = false;
    }
  }
</script>
