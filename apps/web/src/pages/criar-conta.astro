---
// Criar conta de anunciante pelo site (cadastro próprio, decisões G1 e G2 de
// 24/11/2026): nome, e-mail e senha forte; o Supabase Auth confere o Turnstile e
// manda o link de confirmação. Confirmado o e-mail, a pessoa entra, aceita os
// Termos e a Política (/anunciante/aceite) e preenche as etapas do anúncio
// (/anunciante/cadastro). Aberto ao público na abertura (G6): antes, o Auth
// recusa o cadastro (enable_signup) e a tela explica.
import { classesBotao } from "@acheaqui/ui";
import { criarConta } from "@acheaqui/supabase-client";
import { esquemaCriarConta, mensagensPorCampo } from "@acheaqui/validation";
import Aviso from "@/components/conta/Aviso.astro";
import { classesCampo, classesErroCampo, classesRotulo } from "@/components/conta/estilos";
import PaginaAcesso from "@/components/conta/PaginaAcesso.astro";
import RequisitosSenha from "@/components/conta/RequisitosSenha.astro";
import Turnstile from "@/components/conta/Turnstile.astro";
import { clienteServico, destinoDepoisDeEntrar, ipDaRequisicao } from "@/lib/sessao";

const supabase = Astro.locals.supabase!;
const usuario = Astro.locals.usuario;
if (Astro.request.method === "GET" && usuario) {
  return Astro.redirect(await destinoDepoisDeEntrar(supabase, usuario), 303);
}

let erro = "";
let campos: Record<string, string> = {};
let nome = "";
let email = "";
let enviado = false;

if (Astro.request.method === "POST") {
  const formulario = await Astro.request.formData();
  nome = String(formulario.get("nome") ?? "").slice(0, 100);
  email = String(formulario.get("email") ?? "").slice(0, 254);
  const dados = esquemaCriarConta.safeParse({
    nome: formulario.get("nome"),
    email: formulario.get("email"),
    senha: formulario.get("senha"),
    confirmacao: formulario.get("confirmacao"),
    tokenRobo: formulario.get("tokenRobo"),
  });
  if (!dados.success) {
    campos = mensagensPorCampo(dados.error);
    Astro.response.status = 400;
  } else {
    const resultado = await criarConta(supabase, clienteServico(), {
      nome: dados.data.nome,
      email: dados.data.email,
      senha: dados.data.senha,
      tokenRobo: dados.data.tokenRobo,
      ip: ipDaRequisicao(Astro.clientAddress),
    });
    if (resultado.ok) {
      enviado = true;
      email = dados.data.email;
    } else {
      erro = resultado.erro.mensagem;
      Astro.response.status = resultado.erro.codigo === "LIMITE_DE_REQUISICOES" ? 429 : 400;
    }
  }
}
---

<PaginaAcesso titulo={enviado ? "Confira o seu e-mail" : "Criar conta"}>
  {
    enviado ? (
      <>
        <p class="mt-2 text-slate-700">
          Mandamos um link para <strong class="text-tinta">{email}</strong>. Toque nele para confirmar o e-mail e continuar o cadastro do seu anúncio.
        </p>
        <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-slate-600">
          <li>O link vale por 1 hora. Se não chegar em alguns minutos, olhe a pasta de spam.</li>
          <li>
            Já tem conta com este e-mail? Então o link não vai chegar: <a href="/entrar" class="font-bold text-azul-600 hover:underline">entre</a> ou{" "}
            <a href="/recuperar-senha" class="font-bold text-azul-600 hover:underline">crie uma nova senha</a>.
          </li>
        </ul>
        <a href="/entrar" class={classesBotao("contorno", "m", "mt-6")}>
          Ir para Entrar
        </a>
      </>
    ) : (
      <>
        <p class="mt-1 text-slate-600">Para anunciar no Ache Aqui RO. Depois de confirmar o e-mail, você monta o seu anúncio passo a passo.</p>
        {erro && <Aviso tipo="erro">{erro}</Aviso>}
        <form method="post" novalidate>
          <label for="nome" class={classesRotulo}>Seu nome</label>
          <input
            id="nome"
            name="nome"
            autocomplete="name"
            required
            maxlength="100"
            value={nome}
            class={classesCampo}
            aria-invalid={campos.nome ? "true" : undefined}
            aria-describedby={campos.nome ? "nome-erro" : undefined}
          />
          {campos.nome && <p id="nome-erro" class={classesErroCampo}>{campos.nome}</p>}

          <label for="email" class={classesRotulo}>E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="username"
            required
            value={email}
            class={classesCampo}
            aria-invalid={campos.email ? "true" : undefined}
            aria-describedby={campos.email ? "email-erro" : undefined}
          />
          {campos.email && <p id="email-erro" class={classesErroCampo}>{campos.email}</p>}

          <label for="senha" class={classesRotulo}>Senha</label>
          <input
            id="senha"
            name="senha"
            type="password"
            autocomplete="new-password"
            required
            class={classesCampo}
            aria-invalid={campos.senha ? "true" : undefined}
            aria-describedby="senha-requisitos"
          />
          <div id="senha-requisitos">
            <RequisitosSenha campo="senha" />
          </div>
          {campos.senha && <p class={classesErroCampo}>{campos.senha}</p>}

          <label for="confirmacao" class={classesRotulo}>Repita a senha</label>
          <input
            id="confirmacao"
            name="confirmacao"
            type="password"
            autocomplete="new-password"
            required
            class={classesCampo}
            aria-invalid={campos.confirmacao ? "true" : undefined}
            aria-describedby={campos.confirmacao ? "confirmacao-erro" : undefined}
          />
          {campos.confirmacao && <p id="confirmacao-erro" class={classesErroCampo}>{campos.confirmacao}</p>}

          <Turnstile />
          {campos.tokenRobo && <p class={classesErroCampo}>{campos.tokenRobo}</p>}

          <p class="mt-4 text-sm text-slate-600">
            No primeiro acesso, você confere e aceita os <a href="/termos" class="font-bold text-azul-600 hover:underline">Termos de Uso</a> e a{" "}
            <a href="/privacidade" class="font-bold text-azul-600 hover:underline">Política de Privacidade</a>.
          </p>

          <button type="submit" class={classesBotao("azul", "g", "mt-6 w-full")}>Criar conta</button>
        </form>
        <p class="mt-5 text-center text-slate-600">
          Já tem conta? <a href="/entrar" class="font-bold text-azul-600 hover:underline">Entrar</a>
        </p>
      </>
    )
  }
</PaginaAcesso>
