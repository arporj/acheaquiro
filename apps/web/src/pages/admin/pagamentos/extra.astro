---
// Registro do pagamento de um extra mensal (ou anual), com vencimento próprio
// (decisão B3 de 17/11/2026): o primeiro pagamento da contratação ou a
// renovação. Duas etapas, como no plano: o que foi pago, quando e quem
// atendeu (o sistema calcula o valor, o período e a comissão) e depois como
// foi pago. O servidor calcula tudo de novo no registro.
import { Icone, classesBotao } from "@acheaqui/ui";
import CamposRecebimento from "@/components/admin/CamposRecebimento.astro";
import PaginaAdmin from "@/components/admin/PaginaAdmin.astro";
import Aviso from "@/components/conta/Aviso.astro";
import { classesCampo, classesErroCampo, classesRotulo } from "@/components/conta/estilos";
import { ROTULO_SITUACAO } from "@/lib/anunciantesAdmin";
import { calcularExtra, lerContextoExtra, lerDadosExtra, registrarPagamentoExtra } from "@/lib/extras";
import { hojeNaCidade } from "@/lib/pagamentos";
import { formatarCentavos } from "@/lib/precos";
import { formatarData } from "@/lib/texto";

const supabase = Astro.locals.supabase!;
const anuncianteId = Astro.url.searchParams.get("anunciante") ?? "";
/** Comprovante de até 5 MB mais os campos de texto. */
const TAMANHO_MAXIMO_PEDIDO = 5 * 1024 * 1024 + 64 * 1024;

const contexto = await lerContextoExtra(supabase, anuncianteId);
if (!contexto.ok && contexto.erro.codigo === "NAO_ENCONTRADO") return new Response(null, { status: 404 });

let erro = contexto.ok ? "" : contexto.erro.mensagem;
let campos: Record<string, string> = {};
let enviado: FormData | null = null;

if (Astro.request.method === "POST" && contexto.ok) {
  const tamanho = Number(Astro.request.headers.get("content-length") ?? "0");
  if (!tamanho || tamanho > TAMANHO_MAXIMO_PEDIDO) {
    erro = "Envio maior que o permitido (comprovante de até 5 MB).";
    Astro.response.status = 400;
  } else {
    enviado = await Astro.request.formData();
    const arquivo = enviado.get("comprovante");
    const comprovante = arquivo instanceof File && arquivo.size > 0 ? new Uint8Array(await arquivo.arrayBuffer()) : null;
    const r = await registrarPagamentoExtra(supabase, contexto.dados, enviado, comprovante, Astro.url.origin);
    if (r.ok) return Astro.redirect(`/admin/pagamentos/${r.dados.id}?aviso=registrado`, 303);
    erro = r.erro.mensagem;
    campos = r.erro.campos ?? {};
    Astro.response.status = r.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
  }
}

const ctx = contexto.ok ? contexto.dados : null;
const lido = ctx ? lerDadosExtra(enviado ?? Astro.url.searchParams, ctx) : null;
const valores = lido?.valores ?? null;
// Sem extra escolhido ainda, só mostra o formulário.
const pediuCalculo = Astro.url.searchParams.has("extra") || enviado !== null;
const calculado = ctx && lido?.dados.ok && pediuCalculo ? await calcularExtra(ctx, lido.dados.dados) : null;
if (pediuCalculo && lido && !lido.dados.ok) {
  erro ||= lido.dados.erro.mensagem;
  campos = { ...lido.dados.erro.campos, ...campos };
}
if (calculado && !calculado.ok) erro ||= calculado.erro.mensagem;
const c = calculado?.ok ? calculado.dados : null;
const extraEscolhido = ctx?.extras.find((e) => e.id === valores?.extraId);
const hoje = hojeNaCidade();
const caixa = "rounded-xl bg-fundo p-3";
const secao = "mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5";
---

<PaginaAdmin titulo="Pagamento de extra" descricao={ctx?.anunciante.nome}>
  <p class="mt-2 text-sm">
    {ctx && <a href={`/admin/anunciantes/${ctx.anunciante.id}`} class="font-bold text-azul-600 hover:underline">← {ctx.anunciante.nome}</a>}
  </p>
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  {
    ctx && valores && (
      <>
        <section class={secao}>
          <div class="grid gap-3 text-sm sm:grid-cols-2">
            <div class={caixa}>
              <p class="font-bold text-azul-900">Anunciante</p>
              <p>
                {ctx.anunciante.nome} · {ROTULO_SITUACAO[ctx.anunciante.status]}
              </p>
              {ctx.anunciante.fundadorDesde && <p>Fundador desde {formatarData(ctx.anunciante.fundadorDesde)}</p>}
              {ctx.carteira && <p>Carteira de {ctx.carteira.codigo}</p>}
            </div>
            <div class={caixa}>
              <p class="font-bold text-azul-900">Extras em vigor</p>
              {ctx.emVigor.length === 0 ? (
                <p>Nenhum</p>
              ) : (
                ctx.emVigor.map((e) => (
                  <p>
                    {e.nome} ({e.periodicidade}), vence em {formatarData(e.venceEm)}
                  </p>
                ))
              )}
            </div>
          </div>

          {ctx.extras.length === 0 ? (
            <p class="mt-4 text-sm text-slate-600">Não há extra mensal no catálogo para este tipo de anunciante.</p>
          ) : (
            <form method="get" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              <input type="hidden" name="anunciante" value={ctx.anunciante.id} />
              <div>
                <label for="extra" class={classesRotulo}>Extra</label>
                <select id="extra" name="extra" required class={classesCampo}>
                  {ctx.extras.map((e) => (
                    <option value={e.id} selected={e.id === valores.extraId} disabled={!e.ativo}>
                      {e.nome} ({formatarCentavos(e.valorMensalCentavos)} por mês){!e.ativo && " · desligado"}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label for="periodicidade" class={classesRotulo}>Período</label>
                <select id="periodicidade" name="periodicidade" class={classesCampo}>
                  <option value="mensal" selected={valores.periodicidade === "mensal"}>Mensal</option>
                  <option value="anual" selected={valores.periodicidade === "anual"} disabled={extraEscolhido ? !extraEscolhido.permiteAnual : false}>
                    Anual
                  </option>
                </select>
              </div>
              <div>
                <label for="pago_em" class={classesRotulo}>Pago em</label>
                <input id="pago_em" type="date" name="pago_em" value={valores.pagoEm} max={hoje} required class={classesCampo} />
              </div>
              <div>
                <label for="representante" class={classesRotulo}>Quem atendeu a venda</label>
                <select id="representante" name="representante" class={classesCampo}>
                  <option value="">Ninguém (o anunciante contratou sozinho)</option>
                  {ctx.representantes.map((r) => (
                    <option value={r.id} selected={r.id === valores.representanteId}>
                      {r.codigo}
                      {!r.recebeComissao && " (sem comissão)"}
                    </option>
                  ))}
                </select>
                {campos.representanteId && <p class={classesErroCampo}>{campos.representanteId}</p>}
              </div>
              <div>
                <label for="desconto" class={classesRotulo}>Desconto do representante (R$)</label>
                <input id="desconto" name="desconto" inputmode="decimal" placeholder="0,00" value={valores.descontoCentavos} class={classesCampo} />
                <p class="mt-1 text-xs text-slate-500">Só no 1º pagamento, até a comissão dele.</p>
                {campos.descontoCentavos && <p class={classesErroCampo}>{campos.descontoCentavos}</p>}
              </div>
              <div class="self-end">
                <button type="submit" class={classesBotao("contorno", "m", "w-full")}>
                  Calcular
                </button>
              </div>
            </form>
          )}
        </section>

        {c && (
          <>
            <section class={secao}>
              <p class="text-sm font-bold text-azul-900">Valor a receber</p>
              <p class="font-display text-3xl font-extrabold text-azul-900">{formatarCentavos(c.valorCobradoCentavos)}</p>
              {c.descontoRepresentanteCentavos > 0 && (
                <p class="text-sm text-slate-600">
                  {formatarCentavos(c.cobranca.valorDevidoCentavos)} com {formatarCentavos(c.descontoRepresentanteCentavos)} de desconto do representante
                </p>
              )}
              {c.cobranca.descontoFundadorCentavos > 0 && (
                <p class="text-sm text-slate-600">
                  {formatarCentavos(c.cobranca.valorCheioCentavos)} com {formatarCentavos(c.cobranca.descontoFundadorCentavos)} de desconto de Fundador
                </p>
              )}
              <ul class="mt-3 space-y-1 text-sm text-slate-700">
                <li>
                  {c.extra.nome}: {formatarData(c.periodo.inicio)} a {formatarData(c.periodo.venceEm)}
                  {c.periodo.inicio > valores.pagoEm && !c.periodo.renovacao && " (começa na abertura do site)"}
                  {c.periodo.renovacao ? " (renovação, sem mudar o dia do vencimento)" : " (vencimento próprio, no dia do pagamento)"}
                </li>
                <li>{c.numero}º pagamento desta contratação</li>
                <li>
                  {c.comissao && c.atendimento
                    ? `Comissão de extra de ${c.atendimento.codigo} (20%): ${formatarCentavos(c.comissao.valorCentavos)}, liberada em ${formatarData(c.comissaoLiberaEm!)}`
                    : c.comissaoCarteira && ctx.carteira
                      ? `Carteira de ${ctx.carteira.codigo} (${c.comissaoCarteira.percentual}%): ${formatarCentavos(c.comissaoCarteira.valorCentavos)}, liberada em ${formatarData(c.comissaoLiberaEm!)}`
                      : "Sem comissão neste pagamento"}
                </li>
              </ul>
            </section>

            <form method="post" enctype="multipart/form-data" class={secao} data-form-pagamento>
              <input type="hidden" name="extra" value={valores.extraId} />
              <input type="hidden" name="periodicidade" value={valores.periodicidade} />
              <input type="hidden" name="pago_em" value={valores.pagoEm} />
              <input type="hidden" name="representante" value={valores.representanteId} />
              <input type="hidden" name="desconto" value={valores.descontoCentavos} />
              <CamposRecebimento enviado={enviado} campos={campos} />
              <button type="submit" class={classesBotao("zap", "g", "mt-5 w-full")}>
                <Icone nome="certo" class="size-5" />
                Registrar pagamento de {formatarCentavos(c.valorCobradoCentavos)}
              </button>
            </form>
          </>
        )}
      </>
    )
  }
</PaginaAdmin>

<script>
  import { ligarCamposRecebimento } from "@/lib/comprovante";

  const form = document.querySelector<HTMLFormElement>("[data-form-pagamento]");
  if (form) ligarCamposRecebimento(form);
</script>
