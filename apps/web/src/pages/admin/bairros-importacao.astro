---
// Bairros escritos na Receita que não batem com a tabela de bairros (D5). Na
// aba Pendentes, a administração liga o nome a um bairro existente, cria um
// bairro novo ou deixa de fora; os comércios entram na próxima importação. Na
// aba Resolvidos, pode voltar um nome para pendente ou renomear o bairro.
import { classesBotao } from "@acheaqui/ui";
import Aviso from "@/components/conta/Aviso.astro";
import { classesCampo } from "@/components/conta/estilos";
import PaginaAdmin from "@/components/admin/PaginaAdmin.astro";
import { listarApelidos, listarBairrosAdmin, renomearBairro, resolverApelido } from "@/lib/importacao";
import type { Resultado } from "@acheaqui/types";

const supabase = Astro.locals.supabase!;
const aba = Astro.url.searchParams.get("aba") === "resolvidos" ? "resolvidos" : "pendentes";
let erro = "";

const AVISOS: Record<string, string> = {
  ligado: "Nome ligado ao bairro. Os comércios dele entram na próxima importação.",
  criado: "Bairro criado e ligado. Os comércios dele entram na próxima importação.",
  ignorado: "Nome deixado de fora. Os comércios com esse bairro não serão importados.",
  pendente: "Nome voltou para Pendentes. Os comércios dele só entram depois de resolvido de novo.",
  renomeado: "Bairro renomeado em todo o site. O endereço das páginas continua o mesmo.",
};
const aviso = AVISOS[Astro.url.searchParams.get("aviso") ?? ""];

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const campo = (nome: string) => String(f.get(nome) ?? "").slice(0, 100);
  const nomeReceita = campo("nome_receita");
  const acao = campo("acao");
  let resultado: Resultado<null>;
  let destino = aba;
  switch (acao) {
    case "ligado":
      resultado = await resolverApelido(supabase, nomeReceita, { tipo: "ligar", bairroId: campo("bairro") });
      break;
    case "criado":
      resultado = await resolverApelido(supabase, nomeReceita, { tipo: "criar", nome: campo("nome") });
      break;
    case "ignorado":
      resultado = await resolverApelido(supabase, nomeReceita, { tipo: "ignorar" });
      break;
    case "pendente":
      resultado = await resolverApelido(supabase, nomeReceita, { tipo: "pendente" });
      destino = "pendentes";
      break;
    case "renomeado":
      resultado = await renomearBairro(supabase, campo("bairro"), campo("nome"));
      break;
    default:
      resultado = { ok: false, erro: { codigo: "DADOS_INVALIDOS", mensagem: "Ação desconhecida." } };
  }
  if (resultado.ok) return Astro.redirect(`/admin/bairros-importacao?aba=${destino}&aviso=${acao}`, 303);
  erro = resultado.erro.mensagem;
  Astro.response.status = resultado.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
}

const [apelidosR, bairrosR] = await Promise.all([listarApelidos(supabase), listarBairrosAdmin(supabase)]);
if (!apelidosR.ok) erro ||= apelidosR.erro.mensagem;
if (!bairrosR.ok) erro ||= bairrosR.erro.mensagem;
const apelidos = apelidosR.ok ? apelidosR.dados : [];
const bairros = bairrosR.ok ? bairrosR.dados : [];
const nomeBairro = new Map(bairros.map((b) => [b.id, b.nome]));

const pendentes = apelidos.filter((a) => !a.bairro_id && !a.ignorar);
const resolvidos = apelidos
  .filter((a) => a.bairro_id || a.ignorar)
  .sort((a, b) => (nomeBairro.get(a.bairro_id ?? "") ?? "~").localeCompare(nomeBairro.get(b.bairro_id ?? "") ?? "~", "pt-BR"));
const renomear = Astro.url.searchParams.get("renomear");

const campoPequeno = classesCampo.replace("h-12", "h-10").replace("mt-1 ", "");
const celula = "px-3 py-2 align-middle";
const ABAS = [
  { id: "pendentes", rotulo: `Pendentes (${pendentes.length})` },
  { id: "resolvidos", rotulo: `Resolvidos (${resolvidos.length})` },
];
---

<PaginaAdmin titulo="Bairros da importação" descricao="Nomes de bairro escritos na Receita que não batem com a lista de bairros do site.">
  {aviso && <Aviso tipo="sucesso">{aviso}</Aviso>}
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  <nav class="mt-5 flex gap-1.5" aria-label="Abas">
    {
      ABAS.map((a) => (
        <a
          href={`/admin/bairros-importacao?aba=${a.id}`}
          aria-current={a.id === aba ? "page" : undefined}
          class="rounded-full px-3 py-1.5 text-sm font-bold text-azul-700 ring-1 ring-azul-100 hover:bg-white aria-[current=page]:bg-azul-600 aria-[current=page]:text-white aria-[current=page]:ring-azul-600"
        >
          {a.rotulo}
        </a>
      ))
    }
  </nav>

  {
    aba === "pendentes" &&
      (pendentes.length === 0 ? (
        <p class="mt-4 rounded-2xl bg-white p-6 text-center text-slate-500 ring-1 ring-black/5">Nenhum bairro pendente.</p>
      ) : (
        <div class="mt-4 overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
          <table class="w-full text-left text-sm">
            <thead class="bg-fundo text-xs font-extrabold text-slate-500 uppercase">
              <tr>
                <th class={celula}>Nome na Receita</th>
                <th class={celula}>Comércios</th>
                <th class={celula}>Ligar a um bairro</th>
                <th class={celula}>Ou criar bairro novo</th>
                <th class={celula}>
                  <span class="sr-only">Deixar de fora</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {pendentes.map((a) => (
                <tr>
                  <td class={`${celula} font-bold text-azul-900`}>{a.nome_receita}</td>
                  <td class={celula}>{a.comercios}</td>
                  <td class={celula}>
                    <form method="post" class="flex min-w-64 gap-2">
                      <input type="hidden" name="acao" value="ligado" />
                      <input type="hidden" name="nome_receita" value={a.nome_receita} />
                      <select name="bairro" required aria-label={`Bairro para "${a.nome_receita}"`} class={campoPequeno}>
                        <option value="">Escolha…</option>
                        {bairros.map((b) => (
                          <option value={b.id}>{b.nome}</option>
                        ))}
                      </select>
                      <button class={classesBotao("azul", "p", "shrink-0")}>Ligar</button>
                    </form>
                  </td>
                  <td class={celula}>
                    <form method="post" class="flex min-w-64 gap-2">
                      <input type="hidden" name="acao" value="criado" />
                      <input type="hidden" name="nome_receita" value={a.nome_receita} />
                      <input name="nome" required minlength="2" maxlength="80" placeholder="Nome do bairro" aria-label="Nome do bairro novo" class={campoPequeno} />
                      <button class={classesBotao("contorno", "p", "shrink-0")}>Criar</button>
                    </form>
                  </td>
                  <td class={celula}>
                    <form method="post">
                      <input type="hidden" name="acao" value="ignorado" />
                      <input type="hidden" name="nome_receita" value={a.nome_receita} />
                      <button class="text-sm font-bold whitespace-nowrap text-slate-500 hover:text-vermelho-600 hover:underline">Deixar de fora</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))
  }

  {
    aba === "resolvidos" && (
      <div class="mt-4 overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
        <table class="w-full text-left text-sm">
          <thead class="bg-fundo text-xs font-extrabold text-slate-500 uppercase">
            <tr>
              <th class={celula}>Nome na Receita</th>
              <th class={celula}>Bairro no site</th>
              <th class={celula}>
                <span class="sr-only">Ações</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {resolvidos.map((a) => {
              const bairro = a.bairro_id ? nomeBairro.get(a.bairro_id) : undefined;
              const editando = a.bairro_id && renomear === `${a.bairro_id}:${a.nome_receita}`;
              return (
                <tr>
                  <td class={celula}>{a.nome_receita}</td>
                  <td class={celula}>
                    {editando ? (
                      <form method="post" class="flex min-w-64 gap-2">
                        <input type="hidden" name="acao" value="renomeado" />
                        <input type="hidden" name="bairro" value={a.bairro_id} />
                        <input name="nome" required minlength="2" maxlength="80" value={bairro} aria-label="Novo nome do bairro" class={campoPequeno} />
                        <button class={classesBotao("azul", "p", "shrink-0")}>Salvar</button>
                        <a href="/admin/bairros-importacao?aba=resolvidos" class={classesBotao("contorno", "p", "shrink-0")}>
                          Cancelar
                        </a>
                      </form>
                    ) : a.ignorar ? (
                      <span class="text-slate-400 italic">fica de fora</span>
                    ) : (
                      <span class="font-bold text-azul-900">{bairro ?? "?"}</span>
                    )}
                  </td>
                  <td class={`${celula} whitespace-nowrap`}>
                    <div class="flex justify-end gap-3">
                      {a.bairro_id && !editando && (
                        <a
                          href={`/admin/bairros-importacao?aba=resolvidos&renomear=${encodeURIComponent(`${a.bairro_id}:${a.nome_receita}`)}`}
                          class="font-bold text-azul-600 hover:underline"
                        >
                          Renomear bairro
                        </a>
                      )}
                      <form method="post">
                        <input type="hidden" name="acao" value="pendente" />
                        <input type="hidden" name="nome_receita" value={a.nome_receita} />
                        <button class="font-bold text-slate-500 hover:text-azul-600 hover:underline">Voltar para pendentes</button>
                      </form>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="border-t border-slate-100 px-3 py-2 text-xs text-slate-500">
          Renomear muda o nome do bairro em todo o site (filtros, perfis e listas), e não só para este nome da Receita.
        </p>
      </div>
    )
  }
</PaginaAdmin>
