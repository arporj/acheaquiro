---
// Um evento da Agenda na administração (/admin/agenda/novo cria): dados,
// publicação, cortesia (decisão C1 de 17/11/2026), conferência do evento
// publicado por um cliente (K1), organizador (conta de cliente), pagamento do
// evento avulso, cartaz, programação e barracas. Regras em
// packages/domain/agenda.ts; o banco repete as travas.
import { blocosDoEventoAvulso, momentoLocal, ultimoDiaParaComecar } from "@acheaqui/domain";
import { classesBotao } from "@acheaqui/ui";
import { ORIGENS_EVENTO, ROTULO_ORIGEM_EVENTO } from "@acheaqui/validation";
import PaginaAdmin from "@/components/admin/PaginaAdmin.astro";
import FormularioEvento from "@/components/agenda/FormularioEvento.astro";
import PartesDoEvento from "@/components/agenda/PartesDoEvento.astro";
import PublicacaoDoEvento from "@/components/agenda/PublicacaoDoEvento.astro";
import Aviso from "@/components/conta/Aviso.astro";
import { classesCampo, classesRotulo } from "@/components/conta/estilos";
import {
  AVISOS_DO_EVENTO,
  executarAcaoDoEvento,
  lerEventoAdmin,
  lerSituacaoDoEvento,
  listarArtistasAdmin,
  listarBairros,
  type AcaoDoEvento,
  type EventoAdmin,
} from "@/lib/agenda";
import { lerContextoEvento } from "@/lib/extras";
import { formatarCentavos } from "@/lib/precos";
import { formatarData } from "@/lib/texto";

const supabase = Astro.locals.supabase!;
const idParametro = Astro.params.id ?? "";
const novo = idParametro === "novo";
const hoje = momentoLocal(new Date()).data;

const ACOES: readonly AcaoDoEvento[] = [
  "salvar",
  "situacao",
  "cortesia",
  "conferido",
  "organizador",
  "cartaz",
  "tirar-cartaz",
  "programacao",
  "apagar-programacao",
  "barraca",
  "apagar-barraca",
];
const aviso = AVISOS_DO_EVENTO[Astro.url.searchParams.get("aviso") ?? ""];
let erro = "";

if (Astro.request.method === "POST") {
  const r = await executarAcaoDoEvento(supabase, Astro.request, novo ? null : idParametro, ACOES, { origemDoSite: Astro.url.origin });
  if (r.ok) return Astro.redirect(`/admin/agenda/${r.dados.id}?aviso=${r.dados.aviso}`, 303);
  erro = r.erro.mensagem;
  Astro.response.status = r.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
}

const [eventoR, bairrosR, artistasR, situacaoR] = await Promise.all([
  novo ? Promise.resolve(null) : lerEventoAdmin(supabase, idParametro),
  listarBairros(supabase),
  novo ? Promise.resolve(null) : listarArtistasAdmin(supabase),
  novo ? Promise.resolve(null) : lerSituacaoDoEvento(supabase, idParametro),
]);
// Evento avulso: os blocos de 7 dias pagos e o que falta pagar (decisões E1 a E3 de 17/11/2026).
const pagamentoR = eventoR?.ok && eventoR.dados.origem === "avulso" ? await lerContextoEvento(supabase, eventoR.dados.id) : null;
if (pagamentoR && !pagamentoR.ok) erro ||= pagamentoR.erro.mensagem;
const pagamento = pagamentoR?.ok ? pagamentoR.dados : null;
if (eventoR && !eventoR.ok && eventoR.erro.codigo === "NAO_ENCONTRADO") return Astro.rewrite("/404");
if (eventoR && !eventoR.ok) erro ||= eventoR.erro.mensagem;
if (!bairrosR.ok) erro ||= bairrosR.erro.mensagem;
const evento: EventoAdmin | null = eventoR?.ok ? eventoR.dados : null;
const bairros = bairrosR.ok ? bairrosR.dados : [];
const artistas = artistasR?.ok ? artistasR.dados : [];
const organizador = situacaoR?.ok ? situacaoR.dados.organizador : null;

const textoPublicacao = !evento
  ? ""
  : evento.situacao === "rascunho"
    ? "Rascunho: não aparece no site."
    : evento.situacao === "cancelado"
      ? "Cancelado: saiu da Agenda."
      : evento.impedimento
        ? `Publicado, mas fora do site: ${evento.impedimento}`
        : "Publicado e no site.";
const origens = ORIGENS_EVENTO.map((valor) => ({ valor, rotulo: ROTULO_ORIGEM_EVENTO[valor] }));
const titulo = novo ? "Novo evento" : (evento?.nome ?? "Evento");
const divisoria = "mt-5 border-t border-slate-100 pt-4";
---

<PaginaAdmin titulo={titulo} descricao={novo ? "Cadastre o evento; depois acrescente a programação, as barracas e o cartaz." : undefined}>
  <a href="/admin/agenda" class="mt-2 inline-flex items-center gap-1 text-sm font-bold text-azul-600 hover:underline">← Voltar para a Agenda</a>
  {aviso && <Aviso tipo="sucesso">{aviso}</Aviso>}
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  {
    evento && (
      <PublicacaoDoEvento evento={evento} texto={textoPublicacao} noSite={evento.situacao === "publicado" && !evento.impedimento}>
        {evento.situacao === "publicado" && evento.conferido_em === null && (
          <div class={divisoria}>
            <h3 class="font-bold text-azul-900">Para conferir</h3>
            <p class="mt-1 text-sm text-slate-700">
              O cliente publicou ou mudou este evento, e ele já está no site. Confira os dados, o cartaz, a programação e as barracas. Se algo estiver errado,
              volte para rascunho e fale com o cliente.
            </p>
            <form method="post" class="mt-2">
              <input type="hidden" name="acao" value="conferido" />
              <button type="submit" class={classesBotao("azul", "p")}>
                Conferido
              </button>
            </form>
          </div>
        )}

        {evento.origem === "avulso" && (
          <div class={divisoria}>
            <h3 class="font-bold text-azul-900">Organizador</h3>
            <p class="mt-1 text-sm text-slate-700">
              {organizador
                ? `Conta de ${organizador}: vê e altera o evento na área dele.`
                : "Sem conta de organizador: só a equipe altera o evento."}
            </p>
            <form method="post" class="mt-2 grid gap-2 sm:grid-cols-[1fr_auto] sm:items-end">
              <input type="hidden" name="acao" value="organizador" />
              <div>
                <label class={classesRotulo} for="email-organizador">
                  E-mail do organizador
                </label>
                <input id="email-organizador" name="email" type="email" inputmode="email" maxlength="200" value={organizador ?? ""} class={classesCampo} />
                <p class="mt-1 text-xs text-slate-500">Sem conta, ele recebe um e-mail para criar a senha. Deixe vazio para tirar o organizador.</p>
              </div>
              <button type="submit" class={classesBotao("contorno", "m")}>
                Salvar organizador
              </button>
            </form>
          </div>
        )}

        {evento.origem === "avulso" && (
          <div class={divisoria}>
            <h3 class="font-bold text-azul-900">Cortesia</h3>
            {evento.cortesia_motivo ? (
              <form method="post" class="mt-1">
                <p class="text-sm text-slate-700">
                  Dada em {formatarData((evento.cortesia_em ?? "").slice(0, 10))}: {evento.cortesia_motivo}
                </p>
                <input type="hidden" name="acao" value="cortesia" />
                <input type="hidden" name="motivo" value="" />
                <button type="submit" class={classesBotao("contorno", "p", "mt-2")}>
                  Tirar a cortesia
                </button>
              </form>
            ) : (
              <form method="post" class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-end">
                <input type="hidden" name="acao" value="cortesia" />
                <div>
                  <label class={classesRotulo} for="motivo-cortesia">
                    Motivo da cortesia
                  </label>
                  <input id="motivo-cortesia" name="motivo" required minlength="10" maxlength="200" class={classesCampo} placeholder="Ex.: divulgação da abertura do site" />
                  <p class="mt-1 text-xs text-slate-500">O evento avulso aparece no site sem pagamento. Fica registrado quem deu e quando.</p>
                </div>
                <button type="submit" class={classesBotao("azul", "m")}>
                  Dar cortesia
                </button>
              </form>
            )}
          </div>
        )}

        {pagamento && (
          <div class={divisoria}>
            <h3 class="font-bold text-azul-900">Pagamento</h3>
            {(() => {
              const blocos = blocosDoEventoAvulso(pagamento.evento.dataInicio, pagamento.evento.dataFim);
              const faltam = Math.max(0, blocos - pagamento.blocosPagos);
              return (
                <>
                  <p class="mt-1 text-sm text-slate-700">
                    {blocos} bloco{blocos === 1 ? "" : "s"} de 7 dias · {pagamento.blocosPagos} pago{pagamento.blocosPagos === 1 ? "" : "s"}
                    {pagamento.valorBlocoCentavos !== null && faltam > 0 && ` · falta pagar ${formatarCentavos(faltam * pagamento.valorBlocoCentavos)}`}
                    {pagamento.evento.cortesia && " · com cortesia, aparece sem pagamento"}
                  </p>
                  {pagamento.blocosPagos > 0 && (
                    <p class="mt-1 text-xs text-slate-500">
                      As datas só mudam dentro dos blocos pagos (até {pagamento.blocosPagos * 7} dias). Para aumentar o evento, registre o pagamento dos blocos que
                      faltam.
                    </p>
                  )}
                  {pagamento.pagamentos.length > 0 && (
                    <ul class="mt-2 space-y-1 text-sm">
                      {pagamento.pagamentos.map((p) => (
                        <li>
                          <a
                            href={`/admin/pagamentos/${p.id}`}
                            class:list={["font-bold text-azul-600 hover:underline", p.devolvido && "text-slate-400 line-through"]}
                          >
                            {formatarData(p.pagoEm)} · {p.blocos} bloco{p.blocos === 1 ? "" : "s"} · {formatarCentavos(p.valorCentavos)}
                          </a>
                          {p.devolvido && <span class="ml-2 text-xs font-extrabold text-vermelho-700">Devolvido</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                  {evento.situacao !== "cancelado" && evento.data_fim >= hoje && (
                    <a href={`/admin/pagamentos/evento?evento=${evento.id}`} class={classesBotao(faltam > 0 ? "azul" : "contorno", "p", "mt-3")}>
                      {faltam > 0 ? "Registrar pagamento" : "Aumentar o evento e pagar os blocos novos"}
                    </a>
                  )}
                </>
              );
            })()}
          </div>
        )}
      </PublicacaoDoEvento>
    )
  }

  <section class="mt-5 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5 sm:p-5" aria-labelledby="titulo-dados">
    <h2 id="titulo-dados" class="font-display text-lg font-bold text-azul-900">Dados do evento</h2>
    <FormularioEvento evento={evento} bairros={bairros} origens={origens} hoje={hoje} ultimoDia={ultimoDiaParaComecar(hoje)} origemLivre />
  </section>

  {evento && <PartesDoEvento evento={evento} artistas={artistas} linkArtistas="/admin/agenda/artistas" />}
</PaginaAdmin>
