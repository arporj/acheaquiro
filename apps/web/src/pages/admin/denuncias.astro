---
// Denúncias de perfil (item 4.9; decisões D1 e D2 de 12/11/2026). A equipe
// confere o perfil e marca a denúncia como procedente ou não. Para tirar o
// perfil do ar ou corrigir o conteúdo, usa a página do anunciante (Suspender,
// editar), que já registra tudo na auditoria.
import { Icone, Modal, classesBotao } from "@acheaqui/ui";
import { ROTULOS_MOTIVO_DENUNCIA } from "@acheaqui/validation";
import Aviso from "@/components/conta/Aviso.astro";
import { classesRotulo } from "@/components/conta/estilos";
import PaginaAdmin from "@/components/admin/PaginaAdmin.astro";
import { listarDenuncias, tratarDenuncia, type DenunciaAdmin, type SituacaoDenuncia } from "@/lib/denuncias";

const supabase = Astro.locals.supabase!;

const AVISOS: Record<string, string> = {
  procedente: "Denúncia marcada como procedente. Se o perfil precisa sair do ar, use Suspender na página do anunciante.",
  improcedente: "Denúncia marcada como improcedente.",
};
const aviso = AVISOS[Astro.url.searchParams.get("aviso") ?? ""];
let erro = "";

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const campo = (nome: string) => String(f.get(nome) ?? "").slice(0, 1000);
  const situacao = campo("situacao");
  const resultado =
    situacao === "procedente" || situacao === "improcedente"
      ? await tratarDenuncia(supabase, campo("id"), situacao, campo("observacao"))
      : ({ ok: false, erro: { codigo: "DADOS_INVALIDOS", mensagem: "Ação desconhecida." } } as const);
  if (resultado.ok) return Astro.redirect(`/admin/denuncias?aviso=${situacao}`, 303);
  erro = resultado.erro.mensagem;
  Astro.response.status = resultado.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
}

const ABAS = [
  { id: "abertas", rotulo: "Abertas" },
  { id: "tratadas", rotulo: "Tratadas" },
] as const;
const aba = Astro.url.searchParams.get("aba") === "tratadas" ? "tratadas" : "abertas";

const denunciasR = await listarDenuncias(supabase, aba === "abertas");
if (!denunciasR.ok) erro ||= denunciasR.erro.mensagem;
const denuncias = denunciasR.ok ? denunciasR.dados : [];

// Quantas denúncias abertas cada perfil tem, para a equipe ver os repetidos.
const porPerfil = new Map<string, number>();
for (const d of denuncias) if (d.anunciante && d.situacao === "aberta") porPerfil.set(d.anunciante.id, (porPerfil.get(d.anunciante.id) ?? 0) + 1);

const SITUACOES: Record<SituacaoDenuncia, { texto: string; classe: string }> = {
  aberta: { texto: "Aberta", classe: "bg-amarelo-200 text-azul-900" },
  procedente: { texto: "Procedente", classe: "bg-vermelho-600 text-white" },
  improcedente: { texto: "Improcedente", classe: "bg-slate-200 text-slate-700" },
};
const STATUS_PERFIL: Record<string, string> = {
  publicado: "No ar",
  suspenso: "Suspenso",
  pausado: "Pausado",
  escondido_por_vencimento: "Escondido por vencimento",
};
const etiqueta = "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-extrabold";
const dataHora = (iso: string) =>
  new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short", timeZone: "America/Sao_Paulo" }).format(new Date(iso));
const campoTexto = "mt-1 w-full rounded-2xl border-2 border-azul-100 p-3 focus:border-azul-500 focus:outline-none";
const abertas = (d: DenunciaAdmin) => d.situacao === "aberta" && d.anunciante;
---

<PaginaAdmin titulo="Denúncias" descricao="Denúncias que os visitantes fizeram sobre os perfis. Quem denuncia não se identifica.">
  {aviso && <Aviso tipo="sucesso">{aviso}</Aviso>}
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  <nav class="mt-5 flex gap-1.5" aria-label="Situação das denúncias">
    {
      ABAS.map((a) => (
        <a
          href={`/admin/denuncias?aba=${a.id}`}
          aria-current={a.id === aba ? "page" : undefined}
          class="rounded-full px-3 py-1.5 text-sm font-bold text-azul-700 ring-1 ring-azul-100 hover:bg-white aria-[current=page]:bg-azul-600 aria-[current=page]:text-white aria-[current=page]:ring-azul-600"
        >
          {a.rotulo}
        </a>
      ))
    }
  </nav>

  {
    denunciasR.ok && denuncias.length === 0 && (
      <p class="mt-4 rounded-2xl bg-white p-6 text-center text-slate-500 ring-1 ring-black/5">
        {aba === "abertas" ? "Nenhuma denúncia esperando análise." : "Nenhuma denúncia tratada ainda."}
      </p>
    )
  }

  <ul class="mt-4 space-y-3">
    {
      denuncias.map((d) => {
        const repetidas = d.anunciante ? (porPerfil.get(d.anunciante.id) ?? 0) : 0;
        return (
          <li class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`${etiqueta} ${SITUACOES[d.situacao].classe}`}>{SITUACOES[d.situacao].texto}</span>
              {d.anunciante ? (
                <a href={`/perfil/${d.anunciante.slug}`} target="_blank" class="font-bold text-azul-900 hover:underline">
                  {d.anunciante.nome}
                </a>
              ) : (
                <span class="font-bold text-slate-500">Perfil apagado</span>
              )}
              {d.anunciante && <span class="text-xs font-bold text-slate-500">{STATUS_PERFIL[d.anunciante.status] ?? d.anunciante.status}</span>}
              <span class="text-xs text-slate-500">{dataHora(d.criado_em)}</span>
              {repetidas > 1 && <span class={`${etiqueta} bg-vermelho-50 text-vermelho-700`}>{repetidas} denúncias abertas deste perfil</span>}
            </div>

            <div class="mt-3 rounded-xl bg-fundo p-3 text-sm">
              <p class="font-bold text-azul-900">{ROTULOS_MOTIVO_DENUNCIA[d.motivo]}</p>
              {d.descricao ? <p class="mt-1 whitespace-pre-line text-slate-700">"{d.descricao}"</p> : <p class="mt-1 text-slate-500">Sem descrição.</p>}
            </div>

            {d.observacao_equipe && <p class="mt-3 text-sm text-slate-600">Observação da equipe: {d.observacao_equipe}</p>}
            {d.tratada_em && (
              <p class="mt-1 text-xs text-slate-500">
                Tratada em {dataHora(d.tratada_em)}
                {d.nome_quem_tratou && ` por ${d.nome_quem_tratou}`}
              </p>
            )}

            {abertas(d) && (
              <div class="mt-3 flex flex-wrap gap-2">
                <a href={`/admin/anunciantes/${d.anunciante!.id}`} class={classesBotao("contorno", "m")}>
                  <Icone nome="megafone" class="size-4" />
                  Abrir o anunciante
                </a>
                <button type="button" data-abrir-modal={`modal-procedente-${d.id}`} class={classesBotao("perigo", "m")}>
                  Procedente
                </button>
                <button type="button" data-abrir-modal={`modal-improcedente-${d.id}`} class={classesBotao("contorno", "m")}>
                  Improcedente
                </button>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>

  {
    denuncias.filter(abertas).map((d) => (
      <>
        <Modal id={`modal-procedente-${d.id}`} titulo="Denúncia procedente">
          <form method="post">
            <input type="hidden" name="situacao" value="procedente" />
            <input type="hidden" name="id" value={d.id} />
            <p class="text-sm text-slate-600">
              Isto só registra a decisão. Para tirar o perfil do ar ou corrigir o conteúdo, use a página do anunciante.
            </p>
            <label class={classesRotulo}>
              O que foi feito (opcional, fica no histórico)
              <textarea name="observacao" rows="3" maxlength="1000" class={campoTexto} placeholder="Ex.: perfil suspenso; telefone corrigido com o anunciante."></textarea>
            </label>
            <div class="mt-5 flex gap-2">
              <button type="button" data-modal-fechar class={classesBotao("contorno", "m", "flex-1")}>Cancelar</button>
              <button type="submit" class={classesBotao("perigo", "m", "flex-1")}>Confirmar</button>
            </div>
          </form>
        </Modal>
        <Modal id={`modal-improcedente-${d.id}`} titulo="Denúncia improcedente">
          <form method="post">
            <input type="hidden" name="situacao" value="improcedente" />
            <input type="hidden" name="id" value={d.id} />
            <p class="text-sm text-slate-600">O perfil continua como está.</p>
            <label class={classesRotulo}>
              Por que não procede (fica no histórico)
              <textarea name="observacao" rows="3" maxlength="1000" required class={campoTexto}></textarea>
            </label>
            <div class="mt-5 flex gap-2">
              <button type="button" data-modal-fechar class={classesBotao("contorno", "m", "flex-1")}>Cancelar</button>
              <button type="submit" class={classesBotao("azul", "m", "flex-1")}>Confirmar</button>
            </div>
          </form>
        </Modal>
      </>
    ))
  }
</PaginaAdmin>
