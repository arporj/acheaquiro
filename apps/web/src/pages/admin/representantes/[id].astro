---
// Um representante na administração: chave Pix (com o botão Copiar), saldo,
// pagamento do saldo liberado inteiro (decisão P2), comissões, pagamentos já
// feitos e a marcação "recebe comissão" (o sócio, por enquanto, não recebe).
import { situacaoComissao } from "@acheaqui/domain";
import { Icone, Modal, classesBotao } from "@acheaqui/ui";
import Aviso from "@/components/conta/Aviso.astro";
import { classesCampo, classesRotulo } from "@/components/conta/estilos";
import PaginaAdmin from "@/components/admin/PaginaAdmin.astro";
import { ROTULO_ORIGEM, lerRepresentante, mudarRecebeComissao, pagarSaldo } from "@/lib/comissoes";
import { hojeNaCidade } from "@/lib/pagamentos";
import { formatarCentavos } from "@/lib/precos";
import { formatarData } from "@/lib/texto";

const supabase = Astro.locals.supabase!;
const id = Astro.params.id ?? "";
/** Comprovante de até 5 MB mais os campos de texto. */
const TAMANHO_MAXIMO_PEDIDO = 5 * 1024 * 1024 + 64 * 1024;

const AVISOS: Record<string, string> = {
  pago: "Pagamento ao representante registrado. As comissões pagas aparecem na área dele.",
  comissao: "Marcação de comissão salva. Vale para os próximos pagamentos.",
};
const aviso = AVISOS[Astro.url.searchParams.get("aviso") ?? ""];
let erro = "";

const lido = await lerRepresentante(supabase, id);
if (!lido.ok && lido.erro.codigo === "NAO_ENCONTRADO") return new Response(null, { status: 404 });
if (!lido.ok) erro = lido.erro.mensagem;

if (Astro.request.method === "POST" && lido.ok) {
  const tamanho = Number(Astro.request.headers.get("content-length") ?? "0");
  if (!tamanho || tamanho > TAMANHO_MAXIMO_PEDIDO) {
    erro = "Envio maior que o permitido (comprovante de até 5 MB).";
    Astro.response.status = 400;
  } else {
    const form = await Astro.request.formData();
    const acao = form.get("acao");
    let r;
    if (acao === "pagar") {
      const arquivo = form.get("comprovante");
      const comprovante = arquivo instanceof File && arquivo.size > 0 ? new Uint8Array(await arquivo.arrayBuffer()) : null;
      r = await pagarSaldo(supabase, lido.dados, form, comprovante);
    } else if (acao === "comissao") {
      r = await mudarRecebeComissao(supabase, id, form.get("recebe") === "sim");
    } else {
      r = { ok: false as const, erro: { codigo: "DADOS_INVALIDOS" as const, mensagem: "Ação desconhecida." } };
    }
    if (r.ok) return Astro.redirect(`/admin/representantes/${id}?aviso=${acao === "pagar" ? "pago" : "comissao"}`, 303);
    erro = r.erro.mensagem;
    Astro.response.status = r.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
  }
}

const rep = lido.ok ? lido.dados : null;
const hoje = hojeNaCidade();
const ROTULO_SITUACAO = { aguardando: "Aguardando", liberada: "Liberada", paga: "Paga", cancelada: "Cancelada" } as const;
const COR_SITUACAO = {
  aguardando: "bg-amarelo-200 text-azul-900",
  liberada: "bg-zap-600 text-white",
  paga: "bg-fundo text-slate-600",
  cancelada: "bg-slate-200 text-slate-500",
} as const;
const etiqueta = "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-extrabold";
const cartao = "rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5";
---

<PaginaAdmin titulo={rep?.nome ?? "Representante"} descricao={rep ? `Código ${rep.codigo}${rep.ativo ? "" : " · saiu"}` : undefined}>
  <p class="mt-2 text-sm"><a href="/admin/representantes" class="font-bold text-azul-600 hover:underline">← Representantes</a></p>
  {aviso && <Aviso tipo="sucesso">{aviso}</Aviso>}
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  {
    rep && (
      <>
        <section class="mt-4 grid gap-3 sm:grid-cols-3">
          <div class={cartao}>
            <p class="text-sm font-bold text-azul-900">Aguardando os 7 dias</p>
            <p class="font-display text-2xl font-extrabold text-azul-900">{formatarCentavos(rep.saldo.aguardandoCentavos)}</p>
          </div>
          <div class={cartao}>
            <p class="text-sm font-bold text-azul-900">Liberado para pagar</p>
            <p class:list={["font-display text-2xl font-extrabold", rep.saldo.liberadoCentavos > 0 ? "text-zap-700" : "text-azul-900"]}>
              {formatarCentavos(rep.saldo.liberadoCentavos)}
            </p>
            {rep.saldo.liberadoCentavos < 0 && <p class="text-xs text-slate-500">Desconto de contestação maior que o liberado: fica para o próximo pagamento.</p>}
          </div>
          <div class={cartao}>
            <p class="text-sm font-bold text-azul-900">Já pago</p>
            <p class="font-display text-2xl font-extrabold text-azul-900">{formatarCentavos(rep.saldo.pagoCentavos)}</p>
          </div>
        </section>

        <section class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div data-copiar-grupo>
              <p class="text-sm font-bold text-azul-900">Chave Pix</p>
              {rep.chavePix ? (
                <>
                  <div class="mt-1 flex flex-wrap items-center gap-2">
                    <span class="rounded-xl bg-fundo px-3 py-2 font-bold break-all text-azul-900">{rep.chavePix}</span>
                    <button type="button" data-copiar={rep.chavePix} data-copiado-texto="Chave Pix copiada." class={classesBotao("contorno", "p")}>
                      <Icone nome="link" class="size-4" />
                      Copiar
                    </button>
                  </div>
                  <p class="mt-1 h-5 text-sm font-semibold text-zap-700" data-copiado role="status" />
                </>
              ) : (
                <p class="mt-1 text-sm text-vermelho-700">Ainda não informada: o representante informa na área dele.</p>
              )}
            </div>
            {rep.saldo.liberadoCentavos > 0 && rep.chavePix && (
              <button type="button" data-abrir-modal="modal-pagar" class={classesBotao("zap", "m")}>
                <Icone nome="dinheiro" class="size-4" />
                Pagar {formatarCentavos(rep.saldo.liberadoCentavos)}
              </button>
            )}
          </div>

          <form method="post" class="mt-4 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4">
            <input type="hidden" name="acao" value="comissao" />
            <input type="hidden" name="recebe" value={rep.recebeComissao ? "nao" : "sim"} />
            <p class="text-sm text-slate-700">
              {rep.recebeComissao ? "Recebe comissão nas vendas e na carteira." : "Não recebe comissão (como o sócio, por enquanto)."}
            </p>
            <button type="submit" class={classesBotao("contorno", "p")}>
              {rep.recebeComissao ? "Deixar de pagar comissão" : "Passar a pagar comissão"}
            </button>
          </form>
        </section>

        <section class="mt-4">
          <h2 class="font-display text-lg font-bold text-azul-900">Comissões</h2>
          {rep.comissoes.length === 0 && <p class="mt-2 text-sm text-slate-500">Nenhuma comissão ainda.</p>}
          {rep.comissoes.length > 0 && (
            <ul class="mt-2 divide-y divide-slate-100 overflow-hidden rounded-2xl bg-white text-sm shadow-sm ring-1 ring-black/5">
              {rep.comissoes.map((c) => {
                const situacao = situacaoComissao({ liberaEm: c.liberaEm, hoje, cancelada: c.cancelada, paga: c.paga });
                return (
                  <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                    <span class="min-w-0 flex-1">
                      <span class="block font-bold text-azul-900">{c.descricao}</span>
                      <span class="block text-xs text-slate-500">
                        {ROTULO_ORIGEM[c.origem]} · {formatarData(c.criadaEm.slice(0, 10))}
                        {situacao === "aguardando" && ` · liberada em ${formatarData(c.liberaEm)}`}
                      </span>
                    </span>
                    <span class={`${etiqueta} ${COR_SITUACAO[situacao]}`}>{ROTULO_SITUACAO[situacao]}</span>
                    <span class:list={["font-bold", situacao === "cancelada" ? "text-slate-400 line-through" : "text-azul-900"]}>
                      {formatarCentavos(c.valorCentavos)}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
        </section>

        <section class="mt-6">
          <h2 class="font-display text-lg font-bold text-azul-900">Pagamentos feitos</h2>
          {rep.pagamentos.length === 0 && <p class="mt-2 text-sm text-slate-500">Nenhum pagamento ainda.</p>}
          {rep.pagamentos.length > 0 && (
            <ul class="mt-2 divide-y divide-slate-100 overflow-hidden rounded-2xl bg-white text-sm shadow-sm ring-1 ring-black/5">
              {rep.pagamentos.map((p) => (
                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                  <span class="min-w-0 flex-1">
                    <span class="block font-bold text-azul-900">{formatarData(p.pagoEm)}</span>
                    <span class="block text-xs break-all text-slate-500">
                      Pix para {p.chavePix}
                      {p.observacao && ` · ${p.observacao}`}
                    </span>
                  </span>
                  {p.comprovante && (
                    <a href={p.comprovante} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-azul-600 hover:underline">
                      Comprovante
                    </a>
                  )}
                  <span class="font-bold text-azul-900">{formatarCentavos(p.valorCentavos)}</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        {rep.saldo.liberadoCentavos > 0 && rep.chavePix && (
          <Modal id="modal-pagar" titulo={`Pagar ${formatarCentavos(rep.saldo.liberadoCentavos)}`}>
            <form method="post" enctype="multipart/form-data" data-form-pagar>
              <input type="hidden" name="acao" value="pagar" />
              <p class="text-sm text-slate-700">
                Faça o Pix para <strong class="break-all">{rep.chavePix}</strong> e registre aqui. Entram todas as comissões liberadas
                {rep.comissoes.some((c) => c.origem === "contestacao" && !c.paga && !c.cancelada) && ", já com o desconto de contestação"}.
              </p>
              <label for="pago_em" class={classesRotulo}>Dia do Pix</label>
              <input id="pago_em" type="date" name="pago_em" value={hoje} max={hoje} required class={classesCampo} />
              <label for="escolher-comprovante" class={classesRotulo}>Comprovante (opcional)</label>
              <input id="escolher-comprovante" type="file" accept="image/*,application/pdf" data-escolher-comprovante class={classesCampo} />
              <input type="file" name="comprovante" data-comprovante-pronto hidden />
              <p class="mt-1 text-xs font-bold text-vermelho-700" data-erro-comprovante hidden />
              <label for="observacao" class={classesRotulo}>Observação (opcional)</label>
              <input id="observacao" name="observacao" maxlength="300" class={classesCampo} />
              <div class="mt-5 flex gap-2">
                <button type="button" data-modal-fechar class={classesBotao("contorno", "m", "flex-1")}>
                  Cancelar
                </button>
                <button type="submit" class={classesBotao("zap", "m", "flex-1")}>
                  Registrar pagamento
                </button>
              </div>
            </form>
          </Modal>
        )}
      </>
    )
  }
</PaginaAdmin>

<script>
  import { ligarComprovante } from "@/lib/comprovante";
  import { ligarBotoesCopiar } from "@/lib/copiar";

  ligarBotoesCopiar();
  const form = document.querySelector<HTMLFormElement>("[data-form-pagar]");
  if (form) ligarComprovante(form);
</script>
