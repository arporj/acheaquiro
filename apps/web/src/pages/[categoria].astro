---
// Links curtos da busca (item 4.5): /eletricistas, /farmacias...
import { Icone, IconeCategoria } from "@acheaqui/ui";
import Topo from "@/components/anuncios/Topo.astro";
import BotaoCompartilhar from "@/components/BotaoCompartilhar.astro";
import LateralResultados from "@/components/resultados/LateralResultados.astro";
import ListaResultados from "@/components/resultados/ListaResultados.astro";
import { buscarPorCategoria, categoriaPorSlugLista, cidadeAtual, listarBairros, listarCategorias } from "@/dados/consultas";
import Layout from "@/layouts/Layout.astro";
import { guardarNoCache } from "@/lib/cache";

const categoria = categoriaPorSlugLista(Astro.params.categoria ?? "");
if (!categoria) return Astro.rewrite("/404");
guardarNoCache(Astro);

const itens = buscarPorCategoria(categoria.id);
const relacionadas = listarCategorias().filter((c) => c.grupo === categoria.grupo && c.id !== categoria.id);
const titulo = `${categoria.nomePlural} em ${cidadeAtual.nome}`;
---

<Layout titulo={titulo} descricao={`Encontre ${categoria.nomePlural.toLowerCase()} em ${cidadeAtual.nome} e fale direto pelo WhatsApp.`}>
  <Topo pagina="interna" />
  <main class="mx-auto w-full max-w-6xl px-4 pt-4 pb-12">
    <nav aria-label="Você está em" class="flex items-center gap-1 text-sm font-semibold text-slate-500">
      <a href="/" class="hover:text-azul-600">Início</a>
      <Icone nome="direita" class="size-3.5" />
      <span class="text-tinta">{categoria.nomePlural}</span>
    </nav>

    <div class="mt-2 mb-4 flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <span
          class="grid size-14 shrink-0 place-items-center rounded-2xl text-white shadow-md"
          style={`background-color: ${categoria.cor}`}
          aria-hidden="true"
        >
          <IconeCategoria nome={categoria.icone} class="size-7" strokeWidth={2} />
        </span>
        <div>
          <h1 class="font-display text-2xl leading-tight font-extrabold text-azul-900 sm:text-3xl">{titulo}</h1>
          <p class="text-sm font-semibold text-slate-500">
            {itens.length} {itens.length === 1 ? "anunciante" : "anunciantes"}
          </p>
        </div>
      </div>
      <div class="hidden sm:block">
        <BotaoCompartilhar caminho={`/${categoria.slugLista}`} titulo={titulo} variante="botao" />
      </div>
    </div>

    <div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <ListaResultados itens={itens} bairros={listarBairros()} />
      <LateralResultados relacionadas={relacionadas} />
    </div>
  </main>
</Layout>
