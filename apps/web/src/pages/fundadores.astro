---
import { Icone, Selo, type NomeIcone } from "@acheaqui/ui";
import Topo from "@/components/anuncios/Topo.astro";
import Abertura from "@/components/institucional/Abertura.astro";
import BotaoContato from "@/components/institucional/BotaoContato.astro";
import CardResultado from "@/components/resultados/CardResultado.astro";
import { listarFundadores, listarPlanos, obterRegrasCobranca } from "@/dados/consultas";
import Layout from "@/layouts/Layout.astro";
import { guardarNoCache } from "@/lib/cache";
import { formatarCentavos, valorPlano } from "@/lib/precos";
import { formatarData } from "@/lib/texto";

guardarNoCache(Astro);

const regras = obterRegrasCobranca();
const prazo = formatarData(regras.prazoFundador);
const desconto = `${regras.percentualDescontoFundador}%`;

const beneficios: { icone: NomeIcone; titulo: string; texto: string }[] = [
  {
    icone: "medalha",
    titulo: "Selo Fundador",
    texto: "O selo aparece no seu perfil e no seu cartão na lista de resultados.",
  },
  {
    icone: "dinheiro",
    titulo: `${desconto} de desconto permanente`,
    texto:
      "Nos planos e nos pacotes extras: categoria adicional, fotos, encarte, produtos e endereço. Os destaques e os links patrocinados, que têm vagas limitadas, não têm desconto.",
  },
  {
    icone: "estrela",
    titulo: "Vitrine dos Fundadores",
    texto:
      "Página própria, com item no menu do site e filtro por categoria. No primeiro mês depois da abertura, a página inicial também mostra os Fundadores, em rodízio.",
  },
  {
    icone: "megafone",
    titulo: "Divulgação no lançamento",
    texto: "Seu nome no post de inauguração no Instagram do Ache Aqui e menção no primeiro carro de som.",
  },
  {
    icone: "escudo",
    titulo: "Selo Verificado sem custo",
    texto: "Quando o recurso de verificação existir no site, o Fundador recebe o selo sem pagar nada a mais.",
  },
];

const gruposPreco = [
  { titulo: "Profissionais autônomos", planos: listarPlanos("profissional") },
  { titulo: "Comércios", planos: listarPlanos("comercio") },
].map((grupo) => ({
  titulo: grupo.titulo,
  linhas: grupo.planos
    .filter((p) => p.valorMensalCentavos > 0)
    .map((plano) => ({
      plano,
      anual: valorPlano(plano, "anual", false, regras),
      fundador: valorPlano(plano, "anual", true, regras),
    })),
}));

const fundadores = listarFundadores();
const categoriasVitrine = [...new Set(fundadores.map((f) => f.categoriaNome))].sort((a, b) => a.localeCompare(b, "pt-BR"));
const chip =
  "inline-flex h-9 shrink-0 items-center rounded-full bg-white px-3.5 text-sm font-bold text-tinta ring-1 ring-azul-100 not-aria-pressed:hover:bg-azul-50 aria-pressed:bg-azul-600 aria-pressed:text-white aria-pressed:ring-azul-600";
---

<Layout
  titulo="Fundadores"
  descricao={`Quem paga a assinatura anual até ${prazo} vira Fundador do Ache Aqui RO, com ${desconto} de desconto permanente.`}
  previa={{
    titulo: "Fundadores do Ache Aqui RO",
    descricao: `Pague o anual até ${prazo} e tenha ${desconto} de desconto permanente, selo e vitrine própria.`,
  }}
>
  <Topo pagina="interna" />

  <main>
    <Abertura
      chamada="Fundadores do Ache Aqui RO"
      subtitulo={`Pague a assinatura anual de um plano pago até ${prazo}. Não há limite de vagas.`}
    >
      Seja Fundador e tenha <span class="text-amarelo-400">{desconto} de desconto</span> para sempre
      <Fragment slot="acoes">
        <BotaoContato rotulo="Quero ser Fundador" />
      </Fragment>
    </Abertura>

    <section class="bg-white py-10">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="mb-6 font-display text-3xl font-extrabold text-azul-900">O que o Fundador ganha</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            beneficios.map((b) => (
              <li class="rounded-3xl bg-fundo p-5">
                <span class="grid size-12 place-items-center rounded-2xl bg-vermelho-500 text-white">
                  <Icone nome={b.icone} class="size-6" />
                </span>
                <h3 class="mt-3 font-display text-xl font-bold text-azul-900">{b.titulo}</h3>
                <p class="mt-1 text-slate-600">{b.texto}</p>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex gap-3 rounded-2xl bg-azul-50 p-4 text-azul-900">
          <Icone nome="info" class="mt-0.5 size-5 shrink-0 text-azul-600" />
          <p>
            <strong>Como manter:</strong> depois do primeiro ano, você renova no anual ou no mensal e continua Fundador
            enquanto a assinatura não for interrompida. Se ela vencer e não for paga em até{" "}
            {regras.toleranciaVencimentoDias} dias, o anunciante perde o selo, o desconto e a vaga na vitrine.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-10">
      <h2 class="font-display text-3xl font-extrabold text-azul-900">Quanto o Fundador paga</h2>
      <p class="mt-1 mb-5 text-slate-600">Valores do primeiro ano, na assinatura anual.</p>
      <div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-black/5">
        <table class="w-full text-left text-sm sm:text-base">
          <thead class="bg-azul-600 text-white">
            <tr>
              <th scope="col" class="px-3 py-3 font-display font-bold sm:px-5">Plano</th>
              <th scope="col" class="px-3 py-3 text-right font-display font-bold sm:px-5">Anual</th>
              <th scope="col" class="px-3 py-3 text-right font-display font-bold sm:px-5">Fundador</th>
            </tr>
          </thead>
          {
            gruposPreco.map((grupo) => (
              <tbody class="divide-y divide-slate-100">
                <tr class="bg-fundo">
                  <th colspan="3" scope="colgroup" class="px-3 py-2 text-xs font-extrabold tracking-wide text-slate-500 uppercase sm:px-5">
                    {grupo.titulo}
                  </th>
                </tr>
                {grupo.linhas.map((linha) => (
                  <tr>
                    <th scope="row" class="px-3 py-3 font-bold text-azul-900 sm:px-5">
                      <span class="inline-flex items-center gap-1.5">
                        {linha.plano.nome}
                        <Selo selo={linha.plano.selo} />
                      </span>
                    </th>
                    <td class="px-3 py-3 text-right text-slate-500 line-through decoration-vermelho-500/60 sm:px-5">
                      {formatarCentavos(linha.anual)}
                    </td>
                    <td class="px-3 py-3 text-right font-extrabold text-vermelho-600 sm:px-5">{formatarCentavos(linha.fundador)}</td>
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </section>

    <section id="vitrine" class="bg-white py-10" data-vitrine>
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="font-display text-3xl font-extrabold text-azul-900">Vitrine dos Fundadores</h2>
        <p class="mt-1 text-slate-600">Os anunciantes que acreditaram no Ache Aqui RO desde o começo.</p>

        <div class="mt-5 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]" role="group" aria-label="Filtrar por categoria">
          <button type="button" data-categoria="" aria-pressed="true" class={chip}>Todas</button>
          {
            categoriasVitrine.map((categoria) => (
              <button type="button" data-categoria={categoria} aria-pressed="false" class={chip}>
                {categoria}
              </button>
            ))
          }
        </div>

        <div class="mt-4 grid gap-3 lg:grid-cols-2">
          {
            fundadores.map((item) => (
              <div data-item-categoria={item.categoriaNome}>
                <CardResultado item={item} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 pb-14">
      <div class="rounded-[2rem] bg-vermelho-500 px-6 py-8 text-center text-white md:px-10 md:py-10">
        <h2 class="font-display text-3xl font-extrabold md:text-4xl">
          O prazo termina em <span class="text-amarelo-400">{prazo}</span>
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-white/90">Fale com a equipe do Ache Aqui e garanta o seu lugar entre os Fundadores.</p>
        <BotaoContato rotulo="Quero ser Fundador" class="mt-6" />
      </div>
    </section>
  </main>
</Layout>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>("[data-vitrine]")) {
    const botoes = [...raiz.querySelectorAll<HTMLButtonElement>("[data-categoria]")];
    const itens = [...raiz.querySelectorAll<HTMLElement>("[data-item-categoria]")];
    for (const botao of botoes) {
      botao.addEventListener("click", () => {
        const categoria = botao.dataset.categoria ?? "";
        for (const outro of botoes) outro.setAttribute("aria-pressed", String(outro === botao));
        for (const item of itens) item.hidden = categoria !== "" && item.dataset.itemCategoria !== categoria;
      });
    }
  }
</script>
