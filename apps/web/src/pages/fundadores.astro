---
import { Icone, Selo, classesBotao, type NomeIcone } from "@acheaqui/ui";
import Topo from "@/components/anuncios/Topo.astro";
import Abertura from "@/components/institucional/Abertura.astro";
import BotaoContato from "@/components/institucional/BotaoContato.astro";
import CardResultado from "@/components/resultados/CardResultado.astro";
import { anoSemDescontoFundador } from "@acheaqui/domain";
import { hojeNaCidade, listarFundadores, listarPlanos, obterAberturaAoPublico, obterRegrasCobranca, obterVagasFundador } from "@/dados/consultas";
import { ofertaFundador, textoComoVirarFundador, textoVagasRestantes } from "@/lib/fundadores";
import Layout from "@/layouts/Layout.astro";
import { guardarNoCache } from "@/lib/cache";
import { descricaoDescontoFundador, formatarCentavos, percentualInicialFundador, valorPlano } from "@/lib/precos";
import { textoAbertura } from "@/lib/abertura";

guardarNoCache(Astro);

const regras = await obterRegrasCobranca();
const oferta = ofertaFundador(regras, hojeNaCidade(), await obterVagasFundador());
const esgotada = oferta.tipo === "esgotada";
const comoVirar = textoComoVirarFundador(oferta);
const abertura = textoAbertura(await obterAberturaAoPublico(), hojeNaCidade());
const desconto = `${percentualInicialFundador(regras)}%`;
const escala = descricaoDescontoFundador(regras.escalaDescontoFundador);
const semDesconto = anoSemDescontoFundador(regras.escalaDescontoFundador);
const fimDoDesconto = semDesconto
  ? ` A partir do ${semDesconto}º ano, o plano e os pacotes voltam ao valor cheio; o selo e o lugar no Mural dos Fundadores continuam.`
  : "";

const beneficios: { icone: NomeIcone; titulo: string; texto: string }[] = [
  {
    icone: "medalha",
    titulo: "Selo Fundador",
    texto: "O selo aparece no seu perfil e no seu cartão na lista de resultados.",
  },
  {
    icone: "dinheiro",
    titulo: "Desconto de Fundador",
    texto: `${escala[0]!.toUpperCase()}${escala.slice(1)}, nos planos e nos pacotes extras: categoria adicional, fotos, encarte, produtos e endereço. O Banner Exclusivo, o Carrossel e os links destacados, que têm vagas limitadas, não têm desconto.${fimDoDesconto}`,
  },
  {
    icone: "estrela",
    titulo: "Mural dos Fundadores",
    texto:
      "Página própria, com item no menu do site e filtro por categoria. No primeiro mês depois da abertura, a página inicial também mostra os Fundadores, em rodízio.",
  },
  {
    icone: "megafone",
    titulo: "Divulgação no lançamento",
    texto: "Seu nome no post de inauguração no Instagram do Ache Aqui e menção no primeiro carro de som, quando houver.",
  },
  {
    icone: "escudo",
    titulo: "Selo Verificado sem custo",
    texto: "Quando o recurso de verificação existir no site, o Fundador recebe o selo sem pagar nada a mais.",
  },
];

const gruposPreco = [
  { titulo: "Profissionais autônomos", planos: await listarPlanos("profissional") },
  { titulo: "Comércios", planos: await listarPlanos("comercio") },
].map((grupo) => ({
  titulo: grupo.titulo,
  linhas: grupo.planos
    .filter((p) => p.valorMensalCentavos > 0)
    .map((plano) => ({
      plano,
      mensal: valorPlano(plano, "mensal", false, regras),
      mensalFundador: valorPlano(plano, "mensal", true, regras),
      anual: valorPlano(plano, "anual", false, regras),
      anualFundador: valorPlano(plano, "anual", true, regras),
    })),
}));

const fundadores = await listarFundadores();
const categoriasMural = [...new Set(fundadores.map((f) => f.categoriaPrincipal))].sort((a, b) => a.localeCompare(b, "pt-BR"));
const chip =
  "inline-flex h-9 shrink-0 items-center rounded-full bg-white px-3.5 text-sm font-bold text-tinta ring-1 ring-azul-100 not-aria-pressed:hover:bg-azul-50 aria-pressed:bg-azul-600 aria-pressed:text-white aria-pressed:ring-azul-600";
---

<Layout
  titulo="Fundadores"
  descricao={`${comoVirar} Os Fundadores do Ache Aqui RO têm desconto enquanto renovam em dia: ${escala}.`}
  previa={{
    titulo: "Fundadores do Ache Aqui RO",
    descricao: esgotada
      ? "Conheça os anunciantes que acreditaram no Ache Aqui RO desde o começo."
      : `${comoVirar} Desconto de ${escala}, selo e lugar no Mural dos Fundadores.`,
  }}
>
  <Topo pagina="interna" />

  <main>
    <Abertura
      comAbertura
      chamada="Fundadores do Ache Aqui RO"
      subtitulo={esgotada ? comoVirar : `${comoVirar} Desconto de ${escala}.${oferta.tipo === "prazo" ? " Não há limite de vagas." : ""}`}
    >
      {
        esgotada ? (
          <>Conheça os <span class="text-amarelo-400">Fundadores</span> do Ache Aqui RO</>
        ) : (
          <>
            Seja Fundador e tenha <span class="text-amarelo-400">{desconto} de desconto</span> já no primeiro ano
          </>
        )
      }
      <Fragment slot="acoes">
        {esgotada ? <a href="#mural" class={classesBotao("amarelo", "g")}>Ver o Mural</a> : <BotaoContato rotulo="Quero ser Fundador" />}
      </Fragment>
    </Abertura>

    <section class="bg-white py-10">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="mb-6 font-display text-3xl font-extrabold text-azul-900">O que o Fundador ganha</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            beneficios.map((b) => (
              <li class="rounded-3xl bg-fundo p-5">
                <span class="grid size-12 place-items-center rounded-2xl bg-vermelho-500 text-white">
                  <Icone nome={b.icone} class="size-6" />
                </span>
                <h3 class="mt-3 font-display text-xl font-bold text-azul-900">{b.titulo}</h3>
                <p class="mt-1 text-slate-600">{b.texto}</p>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex gap-3 rounded-2xl bg-azul-50 p-4 text-azul-900">
          <Icone nome="info" class="mt-0.5 size-5 shrink-0 text-azul-600" />
          <p>
            <strong>Como manter:</strong> você continua Fundador enquanto pagar cada renovação, mensal ou anual, em até{" "}
            {regras.toleranciaVencimentoDias} dias depois do vencimento, e pode trocar entre o mensal e o anual sem perder a
            condição. Quem não paga nesse prazo deixa de ser Fundador de vez e perde o selo, o desconto e o lugar no Mural dos
            Fundadores.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-10">
      <h2 class="font-display text-3xl font-extrabold text-azul-900">Quanto o Fundador paga</h2>
      <p class="mt-1 mb-5 text-slate-600">Valores do primeiro ano: o preço cheio riscado e, embaixo, o preço de Fundador.</p>
      <div class="relative overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-black/5">
        <table class="w-full text-left text-sm sm:text-base">
          <thead class="bg-azul-600 text-white">
            <tr>
              <th scope="col" class="px-3 py-3 font-display font-bold sm:px-5">Plano</th>
              <th scope="col" class="px-3 py-3 text-right font-display font-bold sm:px-5">Mensal</th>
              <th scope="col" class="px-3 py-3 text-right font-display font-bold sm:px-5">Anual</th>
            </tr>
          </thead>
          {
            gruposPreco.map((grupo) => (
              <tbody class="divide-y divide-slate-100">
                <tr class="bg-fundo">
                  <th colspan="3" scope="colgroup" class="px-3 py-2 text-xs font-extrabold tracking-wide text-slate-500 uppercase sm:px-5">
                    {grupo.titulo}
                  </th>
                </tr>
                {grupo.linhas.map((linha) => (
                  <tr>
                    <th scope="row" class="px-3 py-3 font-bold text-azul-900 sm:px-5">
                      <span class="inline-flex items-center gap-1.5">
                        {linha.plano.nome}
                        <Selo selo={linha.plano.selo} />
                      </span>
                    </th>
                    {[
                      { cheio: linha.mensal, fundador: linha.mensalFundador },
                      { cheio: linha.anual, fundador: linha.anualFundador },
                    ].map((valor) => (
                      <td class="px-3 py-3 text-right sm:px-5">
                        <span class="block text-xs text-slate-500 line-through decoration-vermelho-500/60 sm:text-sm">
                          <span class="sr-only">Preço cheio: </span>
                          {formatarCentavos(valor.cheio)}
                        </span>
                        <span class="block font-extrabold text-vermelho-600">
                          <span class="sr-only">Fundador: </span>
                          {formatarCentavos(valor.fundador)}
                        </span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </section>

    <section id="mural" class="bg-white py-10" data-mural>
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="font-display text-3xl font-extrabold text-azul-900">Mural dos Fundadores</h2>
        <p class="mt-1 text-slate-600">Os anunciantes que acreditaram no Ache Aqui RO desde o começo.</p>

        {
          fundadores.length === 0 && (
            <p class="mt-5 flex gap-3 rounded-2xl bg-fundo p-4 text-slate-600">
              <Icone nome="info" class="mt-0.5 size-5 shrink-0 text-azul-600" />
              Os primeiros Fundadores aparecem aqui assim que os perfis forem publicados.
            </p>
          )
        }

        <div hidden={fundadores.length === 0} class="mt-5 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]" role="group" aria-label="Filtrar por categoria">
          <button type="button" data-categoria="" aria-pressed="true" class={chip}>Todas</button>
          {
            categoriasMural.map((categoria) => (
              <button type="button" data-categoria={categoria} aria-pressed="false" class={chip}>
                {categoria}
              </button>
            ))
          }
        </div>

        <div class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-3 lg:grid-cols-2">
          {
            fundadores.map((item) => (
              <div data-item-categoria={item.categoriaPrincipal}>
                <CardResultado item={item} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      !esgotada && (
        <section class="mx-auto max-w-6xl px-4 py-10 pb-14">
          <div class="rounded-[2rem] bg-vermelho-500 px-6 py-8 text-center text-white md:px-10 md:py-10">
            <h2 class="font-display text-3xl font-extrabold md:text-4xl">
              {oferta.tipo === "prazo" ? (
                <>
                  O prazo termina em <span class="text-amarelo-400">{oferta.prazo}</span>
                </>
              ) : oferta.restantes !== null ? (
                <span class="text-amarelo-400">{textoVagasRestantes(oferta.restantes)}</span>
              ) : (
                <>
                  Ainda há <span class="text-amarelo-400">vagas de Fundador</span>
                </>
              )}
            </h2>
            <p class="mx-auto mt-2 max-w-xl text-white/90">
              {abertura && <>{abertura}. </>}Fale com a equipe do Ache Aqui e garanta o seu lugar entre os Fundadores.
            </p>
            <BotaoContato rotulo="Quero ser Fundador" class="mt-6" />
          </div>
        </section>
      )
    }
  </main>
</Layout>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>("[data-mural]")) {
    const botoes = [...raiz.querySelectorAll<HTMLButtonElement>("[data-categoria]")];
    const itens = [...raiz.querySelectorAll<HTMLElement>("[data-item-categoria]")];
    for (const botao of botoes) {
      botao.addEventListener("click", () => {
        const categoria = botao.dataset.categoria ?? "";
        for (const outro of botoes) outro.setAttribute("aria-pressed", String(outro === botao));
        for (const item of itens) item.hidden = categoria !== "" && item.dataset.itemCategoria !== categoria;
      });
    }
  }
</script>
