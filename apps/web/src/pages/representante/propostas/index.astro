---
// Propostas do representante (item 4.12, parte 5; plano 3B.1): as propostas
// feitas, com a situação e o cancelamento enquanto não foram pagas. A nova
// proposta sai da ficha do cliente (decisão de 06/11/2026).
import { Modal, classesBotao } from "@acheaqui/ui";
import Aviso from "@/components/conta/Aviso.astro";
import PaginaRepresentante from "@/components/representante/PaginaRepresentante.astro";
import { hojeNaCidade } from "@/lib/pagamentos";
import { formatarCentavos } from "@/lib/precos";
import { ROTULO_PROPOSTA, listarPropostas, responderProposta, situacaoVisivel } from "@/lib/propostas";
import { formatarData } from "@/lib/texto";

const supabase = Astro.locals.supabase!;
const AVISOS: Record<string, string> = {
  cancelada: "Proposta cancelada.",
};
const aviso = AVISOS[Astro.url.searchParams.get("aviso") ?? ""];
let erro = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const r = await responderProposta(supabase, String(form.get("id") ?? ""), "cancelar");
  if (r.ok) return Astro.redirect("/representante/propostas?aviso=cancelada", 303);
  erro = r.erro.mensagem;
  Astro.response.status = r.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
}

const propostas = await listarPropostas(supabase);
if (!propostas.ok) erro ||= propostas.erro.mensagem;
const hoje = hojeNaCidade();
const cartao = "rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5";
---

<PaginaRepresentante titulo="Propostas" descricao="As propostas que você fez: assinatura para quem ainda não tem plano pago, ou um plano maior para quem já anuncia.">
  {aviso && <Aviso tipo="sucesso">{aviso}</Aviso>}
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  <section class={`${cartao} mt-4`}>
    <p class="text-sm text-slate-700">
      Para fazer uma proposta, abra o cliente em <a href="/representante/clientes?conta=com" class="font-bold text-azul-600 hover:underline">Clientes</a>. A proposta é
      para quem já tem conta no site; para quem ainda não tem, o caminho é "Fechei com este comércio", na ficha.
    </p>
  </section>

  <section class="mt-6">
    <h2 class="font-display text-lg font-bold text-azul-900">Suas propostas</h2>
    {
      propostas.ok && propostas.dados.length === 0 && (
        <p class={`${cartao} mt-2 text-slate-600`}>Nenhuma proposta ainda.</p>
      )
    }
    {
      propostas.ok && propostas.dados.length > 0 && (
        <ul class="mt-2 divide-y divide-slate-100 overflow-hidden rounded-2xl bg-white text-sm shadow-sm ring-1 ring-black/5">
          {propostas.dados.map((p) => {
            const situacao = situacaoVisivel(p, hoje);
            return (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                <span class="min-w-0 flex-1">
                  <span class="block font-bold text-azul-900">{p.anunciante}</span>
                  <span class="block text-xs text-slate-500">
                    {p.tipo === "upgrade" ? "Mudança para o" : "Assinatura do"} {p.plano} ({p.periodicidade})
                    {p.descontoCentavos > 0 && ` · desconto de ${formatarCentavos(p.descontoCentavos)}`} · feita em {formatarData(p.criadaEm.slice(0, 10))}
                    {(situacao === "aguardando_aceite" || situacao === "aceita") && ` · vale até ${formatarData(p.expiraEm)}`}
                  </span>
                </span>
                <span class="rounded-full bg-fundo px-2 py-0.5 text-xs font-extrabold text-azul-900">{ROTULO_PROPOSTA[situacao]}</span>
                {(situacao === "aguardando_aceite" || situacao === "aceita") && (
                  <button type="button" data-abrir-modal={`cancelar-${p.id}`} class={classesBotao("contorno", "p")}>
                    Cancelar
                  </button>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  {
    propostas.ok &&
      propostas.dados
        .filter((p) => ["aguardando_aceite", "aceita"].includes(situacaoVisivel(p, hoje)))
        .map((p) => (
          <Modal id={`cancelar-${p.id}`} titulo="Cancelar a proposta">
            <p class="text-slate-700">Cancelar a proposta do {p.plano} para {p.anunciante}? O anunciante não poderá mais aceitá-la.</p>
            <form method="post" class="mt-5 flex gap-2">
              <input type="hidden" name="id" value={p.id} />
              <button type="button" data-modal-fechar class={classesBotao("contorno", "m", "flex-1")}>Voltar</button>
              <button type="submit" class={classesBotao("perigo", "m", "flex-1")}>Cancelar a proposta</button>
            </form>
          </Modal>
        ))
  }
</PaginaRepresentante>

<script>
  for (const botao of document.querySelectorAll<HTMLButtonElement>("[data-abrir-modal]")) {
    botao.addEventListener("click", () => {
      const dialogo = document.getElementById(botao.dataset.abrirModal ?? "");
      if (dialogo instanceof HTMLDialogElement) dialogo.showModal();
    });
  }
</script>
