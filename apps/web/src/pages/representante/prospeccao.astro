---
// A Prospecção virou um filtro de Clientes (opção B, decisões de 06/11/2026).
// O endereço continua para os links já salvos.
const p = new URLSearchParams();
for (const nome of ["q", "categoria", "bairro"]) {
  const valor = Astro.url.searchParams.get(nome);
  if (valor) p.set(nome, valor);
}
p.set("conta", "sem");
p.set("situacao", "sem");
return Astro.redirect(`/representante/clientes?${p}`, 302);
