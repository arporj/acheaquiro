---
// Prospecção (item 4.12; decisões de 23 e 24/10/2026): os comércios
// importados da Receita que ainda não têm dono, com o telefone e o e-mail da
// Receita (confidenciais, pelo termo). Sem reserva: cada linha mostra só quem
// fez o último contato e o dia, para dois representantes não ligarem para o
// mesmo comércio. O representante registra o contato e, ao fechar a venda,
// faz o cadastro completo num rascunho próprio: os outros veem "Em cadastro"
// e não pegam o comércio por 7 dias, ou enquanto o convite estiver enviado.
import { compararNomes } from "@acheaqui/domain";
import { Icone, classesBotao } from "@acheaqui/ui";
import Aviso from "@/components/conta/Aviso.astro";
import { classesCampo } from "@/components/conta/estilos";
import ModalAtendimento from "@/components/representante/ModalAtendimento.astro";
import PaginaRepresentante from "@/components/representante/PaginaRepresentante.astro";
import { formatarTelefone, linkTelefone } from "@/lib/contato";
import { listarCategoriasAdmin } from "@/lib/importacao";
import {
  POR_PAGINA_PROSPECCAO,
  fecharComImportado,
  lerFiltroProspeccao,
  listarProspeccao,
  registrarDoFormulario,
} from "@/lib/representante";
import { formatarData } from "@/lib/texto";

const supabase = Astro.locals.supabase!;
const filtro = lerFiltroProspeccao(Astro.url.searchParams);

const AVISOS: Record<string, string> = {
  atendimento: "Contato registrado.",
  "nao-procurar": "Contato registrado. O comércio saiu da prospecção de todos.",
};
const aviso = AVISOS[Astro.url.searchParams.get("aviso") ?? ""];
let erro = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const acao = String(form.get("acao") ?? "");
  if (acao === "atendimento") {
    const r = await registrarDoFormulario(supabase, form);
    if (r.ok) {
      const p = new URLSearchParams(Astro.url.search);
      p.set("aviso", r.dados.naoProcurar ? "nao-procurar" : "atendimento");
      return Astro.redirect(`/representante/prospeccao?${p}`, 303);
    }
    erro = r.erro.mensagem;
    Astro.response.status = r.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
  } else if (acao === "fechar") {
    const r = await fecharComImportado(supabase, String(form.get("anuncianteId") ?? "").slice(0, 40));
    if (r.ok) return Astro.redirect(`/representante/anunciantes/${r.dados.id}?aviso=fechado`, 303);
    erro = r.erro.mensagem;
    Astro.response.status = r.erro.codigo === "ERRO_INTERNO" ? 500 : 400;
  } else {
    erro = "Ação desconhecida.";
    Astro.response.status = 400;
  }
}

const [lista, categorias, bairros] = await Promise.all([
  listarProspeccao(supabase, filtro),
  listarCategoriasAdmin(supabase),
  supabase.from("bairros").select("id, nome").eq("ativo", true).order("nome"),
]);
if (bairros.error) console.error("prospeccao: bairros falharam", { codigo: bairros.error.code, mensagem: bairros.error.message });
const categoriasComercio = categorias.ok
  ? categorias.dados.filter((c) => c.tipo !== "profissional").sort((a, b) => compararNomes(a.nome, b.nome))
  : [];
const total = lista.ok ? lista.dados.total : 0;
const paginas = Math.max(1, Math.ceil(total / POR_PAGINA_PROSPECCAO));
const linkPagina = (n: number) => {
  const p = new URLSearchParams(Astro.url.search);
  p.delete("aviso");
  p.set("pagina", String(n));
  return `/representante/prospeccao?${p}`;
};
---

<PaginaRepresentante
  titulo="Prospecção"
  descricao="Comércios da cidade que estão no site pelos dados da Receita e ainda não têm dono. O telefone e o e-mail são confidenciais."
>
  {aviso && <Aviso tipo="sucesso">{aviso}</Aviso>}
  {erro && <Aviso tipo="erro">{erro}</Aviso>}

  <form method="get" class="mt-4 grid gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5 sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end">
    <label class="text-sm font-bold text-azul-900">
      Nome
      <input name="q" value={filtro.busca} maxlength="80" class={classesCampo} />
    </label>
    <label class="text-sm font-bold text-azul-900">
      Categoria
      <select name="categoria" class={classesCampo}>
        <option value="">Todas</option>
        {categoriasComercio.map((c) => <option value={c.id} selected={c.id === filtro.categoriaId}>{c.nome}</option>)}
      </select>
    </label>
    <label class="text-sm font-bold text-azul-900">
      Bairro
      <select name="bairro" class={classesCampo}>
        <option value="">Todos</option>
        {(bairros.data ?? []).map((b) => <option value={b.id} selected={b.id === filtro.bairroId}>{b.nome}</option>)}
      </select>
    </label>
    <button type="submit" class={classesBotao("azul", "m", "h-12")}>
      <Icone nome="busca" class="size-4" />
      Buscar
    </button>
  </form>

  {!lista.ok && <Aviso tipo="erro">{lista.erro.mensagem}</Aviso>}
  {lista.ok && <p class="mt-4 text-sm text-slate-600">{total.toLocaleString("pt-BR")} comércio(s).</p>}

  <ul class="mt-3 space-y-3">
    {
      lista.ok &&
        lista.dados.comercios.map((c) => (
          <li class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <a href={`/perfil/${c.slug}`} target="_blank" class="font-display text-lg font-bold text-azul-900 hover:underline">
                  {c.nome}
                </a>
                <p class="text-sm text-slate-600">
                  {[c.categoria, c.bairro].filter(Boolean).join(" · ")}
                  {c.endereco && <span class="block">{c.endereco}</span>}
                </p>
                {c.razaoSocial && c.razaoSocial !== c.nome && <p class="text-xs text-slate-500">{c.razaoSocial}</p>}
              </div>
              <p
                class:list={[
                  "rounded-full px-3 py-1 text-xs font-extrabold",
                  c.ultimoContato ? "bg-amarelo-200 text-azul-900" : "bg-slate-100 text-slate-500",
                ]}
              >
                {c.ultimoContato ? `Contato de ${c.ultimoContato.autor} em ${formatarData(c.ultimoContato.dia)}` : "Sem contato registrado"}
              </p>
            </div>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {c.telefones.map((t) => (
                <a href={linkTelefone(t.startsWith("55") ? t : `55${t}`)} class="font-bold text-azul-600 hover:underline">
                  {formatarTelefone(t)}
                </a>
              ))}
              {c.email && (
                <a href={`mailto:${c.email}`} class="font-bold break-all text-azul-600 hover:underline">
                  {c.email}
                </a>
              )}
              {c.telefones.length === 0 && !c.email && <span class="text-slate-500">Sem telefone nem e-mail na Receita.</span>}
            </div>
            {c.reserva && !c.reserva.meuRascunho && (
              <p class="mt-2 rounded-xl bg-azul-50 px-3 py-2 text-sm font-semibold text-azul-900">
                {c.reserva.conviteEnviado
                  ? `Em atendimento por ${c.reserva.autor}: convite enviado ao comerciante.`
                  : `Em cadastro por ${c.reserva.autor} até ${formatarData(c.reserva.ate)}.`}
              </p>
            )}
            <div class="mt-3 flex flex-wrap gap-2">
              <button type="button" class={classesBotao("contorno", "p")} data-atendimento={c.id} data-atendimento-nome={c.nome}>
                <Icone nome="mensagem" class="size-4" />
                Registrei um contato
              </button>
              {c.reserva?.meuRascunho ? (
                <a href={`/representante/anunciantes/${c.reserva.meuRascunho}`} class={classesBotao("azul", "p")}>
                  <Icone nome="usuarios" class="size-4" />
                  Continuar o cadastro
                </a>
              ) : (
                !c.reserva && (
                  <form method="post">
                    <input type="hidden" name="acao" value="fechar" />
                    <input type="hidden" name="anuncianteId" value={c.id} />
                    <button type="submit" class={classesBotao("azul", "p")}>
                      <Icone nome="usuarios" class="size-4" />
                      Fechei com este comércio
                    </button>
                  </form>
                )
              )}
            </div>
          </li>
        ))
    }
  </ul>

  {
    paginas > 1 && (
      <nav aria-label="Páginas" class="mt-6 flex items-center justify-between gap-3 text-sm font-bold">
        {filtro.pagina > 1 ? <a href={linkPagina(filtro.pagina - 1)} class={classesBotao("contorno", "p")}>← Anterior</a> : <span />}
        <span>
          Página {filtro.pagina} de {paginas}
        </span>
        {filtro.pagina < paginas ? <a href={linkPagina(filtro.pagina + 1)} class={classesBotao("contorno", "p")}>Próxima →</a> : <span />}
      </nav>
    )
  }

  <ModalAtendimento comNaoProcurar />

</PaginaRepresentante>
